[package]
name = "daimon"
version = "${file:VERSION}"
description = "daimon — AGNOS agent orchestrator"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/daimon"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "src/main.cyr"
output = "build/daimon"

[deps]
stdlib = [
    "atomic",
    "string",
    "fmt",
    "math",
    "alloc",
    "vec",
    "str",
    "syscalls",
    "io",
    "fs",
    "hashmap",
    "tagged",
    "bayan",
    "net",
    "mmap",
    "dynlib",
    "fdlopen",
    "tls",
    "sandhi",
    "args",
    "chrono",
    "fnptr",
    "process",
    "async",
    "thread",
    "callback",
    "assert",
    "bench",
    "freelist",
    "ct",
    "keccak",
    "random",
    "slice",
    "thread_local",
    "ws_server",
    "sync",
]

[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.5.2"
modules = ["dist/sakshi.cyr"]

# ai-hwaccel — samay's hardware-acceleration dependency; daimon calls nothing
# in it. No `path`: a dep with both `path` and `tag` resolves from the local
# checkout and the tag is inert (cbt/deps.cyr, CVE-21 note), and every build
# re-resolves deps, so a sibling checkout mid-change leaked into daimon's lock
# (2.3.4). Resolved from the tag, the lock also records its commit.
[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.3.24"
modules = ["dist/ai-hwaccel.cyr"]

# samay — task scheduler. daimon 2.0.0 REPLACES its own duplicated
# scheduler.cyr/cron.cyr with this library (the extraction of daimon's
# scheduler). path resolves the local checkout for dev; tag pins the release.
[deps.samay]
git = "https://github.com/MacCracken/samay.git"
path = "../samay"
tag = "1.1.3"
modules = ["dist/samay.cyr"]

# --- bote MCP tool host + its audit-chain backend (1.3.0) ---
# daimon hosts bote's dispatcher + libro audit tools as builtin MCP tools.
# bote's dist bundle references libro + majra symbols but does NOT bundle
# them, so both are declared explicitly. Declared before bote so the
# auto-include order resolves libro/majra definitions ahead of bote's
# references (Cyrius single-pass forward-reference resolution).
# Full bundles for now; module-trimming to the reachable surface is a
# follow-up per the 1.3.0 arc plan.
#
# sigil (bote's + libro's crypto dep) is pinned explicitly here rather than
# via [deps].stdlib as of 1.4.2. libro 2.8.x's .deps sidecar pulls sigil as
# MODULAR component files (dist/sigil-mldsa.cyr, dist/sigil-sha.cyr, ...),
# which collided with the monolithic dist/sigil.cyr the stdlib snapshot
# vendored — 227 "duplicate fn (last definition wins)" warnings between the
# two packagings of the SAME sigil 3.12.1. An explicit top-level pin at
# modules=["dist/sigil.cyr"] (the self-contained umbrella; supplies every
# symbol incl. the tls_native_lowlevel sha384_init_into path that motivated
# the original stdlib entry) overrides the transitive modular selection, so
# exactly one sigil packaging is vendored. Mirrors bote/libro/majra, which
# all pin sigil explicitly for the same registry-lag / packaging reason.
# bayan (JSON/base64/etc) is pinned explicitly here for the SAME reason sigil
# is, one line below. The stdlib snapshot vendors the monolithic
# dist/bayan.cyr, while libro/bote/majra's .deps sidecars pull bayan as
# MODULAR component files (dist/bayan-json.cyr, ...). Before this pin the two
# were not even the same RELEASE -- lib/bayan.cyr read "Version: 1.4.1" while
# lib/bayan-json.cyr read "Version: 1.5.2" -- producing 20 "duplicate fn (last
# definition wins)" warnings plus an `undefined function 'json_v_parse_str'`,
# because the 1.5.2 modular half called into a 1.4.1 monolith that no longer
# exported it. An explicit top-level pin at modules=["dist/bayan.cyr"]
# overrides the transitive modular selection so exactly one packaging, at one
# version, is vendored.
[deps.bayan]
git = "https://github.com/MacCracken/bayan.git"
tag = "1.5.6"
modules = ["dist/bayan.cyr"]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.12.18"
modules = ["dist/sigil.cyr"]

[deps.libro]
git = "https://github.com/MacCracken/libro.git"
tag = "2.10.3"
modules = ["dist/libro.cyr"]

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
tag = "2.9.1"
modules = ["dist/majra.cyr"]

[deps.bote]
git = "https://github.com/MacCracken/bote.git"
tag = "3.3.13"
modules = ["dist/bote.cyr"]

# nein — firewall MCP tools (2.1.8). nein owns no transport: it exports six
# flat-arg tools plus a tool table and a dispatch-by-name adapter; daimon
# supplies the registry, the transport and the access gate. Wired per nein's
# docs/guides/mcp-host-integration.md §"Path B — recommended for daimon".
#
# ⚠ DECLARED AFTER bote AND sigil, deliberately. dist/nein-mcp.cyr leaves bote
# (jsonx / dispatcher / annotations) and sigil (ed25519 / hex / sha256) symbols
# UNRESOLVED by design — the host supplies them — and cyrius resolves forward
# references in a single pass, so the bundle must come after both.
#
# ⚠ PIN >= 1.7.0. Its error enum is fully `NEIN_ERR_*` namespaced (1.7.0 renamed
# the last four bare `ERR_*`; values unchanged, so nein_err_code is unaffected).
# 1.6.11 could not be linked by daimon at all: `bridge_config_new`
# collided with bote's at a different arity (cyrius refuses the binary), and
# nein's own nft-apply path called `sys_dup2` / `sys_execve`, which do not exist
# on agnos — breaking daimon's --agnos build. 1.6.12 fixes both upstream.
[deps.nein]
git = "https://github.com/MacCracken/nein.git"
path = "../nein"
tag = "1.7.0"
modules = ["dist/nein-mcp.cyr"]

# Distribution manifest. Single binary today (`daimon`), with a best-effort
# aarch64 cross-build; release.yml ships both when cc5_aarch64 is available
# in the toolchain bundle. Kept declarative so future tooling
# (`cyrius package`, ark) reads from one source instead of release.yml.
[release]
bins = ["daimon"]
cross_bins = ["daimon-aarch64"]
