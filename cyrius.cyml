[package]
name = "daimon"
version = "${file:VERSION}"
description = "daimon — AGNOS agent orchestrator"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/daimon"
language = "cyrius"
cyrius = "6.6.6"

[build]
entry = "src/main.cyr"
output = "build/daimon"

[deps]
stdlib = [
    "atomic",
    "string",
    "fmt",
    "math",
    "alloc",
    "vec",
    "str",
    "syscalls",
    "io",
    "fs",
    "hashmap",
    "tagged",
    "bayan",
    "net",
    "mmap",
    "dynlib",
    "fdlopen",
    "tls",
    "sandhi",
    "args",
    "chrono",
    "fnptr",
    "process",
    "async",
    "thread",
    "callback",
    "assert",
    "bench",
    "freelist",
    "ct",
    "keccak",
    "random",
    "slice",
    "thread_local",
    "ws_server",
    "sync",
]

[deps.sakshi]
git = "https://github.com/MacCracken/sakshi.git"
tag = "2.5.2"
modules = ["dist/sakshi.cyr"]

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.4.0"
modules = ["dist/ai-hwaccel.cyr"]

[deps.samay]
git = "https://github.com/MacCracken/samay.git"
path = "../samay"
tag = "1.1.3"
modules = ["dist/samay.cyr"]

[deps.bayan]
git = "https://github.com/MacCracken/bayan.git"
tag = "1.5.6"
modules = ["dist/bayan.cyr"]

[deps.sigil]
git = "https://github.com/MacCracken/sigil.git"
tag = "3.12.18"
modules = ["dist/sigil.cyr"]

[deps.libro]
git = "https://github.com/MacCracken/libro.git"
tag = "2.10.3"
modules = ["dist/libro.cyr"]

[deps.majra]
git = "https://github.com/MacCracken/majra.git"
tag = "2.9.1"
modules = ["dist/majra.cyr"]

[deps.bote]
git = "https://github.com/MacCracken/bote.git"
tag = "3.3.13"
modules = ["dist/bote.cyr"]

[deps.nein]
git = "https://github.com/MacCracken/nein.git"
path = "../nein"
tag = "1.7.0"
modules = ["dist/nein-mcp.cyr"]

[release]
bins = ["daimon"]
cross_bins = ["daimon-aarch64"]
