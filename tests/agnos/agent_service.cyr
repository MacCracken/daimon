# daimon's AGNOS guest test (tests/agnos/run.sh): the service-type fixture agent.
# Ignores SIGTERM and keeps running: the stop agnos cannot finish until the
# kernel can end a process (filed with agnos, 2026-09-23).
include "lib/string.cyr"
include "lib/syscalls.cyr"

syscall(SYS_WRITE, 1, "AGENT service running, ignoring signals\n", 40);
while (1 == 1) {
    sys_pause();   # not sleep_ms#41, which holds the CPU for the whole sleep
}
