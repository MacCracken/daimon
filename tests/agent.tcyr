# =========================================================================
# agent — tests against THE REAL src/agent.cyr
#
# 2.2.0, first bite of the test-integrity arc.
#
# ⚠ tests/daimon.tcyr does NOT include src/. It reimplements simplified copies
# of the functions it names, so a passing suite has never been a statement
# about daimon's shipping source — which is how two security defects shipped
# green (2.1.6's RAG aliasing and the aarch64 syscall pair). Its agent mirror
# covered 10 of src/agent.cyr's 28 functions and none of the process paths.
#
# This file includes the real module and its real dependency chain. The agent
# mirror has been DELETED from daimon.tcyr in the same change, so there is now
# exactly one agent implementation under test.
#
# ⛔ Everything below the accessors is code that had NEVER BEEN EXECUTED before
# this file: agent_spawn_with_limits, agent_start/stop/pause/resume and the
# /proc readers had zero callers in src/ until 2.3.0 wired them to the API.
# The 2.3.0 section at the end drives all of them against real processes.
# =========================================================================

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/bayan.cyr"
include "lib/chrono.cyr"
include "lib/syscalls.cyr"
include "lib/math.cyr"
include "lib/process.cyr"
include "lib/sakshi.cyr"
include "lib/libro.cyr"
include "lib/thread.cyr"
include "lib/assert.cyr"

include "src/syscalls.cyr"
include "src/error.cyr"
include "src/audit.cyr"
include "src/agent.cyr"
include "src/ipc.cyr"      # agent.cyr opens and hands over agent channels (2.3.3)

# A second thread that stays alive until the main thread has counted it —
# released by a flag, not a fixed sleep, so no scheduling delay can make it
# exit early. Bounded at ~10 s so a broken release cannot hang the suite.
var _agent_test_release = 0;
fn _agent_test_sleeper(arg) {
    var ts: i64[2];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);     # 1 ms
    var waited = 0;
    while (_agent_test_release == 0) {
        if (waited >= 10000) { return 0; }
        sys_nanosleep(&ts, 0);
        waited = waited + 1;
    }
    return 0;
}

test_group("agent");

daimon_audit_init();

# --- handle lifecycle ----------------------------------------------------
var h = agent_handle_new(agent_next_id(), str_from("worker-1"));
assert(agent_id(h) > 0, "agent id is allocated");
assert(str_eq(agent_name(h), str_from("worker-1")) == 1, "agent name round-trips");
assert_eq(agent_status(h), AGENT_PENDING, "new agent is PENDING");
assert_eq(agent_pid(h), 0, "new agent has no pid");
assert(agent_created_at(h) > 0, "created_at is stamped");
assert_eq(agent_started_at(h), 0, "started_at is unset");

# ids are monotonic and unique
var h2 = agent_handle_new(agent_next_id(), str_from("worker-2"));
assert(agent_id(h2) > agent_id(h), "ids are monotonic");

agent_set_status(h, AGENT_RUNNING);
assert_eq(agent_status(h), AGENT_RUNNING, "status setter round-trips");
agent_set_pid(h, 4242);
assert_eq(agent_pid(h), 4242, "pid setter round-trips");
agent_set_started_at(h, 99);
assert_eq(agent_started_at(h), 99, "started_at setter round-trips");

# --- resource accessors default to zero ----------------------------------
assert_eq(agent_mem_used(h), 0, "mem_used starts 0");
assert_eq(agent_cpu_time(h), 0, "cpu_time starts 0");
assert_eq(agent_fds_used(h), 0, "fds_used starts 0");
assert_eq(agent_threads(h), 0, "threads starts 0");

# --- /proc readers, against THIS process ---------------------------------
# Never executed before 2.2.0. pid 0 is the documented "no process" input and
# must not read the filesystem; our own pid must produce real numbers.
assert_eq(read_vm_rss(0), 0, "read_vm_rss(0) short-circuits");
assert_eq(read_cpu_time_ms(0), 0, "read_cpu_time_ms(0) short-circuits");
assert_eq(count_fds(0), 0, "count_fds(0) short-circuits");
assert_eq(count_threads(0), 1, "count_threads(0) answers 1, not 0");

var me = sys_getpid();
assert(read_vm_rss(me) > 0, "read_vm_rss reads a real RSS for this process");
# ⛔ CORRECTED at 2.2.3. This block used to assert — labelled KNOWN GAP — that
# dir_list enumerates nothing under /proc/<pid>/fd, blaming the stdlib. It was
# daimon: `dir_list` takes a Str, and count_fds/count_threads (and this test's
# own probe) passed `str_data(path)`, a raw pointer. The "control" that made it
# look procfs-specific, `dir_list("/tmp")`, passed a string LITERAL, which the
# compiler converts to a Str for a `: Str` parameter — so the control changed
# the argument's form as well as the directory. Measured: dir_list on
# /proc/<pid>/fd gives 4 entries for a Str and 0 for str_data, and /tmp gives 0
# for str_data as well. The assertions below are the real values.
var fdpath = str_builder_new();
str_builder_add_cstr(fdpath, "/proc/");
str_builder_add_int(fdpath, me);
str_builder_add_cstr(fdpath, "/fd");
var fdents = dir_list(str_builder_build(fdpath));
assert(vec_len(fdents) > 0, "dir_list(Str) enumerates /proc/<pid>/fd");

# The pair that pins the diagnosis: the same directory, the same call, only the
# argument's FORM differs. If this ever stops holding, the 2.2.3 note is wrong.
var tmp_sb = str_builder_new();
str_builder_add_cstr(tmp_sb, "/tmp");
var tmp_s = str_builder_build(tmp_sb);
assert(vec_len(dir_list(tmp_s)) > 0, "dir_list(Str \"/tmp\") enumerates entries");
assert_eq(vec_len(dir_list(str_data(tmp_s))), 0,
  "dir_list(raw pointer) enumerates nothing — even for /tmp — which is the 2.2.0 bug");

assert(count_fds(me) > 0, "count_fds reads a real open-fd count (was always 0)");
assert_eq(count_threads(me), 1, "count_threads: this test process has one thread");

# agent_update_resources writes the three fields it owns — measured while this
# process is single-threaded, so the thread count it stores is exactly 1.
agent_set_pid(h, me);
agent_update_resources(h);
assert(agent_mem_used(h) > 0, "agent_update_resources populated mem_used");
assert(agent_fds_used(h) > 0, "agent_update_resources stores a real fds count");
assert_eq(agent_threads(h), 1, "agent_update_resources stores the thread count");

# count_threads must COUNT, not fall back: with a second thread alive it reads 2.
# (Single-threaded, the bug's fallback of 1 and the right answer coincide — so
# only a live second thread can tell them apart.)
#
# ⚠ Nothing may count threads AFTER thread_join. The join returns when the
# kernel clears the thread's tid (CLONE_CHILD_CLEARTID), which happens BEFORE
# the exiting thread is removed from /proc/<pid>/task — so for a moment the
# dead thread is still listed. 2.2.3 first shipped the resource check after
# the join: green on a fast machine, and on the CI runner it read 2 (reproduced
# locally 3 in 100 runs pinned to one busy CPU).
var t2 = thread_create(&_agent_test_sleeper, 0);
assert(t2 != 0, "second thread started");
assert_eq(count_threads(me), 2, "count_threads sees a second live thread (was stuck at 1)");
_agent_test_release = 1;
thread_join(t2);

# --- liveness ------------------------------------------------------------
assert_eq(agent_is_alive(agent_handle_new(99, str_from("x"))), 0,
  "an agent with pid 0 is not alive");
agent_set_pid(h, me);
assert_eq(agent_is_alive(h), 1, "kill(self, 0) reports this process alive");

# --- normalize_vec -------------------------------------------------------
var v = alloc(24);
store64(v, f64_from(3));
store64(v + 8, f64_from(4));
store64(v + 16, f64_from(0));
var n = normalize_vec(v, 3);
# |(3,4,0)| = 5, so the unit vector is (0.6, 0.8, 0) and its magnitude is 1.
# Asserted as a bounded magnitude-squared rather than an exact component
# compare: no abs/epsilon helper exists in the stdlib's f64 surface, and
# bounding is the honest shape for a float assertion anyway.
var msq = f64_add(f64_add(f64_mul(load64(n), load64(n)),
    f64_mul(load64(n + 8), load64(n + 8))),
  f64_mul(load64(n + 16), load64(n + 16)));
var lo = f64_div(f64_from(99), f64_from(100));
var hi = f64_div(f64_from(101), f64_from(100));
assert(f64_gt(msq, lo) == 1, "normalized vector has magnitude > 0.99");
assert(f64_gt(hi, msq) == 1, "normalized vector has magnitude < 1.01");
var zero = alloc(16);
store64(zero, f64_from(0));
store64(zero + 8, f64_from(0));
var nz = normalize_vec(zero, 2);
assert(f64_eq(load64(nz), f64_from(0)) == 1,
  "normalize_vec of a zero vector is zero, not NaN");

# --- 2.2.1: the handle must OWN its name ---------------------------------
# LIVE leak on POST /v1/agents: api_register_agent passes a jget VIEW into the
# reused request buffer, and agent_handle_new stored it raw, so GET /v1/agents
# served the next client's bytes as this agent's name. The 1.2.5 clobber shape:
var nbuf = alloc(32);
memcpy(nbuf, "live-agent-name", 15);
var hname = agent_handle_new(agent_next_id(), str_new(nbuf, 15));
memset(nbuf, 88, 32);                  # the next request reuses the buffer
assert(str_eq(agent_name(hname), str_from("live-agent-name")) == 1,
  "agent name survives the request buffer being reused");

# =========================================================================
# 2.3.0 — the lifecycle, against REAL processes
#
# Everything here runs the shipping spawn / signal / reap code on real
# children: shell-script fixture agents in a private directory, and `sh -c`
# probes that report what the child actually received. Each fixture that
# traps a signal writes `<its path>.ready.<its pid>` AFTER installing the trap,
# and the test waits for that file — a SIGTERM that arrived before the trap
# would kill the shell outright (143) and make the graceful-stop checks racy.
# =========================================================================

# <dir>/<file>, NUL-terminated (builder output).
fn _t_path(dir, file) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, file);
    return str_data(str_builder_build(sb));
}

fn _t_script(dir, file, body) {
    var p = _t_path(dir, file);
    file_write_all(p, body, strlen(body));
    sys_chmod(p, 493);   # 0755
    return p;
}

var _t_sleep: i64[2];
fn _t_nap_ms(ms) {
    store64(&_t_sleep, 0);
    store64(&_t_sleep + 8, ms * 1000000);
    sys_nanosleep(&_t_sleep, 0);
    return 0;
}

# Wait up to ~3 s for `path` to exist.
fn _t_wait_file(path) {
    var i = 0;
    while (i < 300) {
        if (file_exists(path) == 1) { return 1; }
        _t_nap_ms(10);
        i = i + 1;
    }
    return 0;
}

# The fixture's ready marker for a started agent: <exe>.ready.<pid>
fn _t_ready(exe, pid) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, exe);
    str_builder_add_cstr(sb, ".ready.");
    str_builder_add_int(sb, pid);
    return str_data(str_builder_build(sb));
}

# The state letter in /proc/<pid>/stat ('S', 'R', 'T', 'Z', ...), or 0.
fn _t_proc_state(pid) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "/proc/");
    str_builder_add_int(sb, pid);
    str_builder_add_cstr(sb, "/stat");
    var buf = alloc(1024);
    var n = file_read_all(str_data(str_builder_build(sb)), buf, 1023);
    if (n <= 0) { return 0; }
    var i = n - 1;
    while (i > 0) {
        if (load8(buf + i) == 41) { break; }   # the ')' closing comm
        i = i - 1;
    }
    return load8(buf + i + 2);
}

# Wait up to ~3 s for the process state to become (want_eq=1) or leave (0) `st`.
fn _t_wait_state(pid, st, want_eq) {
    var i = 0;
    while (i < 300) {
        var s = _t_proc_state(pid);
        if (want_eq == 1) { if (s == st) { return 1; } }
        if (want_eq == 0) { if (s != st) { return 1; } }
        _t_nap_ms(10);
        i = i + 1;
    }
    return 0;
}

# Run `sh -c <script>` through THE REAL spawn path; its exit code, or
# -100 - reason if the spawn itself was refused.
fn _t_sh(script, envp, mem, cpu) {
    var argv = alloc(32);
    store64(argv, "/bin/sh");
    store64(argv + 8, "-c");
    store64(argv + 16, script);
    store64(argv + 24, 0);
    var r_t, r_v = agent_spawn_with_limits("/bin/sh", argv, envp, mem, cpu, 0 - 1, 0 - 1);
    if (is_err_result(r_t) == 1) { return 0 - 100 - r_v; }
    return daimon_reap_within(r_v, 5000);
}

# Poll agent_reap until it collects the agent (bounded ~3 s).
fn _t_reap_wait(h) {
    var i = 0;
    while (i < 300) {
        if (agent_reap(h) == 1) { return 1; }
        _t_nap_ms(10);
        i = i + 1;
    }
    return 0;
}

# --- types -----------------------------------------------------------------
test_group("agent_types");
assert_eq(agent_type_parse(str_from("System")), AGENT_TYPE_SYSTEM, "parse System");
assert_eq(agent_type_parse(str_from("user")), AGENT_TYPE_USER, "parse user (lower case)");
assert_eq(agent_type_parse(str_from("Service")), AGENT_TYPE_SERVICE, "parse Service");
assert_eq(agent_type_parse(str_from("root")), 0 - 1, "an unknown type is refused");
assert_eq(agent_type_parse(str_from("USER")), 0 - 1, "only agnostik's form or all lower case");
assert_eq(agent_type_parse(0), 0 - 1, "a missing type is refused");
assert_eq(streq(agent_type_name(AGENT_TYPE_SERVICE), "Service"), 1, "Service round-trips");
assert_eq(streq(agent_type_name(AGENT_TYPE_SYSTEM), "System"), 1, "System round-trips");
var ht = agent_handle_new(agent_next_id(), str_from("typed"));
assert_eq(agent_type(ht), AGENT_TYPE_USER, "a new agent is a User agent (agnostik's default)");
assert_eq(agent_exit_code(ht), 0 - 1, "a new agent has no exit code");
agent_set_type(ht, AGENT_TYPE_SYSTEM);
assert_eq(agent_type(ht), AGENT_TYPE_SYSTEM, "type setter round-trips");

# --- the spawn, probed from inside the child -----------------------------
test_group("agent_spawn");
# As daimon's main does. The child must NOT inherit this (lib/syscalls.cyr
# signal_default: an ignored disposition survives execve).
signal_ignore(SIGPIPE);

assert_eq(_t_sh("exit 0", 0, 0, 0), 0, "spawn: a child that exec'd and exited 0 reaps as 0");
assert_eq(_t_sh("exit 42", 0, 0, 0), 42, "spawn: the exit code comes back through the reap");
assert_eq(_t_sh("kill -9 $$", 0, 0, 0), 137, "spawn: killed by SIGKILL reaps as 128 + 9");

# A missing executable is an Err from the spawn itself, not a 'running' agent
# that dies later with 127 — and the failed child does not stay a zombie.
var nx_argv = alloc(16);
store64(nx_argv, "/nonexistent/daimon-test-agent");
store64(nx_argv + 8, 0);
var nx_t, nx_v = agent_spawn_with_limits("/nonexistent/daimon-test-agent", nx_argv, 0, 0, 0, 0 - 1, 0 - 1);
assert_eq(is_err_result(nx_t), 1, "spawn: a missing executable is an Err");
assert_eq(nx_v, AGENT_OP_NO_EXEC, "spawn: ... reported as AGENT_OP_NO_EXEC");
var nx_st: i32[1];
assert_eq(sys_waitpid(0 - 1, &nx_st, 1), 0 - 10, "spawn: the failed child was reaped (ECHILD: no children left)");

# Descriptors: one this process holds open (not close-on-exec) must not reach
# the child. The control proves the /proc probe can see an inherited one.
var kfd = sys_open("/dev/null", 0, 0);
assert(kfd > 2, "test fd opened");
var fdsb = str_builder_new();
str_builder_add_cstr(fdsb, "test ! -e /proc/$$/fd/");
str_builder_add_int(fdsb, kfd);
assert_eq(_t_sh(str_data(str_builder_build(fdsb)), 0, 0, 0), 0,
  "spawn: an open descriptor of the parent is NOT inherited (was: listening socket + client conn)");
assert_eq(_t_sh("test -e /proc/$$/fd/2", 0, 0, 0), 0, "spawn: control — stdio IS inherited");
sys_close(kfd);

assert_eq(_t_sh("[ \"$(readlink /proc/$$/fd/0)\" = /dev/null ]", 0, 0, 0), 0,
  "spawn: stdin is /dev/null");
assert_eq(_t_sh("m=$(sed -n 's/^SigIgn:[[:space:]]*//p' /proc/$$/status); [ $(( 0x$m & 4096 )) -eq 0 ]", 0, 0, 0), 0,
  "spawn: SIGPIPE is NOT ignored in the child although this process ignores it");
assert_eq(_t_sh("m=$(sed -n 's/^SigIgn:[[:space:]]*//p' /proc/$PPID/status); [ $(( 0x$m & 4096 )) -ne 0 ]", 0, 0, 0), 0,
  "spawn: control — the parent really does ignore SIGPIPE");

# VULN-010: both limits reach the child.
assert_eq(_t_sh("[ \"$(ulimit -v)\" = 1048576 ] && [ \"$(ulimit -t)\" = 7 ]", 0, 1073741824, 7), 0,
  "spawn: RLIMIT_AS (1 GiB) and RLIMIT_CPU (7 s) are applied");

# The environment passed is the one the child gets; agent_environ mirrors ours.
var menv = alloc(16);
store64(menv, "DAIMON_TEST_MARK=present");
store64(menv + 8, 0);
assert_eq(_t_sh("[ \"$DAIMON_TEST_MARK\" = present ]", menv, 0, 0), 0, "spawn: envp reaches the child");
var ev = agent_environ();
var evn = 0;
while (load64(ev + evn * 8) != 0) { evn = evn + 1; }
var envbuf = alloc(262144);
var envlen = file_read_all("/proc/self/environ", envbuf, 262143);
var envnul = 0;
var eix = 0;
while (eix < envlen) { if (load8(envbuf + eix) == 0) { envnul = envnul + 1; } eix = eix + 1; }
assert_eq(evn, envnul, "agent_environ: one envp entry per /proc/self/environ variable");
if (getenv("PATH") != 0) {
    assert_eq(_t_sh("[ -n \"$PATH\" ]", ev, 0, 0), 0, "spawn: with agent_environ the child inherits PATH");
}

# --- 2.3.4: the minimal agent environment (VULN-015) ---------------------------
# This process's environment carries a would-be secret; a minimal environment
# keeps it from the agent, inherit (the default) passes it on.
var secret_env = alloc(64);
memcpy(secret_env, "DAIMON_TEST_SECRET=hunter2", 26);
store8(secret_env + 26, 0);
var envs = agent_environ();
var en = 0;
while (load64(envs + en * 8) != 0) { en = en + 1; }
var envx = alloc((en + 2) * 8);
memcpy(envx, envs, en * 8);
store64(envx + en * 8, secret_env);
store64(envx + (en + 1) * 8, 0);
_agent_envp = envx;               # as if daimon had been started with it
agent_set_env_mode(AGENT_ENV_INHERIT);
var env_in = "[ \"$DAIMON_TEST_SECRET\" = hunter2 ] && [ \"$AGNOS_IPC_FD\" = 3 ]";
assert_eq(_t_sh(env_in, agent_environ_ipc(), 0, 0), 0,
  "env: inherit passes daimon's whole environment, plus AGNOS_IPC_FD");
agent_set_env_mode(AGENT_ENV_MINIMAL);
var env_min = "[ -z \"$DAIMON_TEST_SECRET\" ] && [ -n \"$PATH\" ] && [ \"$AGNOS_IPC_FD\" = 3 ]";
assert_eq(_t_sh(env_min, agent_environ_ipc(), 0, 0), 0,
  "env: minimal keeps PATH and AGNOS_IPC_FD, and drops the rest");
agent_set_env_mode(AGENT_ENV_INHERIT);
_agent_envp = envs;

# --- 2.3.4: daimon raises its descriptor limit; agents get the original --------
# Lower this process's soft RLIMIT_NOFILE to 512 (a systemd service starts at
# 1024), raise it the way `serve` does, and look at what an agent is given.
var nf0: i64[2];
syscall(_DAIMON_SYS_PRLIMIT64, 0, _DAIMON_RLIMIT_NOFILE, 0, &nf0);
var nf_max = load64(&nf0 + 8);
if (nf_max < 0 || nf_max >= 4096) {
    var nf_low: i64[2];
    store64(&nf_low, 512);
    store64(&nf_low + 8, nf_max);
    assert_eq(syscall(_DAIMON_SYS_PRLIMIT64, 0, _DAIMON_RLIMIT_NOFILE, &nf_low, 0), 0,
      "nofile: soft limit lowered to 512");
    assert_eq(agent_nofile_raise(4096), 4096, "nofile: daimon raises its soft limit to what it asks for");
    var nf_now: i64[2];
    syscall(_DAIMON_SYS_PRLIMIT64, 0, _DAIMON_RLIMIT_NOFILE, 0, &nf_now);
    assert_eq(load64(&nf_now), 4096, "nofile: ... and it is in force");
    assert_eq(agent_nofile_raise(1024), 4096, "nofile: asking for less changes nothing");
    assert_eq(_t_sh("[ \"$(ulimit -Sn)\" = 512 ]", 0, 0, 0), 0,
      "nofile: an agent gets the limit daimon started with, not the raised one");
    syscall(_DAIMON_SYS_PRLIMIT64, 0, _DAIMON_RLIMIT_NOFILE, &nf0, 0);   # as this process found it
}

# --- the reap / signal guards ------------------------------------------------
test_group("agent_guards");
var g_argv = alloc(32);
store64(g_argv, "/bin/sh");
store64(g_argv + 8, "-c");
store64(g_argv + 16, "sleep 0.3");
store64(g_argv + 24, 0);
var g_t, g_pid = agent_spawn_with_limits("/bin/sh", g_argv, 0, 0, 0, 0 - 1, 0 - 1);
assert_eq(is_ok(g_t), 1, "guard fixture started");
assert_eq(daimon_reap_code(0), 0 - 1, "reap(0) is refused — it would reap ANY child in the group");
assert_eq(daimon_reap_code(0 - 1), 0 - 1, "reap(-1) is refused — it would reap ANY child");
assert_eq(daimon_signal(0, 0), 0 - 1, "signal(0) is refused — it would signal daimon's own group");
assert_eq(daimon_signal(0 - 1, 0), 0 - 1, "signal(-1) is refused — it would signal every process");
assert_eq(daimon_reap_code(g_pid), 0 - 2, "the fixture is still running, so it was not stolen above");
assert_eq(daimon_reap_within(g_pid, 3000), 0, "and it reaps normally by its own pid");

# --- the lifecycle through agent_start / stop / pause / resume / reap ------
test_group("agent_lifecycle");
var tdsb = str_builder_new();
str_builder_add_cstr(tdsb, "/tmp/daimon-test-agents-");
str_builder_add_int(tdsb, sys_getpid());
var adir = str_data(str_builder_build(tdsb));
xmkdir_p(adir, 448);
var user_exe = _t_script(adir, "agnos-agent-user-agent",
  "#!/bin/sh\ntrap 'exit 0' TERM\n: > \"$0.ready.$$\"\nwhile :; do sleep 0.05; done\n");
var svc_exe = _t_script(adir, "agnos-agent-service-agent",
  "#!/bin/sh\ntrap '' TERM\n: > \"$0.ready.$$\"\nwhile :; do sleep 0.05; done\n");
var sys_exe = _t_script(adir, "agnos-agent-system-agent", "#!/bin/sh\nexit 3\n");
agent_set_agents_dir(adir);

assert_eq(streq(agent_find_executable(AGENT_TYPE_USER), user_exe), 1, "a type resolves to its own executable");
assert_eq(streq(agent_find_executable(AGENT_TYPE_SERVICE), svc_exe), 1, "... per type");

var la = agent_handle_new(agent_next_id(), str_from("life"));
assert_eq(agent_limits_enforced(la), 0, "limits: an agent never started reports none (2.4.0)");
var s_t, s_pid = agent_start(la, 1073741824, 3600);
assert_eq(is_ok(s_t), 1, "start: a PENDING agent starts");
assert_eq(agent_status(la), AGENT_RUNNING, "start: RUNNING");
assert_eq(agent_pid(la), s_pid, "start: the pid is recorded");
assert(agent_started_at(la) > 0, "start: started_at is stamped");
assert_eq(agent_limits_enforced(la), 1, "start: its process runs under its limits (Linux; not agnos yet)");
assert_eq(_t_wait_file(_t_ready(user_exe, s_pid)), 1, "start: the agent is running its program");
var re_t, re_v = agent_start(la, 0, 0);
assert_eq(re_v, AGENT_OP_BAD_STATE, "start: a RUNNING agent cannot be started again");
var rs_t, rs_v = agent_resume(la);
assert_eq(rs_v, AGENT_OP_BAD_STATE, "resume: only a PAUSED agent resumes");

var p_t, p_v = agent_pause(la);
assert_eq(is_ok(p_t), 1, "pause: Ok");
assert_eq(agent_status(la), AGENT_PAUSED, "pause: PAUSED");
assert_eq(_t_wait_state(s_pid, 84, 1), 1, "pause: the process really is stopped (state T)");
var p2_t, p2_v = agent_pause(la);
assert_eq(p2_v, AGENT_OP_BAD_STATE, "pause: a PAUSED agent cannot be paused again");
var r_t, r_v = agent_resume(la);
assert_eq(is_ok(r_t), 1, "resume: Ok");
assert_eq(agent_status(la), AGENT_RUNNING, "resume: RUNNING");
assert_eq(_t_wait_state(s_pid, 84, 0), 1, "resume: the process runs again");

# Stop a PAUSED agent: SIGTERM alone would wait out the grace (a stopped
# process cannot act on it); the SIGCONT that follows lets it exit cleanly.
agent_pause(la);
assert_eq(_t_wait_state(s_pid, 84, 1), 1, "re-paused");
var t0 = clock_now_ms();
agent_stop(la, STOP_USER);
var took = clock_now_ms() - t0;
assert_eq(agent_status(la), AGENT_STOPPED, "stop: STOPPED");
assert_eq(agent_exit_code(la), 0, "stop: exited 0 through its own SIGTERM handler (not SIGKILLed)");
assert_eq(agent_pid(la), 0, "stop: the reaped pid is cleared — never signalled again");
assert(took < AGENT_STOP_GRACE_MS, "stop: a paused agent was not left to the SIGKILL deadline");
assert_eq(sys_kill(s_pid, 0), 0 - 3, "stop: the process is gone (ESRCH), not a zombie");
assert_eq(agent_reap(la), 0, "reap: nothing to reap once stopped");

# STOPPED -> start again.
var s2_t, s2_pid = agent_start(la, 1073741824, 3600);
assert_eq(is_ok(s2_t), 1, "restart: a STOPPED agent starts again");
assert(s2_pid != s_pid, "restart: a new process");
assert_eq(agent_exit_code(la), 0 - 1, "restart: the old exit code is cleared");
assert_eq(_t_wait_file(_t_ready(user_exe, s2_pid)), 1, "restart: running its program");
agent_stop(la, STOP_USER);
assert_eq(agent_exit_code(la), 0, "restart: stops cleanly again");

# SIGKILL escalation: an agent that ignores SIGTERM.
AGENT_STOP_GRACE_MS = 300;
var lk = agent_handle_new(agent_next_id(), str_from("stubborn"));
agent_set_type(lk, AGENT_TYPE_SERVICE);
var k_t, k_pid = agent_start(lk, 0, 0);
assert_eq(is_ok(k_t), 1, "stubborn agent started");
assert_eq(_t_wait_file(_t_ready(svc_exe, k_pid)), 1, "stubborn agent installed its SIGTERM ignore");
var k0 = clock_now_ms();
agent_stop(lk, STOP_USER);
var ktook = clock_now_ms() - k0;
assert_eq(agent_exit_code(lk), 137, "stop: an agent ignoring SIGTERM is SIGKILLed (128 + 9)");
assert_eq(agent_status(lk), AGENT_STOPPED, "stop: and ends STOPPED");
assert(ktook >= 300, "stop: SIGKILL waited out the grace period");
assert(ktook < 300 + 1500, "stop: and the grace is bounded by the clock (was: counted sleeps)");
AGENT_STOP_GRACE_MS = 5000;

# An agent that exits on its own is collected by agent_reap.
var lf = agent_handle_new(agent_next_id(), str_from("crasher"));
agent_set_type(lf, AGENT_TYPE_SYSTEM);
var f_t, f_pid = agent_start(lf, 0, 0);
assert_eq(is_ok(f_t), 1, "self-exiting agent started (its exec succeeded)");
assert_eq(_t_reap_wait(lf), 1, "reap: collected after it exited on its own");
assert_eq(agent_status(lf), AGENT_FAILED, "reap: a non-zero exit is FAILED");
assert_eq(agent_exit_code(lf), 3, "reap: with its exit code");
assert_eq(agent_pid(lf), 0, "reap: and its pid cleared");
var f2_t, f2_pid = agent_start(lf, 0, 0);
assert_eq(is_ok(f2_t), 1, "a FAILED agent can be started again (its process is gone)");
_t_reap_wait(lf);

# Nothing installed for a type: refused before anything is attempted.
var edsb = str_builder_new();
str_builder_add_cstr(edsb, adir);
str_builder_add_cstr(edsb, "/empty");
var edir = str_data(str_builder_build(edsb));
xmkdir_p(edir, 448);
agent_set_agents_dir(edir);
var ln = agent_handle_new(agent_next_id(), str_from("nobody"));
var n_t, n_v = agent_start(ln, 0, 0);
assert_eq(n_v, AGENT_OP_NO_EXECUTABLE, "start: no executable for the type is AGENT_OP_NO_EXECUTABLE");
assert_eq(agent_status(ln), AGENT_PENDING, "start: and the agent is untouched (still PENDING)");
# The generic runner is the fallback, as in the Rust original.
var runner = _t_script(edir, "agnos-agent-runner", "#!/bin/sh\nexit 0\n");
assert_eq(streq(agent_find_executable(AGENT_TYPE_USER), runner), 1,
  "no type executable: the generic agnos-agent-runner is used");

# VULN-010, the refusal: an rlimit that cannot be applied means NO start.
# Lower this process's own hard RLIMIT_CPU (irreversible for it — the test
# needs seconds, not a day), then ask for more than that: the child's
# prlimit64 fails EPERM and it must not exec.
# (Not as root: root may raise its own hard limit, so nothing would fail.)
agent_set_agents_dir(adir);
if (sys_getuid() != 0) {
    var own = alloc(16);
    store64(own, 86400);
    store64(own + 8, 86400);
    assert_eq(syscall(_DAIMON_SYS_PRLIMIT64, 0, RLIMIT_CPU, own, 0), 0, "lowered this process's hard CPU limit");
    var lx = agent_handle_new(agent_next_id(), str_from("unconfinable"));
    var x_t, x_v = agent_start(lx, 0, 172800);
    assert_eq(x_v, AGENT_OP_NO_LIMITS, "start: a limit that cannot be applied refuses the start (was: exit 126 later)");
    assert_eq(agent_status(lx), AGENT_FAILED, "start: the agent is FAILED, with no process");
    assert_eq(agent_pid(lx), 0, "start: no pid recorded");
    if (is_ok(x_t) == 1) { agent_stop(lx, STOP_USER); }   # not refused: do not leave it running

    # The same for RLIMIT_AS: cap this process's hard address-space limit at
    # 64 GiB (or its current hard limit, if lower) and ask for 1 GiB more.
    var cur_as = alloc(16);
    syscall(_DAIMON_SYS_PRLIMIT64, 0, RLIMIT_AS, 0, cur_as);
    var as_cap = 68719476736;
    if (load64(cur_as + 8) > 0) {
        if (load64(cur_as + 8) < as_cap) { as_cap = load64(cur_as + 8); }
    }
    var own_as = alloc(16);
    store64(own_as, as_cap);
    store64(own_as + 8, as_cap);
    assert_eq(syscall(_DAIMON_SYS_PRLIMIT64, 0, RLIMIT_AS, own_as, 0), 0,
      "capped this process's hard address-space limit");
    var lm = agent_handle_new(agent_next_id(), str_from("unconfinable-mem"));
    var m_t, m_v = agent_start(lm, as_cap + 1073741824, 0);
    assert_eq(m_v, AGENT_OP_NO_LIMITS, "start: an address-space limit that cannot be applied refuses the start");
    assert_eq(agent_pid(lm), 0, "start: no pid recorded (RLIMIT_AS)");
    # Under qemu-aarch64 it is not refused (QEMU applies no RLIMIT_AS), and the
    # started agent used to be left running after the suite. Stopped only after
    # the checks above, so they still report it.
    if (is_ok(m_t) == 1) { agent_stop(lm, STOP_USER); }
}

# --- 2.3.4: a stop that does not wait, children, and death with daimon ---------
test_group("agent_stop_async");
var gsb = str_builder_new();
str_builder_add_cstr(gsb, adir);
str_builder_add_cstr(gsb, "/group");
var gdir = str_data(str_builder_build(gsb));
xmkdir_p(gdir, 448);
# The child's output goes to /dev/null: a child left running by a regression
# must not hold this suite's output pipe open (the harness would wait out its
# 300 s instead of reporting the failure).
var grpsb = str_builder_new();
str_builder_add_cstr(grpsb, "#!/bin/sh\ntrap 'exit 0' TERM\nsleep 300 >/dev/null 2>&1 &\n");
str_builder_add_cstr(grpsb, "echo $! > \"$0.kid.$$\"\n: > \"$0.ready.$$\"\nwhile :; do sleep 0.05; done\n");
var grp_exe = _t_script(gdir, "agnos-agent-user-agent", str_data(str_builder_build(grpsb)));
agent_set_agents_dir(gdir);

# 1 once `pid` is gone or a zombie (someone else's to reap).
fn _t_dead(pid) {
    var st = _t_proc_state(pid);
    if (st == 0) { return 1; }
    if (st == 90) { return 1; }   # 'Z'
    return 0;
}

fn _t_wait_dead(pid) {
    var i = 0;
    while (i < 300) {
        if (_t_dead(pid) == 1) { return 1; }
        _t_nap_ms(10);
        i = i + 1;
    }
    return 0;
}

fn _t_kid(exe, pid) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, exe);
    str_builder_add_cstr(sb, ".kid.");
    str_builder_add_int(sb, pid);
    return str_data(str_builder_build(sb));
}

fn _t_read_int(path) {
    var buf = alloc(64);
    var n = file_read_all(path, buf, 63);
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(buf + i);
        if (c >= 48) { if (c <= 57) { v = v * 10 + c - 48; } }
        i = i + 1;
    }
    return v;
}

var la2 = agent_handle_new(agent_next_id(), str_from("async-stop"));
var a2_t, a2_pid = agent_start(la2, 0, 0);
assert_eq(is_ok(a2_t), 1, "async stop: started");
assert_eq(_t_wait_file(_t_ready(grp_exe, a2_pid)), 1, "async stop: running");
var kid = _t_read_int(_t_kid(grp_exe, a2_pid));
assert(kid > 0, "async stop: the agent started a child of its own");
var ab0 = clock_now_ms();
assert_eq(agent_stop_begin(la2, STOP_USER), 0, "async stop: begin returns with the stop under way");
assert(clock_now_ms() - ab0 < 100, "async stop: ... at once, without waiting for the agent");
assert_eq(agent_status(la2), AGENT_STOPPING, "async stop: STOPPING meanwhile");
assert_eq(agent_stop_pending(la2), 1, "async stop: pending");
assert_eq(agent_stop_begin(la2, STOP_USER), 0, "async stop: a second begin changes nothing");
var steps = 0;
while (agent_stop_step(la2, clock_now_ms()) == 0) {
    _t_nap_ms(5);
    steps = steps + 1;
    if (steps > 600) { agent_stop(la2, STOP_USER); }
}
assert_eq(agent_status(la2), AGENT_STOPPED, "async stop: steps to STOPPED");
assert_eq(agent_exit_code(la2), 0, "async stop: exited through its SIGTERM handler");
assert_eq(agent_pid(la2), 0, "async stop: pid cleared");
assert_eq(agent_stop_pending(la2), 0, "async stop: nothing pending");
assert_eq(_t_wait_dead(kid), 1, "a stop reaches the agent's own children (its process group)");
assert_eq(agent_stop_begin(la2, STOP_USER), 1, "async stop: stopping a stopped agent is done at once");

# Pause and resume reach the children too.
var la3 = agent_handle_new(agent_next_id(), str_from("group-pause"));
var a3_t, a3_pid = agent_start(la3, 0, 0);
assert_eq(_t_wait_file(_t_ready(grp_exe, a3_pid)), 1, "group pause: running");
var kid3 = _t_read_int(_t_kid(grp_exe, a3_pid));
agent_pause(la3);
assert_eq(_t_wait_state(kid3, 84, 1), 1, "pause stops the agent's child too (state T)");
agent_resume(la3);
assert_eq(_t_wait_state(kid3, 84, 0), 1, "resume continues it");
agent_stop(la3, STOP_USER);
assert_eq(_t_wait_dead(kid3), 1, "and the stop ends it");

# An agent dies with daimon (PR_SET_PDEATHSIG). A child of this test plays
# daimon: it starts an agent, and exits without stopping it.
var pdf = _t_path(gdir, "pdeath.pid");
var pd_parent = sys_fork();
if (pd_parent == 0) {
    var pargv2 = alloc(40);
    store64(pargv2, "/bin/sh");
    store64(pargv2 + 8, "-c");
    store64(pargv2 + 16, "echo $$ > \"$1\"; while :; do sleep 0.05; done");
    store64(pargv2 + 24, "agent");
    store64(pargv2 + 32, pdf);
    store64(pargv2 + 40, 0);
    agent_spawn_with_limits("/bin/sh", pargv2, 0, 0, 0, 0 - 1, 0 - 1);
    var pw = 0;
    while (pw < 300) {
        if (file_exists(pdf) == 1) { pw = 300; }
        _t_nap_ms(10);
        pw = pw + 1;
    }
    sys_exit_group(0);   # "daimon" dies, leaving its agent
}
var pd_st: i32[1];
sys_waitpid(pd_parent, &pd_st, 0);
assert_eq(_t_wait_file(pdf), 1, "death: the agent reported its pid");
var orphan = _t_read_int(pdf);
assert(orphan > 0, "death: an agent pid");
assert_eq(_t_wait_dead(orphan), 1, "an agent dies with the daimon that started it (was: it outlived daimon)");
if (_t_dead(orphan) == 0) { sys_kill(orphan, 9); }
xunlink(pdf);
xunlink(_t_kid(grp_exe, a2_pid));
xunlink(_t_kid(grp_exe, a3_pid));
xunlink(_t_ready(grp_exe, a2_pid));
xunlink(_t_ready(grp_exe, a3_pid));
xunlink(grp_exe);
xrmdir(gdir);
agent_set_agents_dir(adir);

# --- 2.3.4: captured output -------------------------------------------------------
test_group("agent_output");
var osb = str_builder_new();
str_builder_add_cstr(osb, adir);
str_builder_add_cstr(osb, "/out");
var odir = str_data(str_builder_build(osb));
xmkdir_p(odir, 448);
var outsb = str_builder_new();
str_builder_add_cstr(outsb, "#!/bin/sh\ntrap 'exit 0' TERM\necho to-stdout\necho to-stderr >&2\n");
str_builder_add_cstr(outsb, ": > \"$0.ready.$$\"\nwhile :; do sleep 0.05; done\n");
var out_exe = _t_script(odir, "agnos-agent-user-agent", str_data(str_builder_build(outsb)));
agent_set_agents_dir(odir);
agent_set_output_mode(AGENT_OUTPUT_CAPTURE);
var lo = agent_handle_new(agent_next_id(), str_from("talky"));
var lo_t, lo_pid = agent_start(lo, 0, 0);
assert_eq(is_ok(lo_t), 1, "output: started with its output captured");
assert_eq(_t_wait_file(_t_ready(out_exe, lo_pid)), 1, "output: running");
var loid = str_cstr(str_from_int(agent_id(lo)));
var ow = 0;
while (ow < 100) {
    ipc_poll_once(10);
    if (ipc_output_total(loid) >= 20) { ow = 100; }
    ow = ow + 1;
}
var ltext = ipc_output_text(loid);
assert(ltext != 0, "output: there is captured text");
if (ltext != 0) {
    assert(str_contains(ltext, str_from("to-stdout")) == 1, "output: stdout is captured");
    assert(str_contains(ltext, str_from("to-stderr")) == 1, "output: stderr is captured");
}
agent_stop(lo, STOP_USER);
assert_eq(agent_exit_code(lo), 0, "output: the agent still stops cleanly");
agent_set_output_mode(AGENT_OUTPUT_INHERIT);
ipc_output_forget(loid);
xunlink(_t_ready(out_exe, lo_pid));
xunlink(out_exe);
xrmdir(odir);
agent_set_agents_dir(adir);

# --- 2.3.3: every started agent gets a channel on fd 3 ------------------------
# The fixture reports what it sees from inside, sends one frame on fd 3 and
# reads the reply, leaves a background child holding its fd 3 — in a session of
# its own, so a stop's group signal (2.3.4) does not reach it — then waits to be
# stopped. Because that child keeps the
# channel open, daimon's end is closed only by daimon itself: after a stop or a
# reap, nothing the agent left behind can go on speaking as the agent.
test_group("agent_channel");
var cbus = msg_bus_new();
msg_bus_subscribe(cbus, "999");   # any subscriber: the fixture broadcasts
ipc_attach_bus(cbus);

# Wait up to ~3 s for `path`, running daimon's side of the channels meanwhile
# (the pass daimon's event loop makes; the fixture blocks on its reply).
fn _t_wait_file_ipc(path) {
    var i = 0;
    while (i < 300) {
        if (file_exists(path) == 1) { return 1; }
        ipc_poll_once(10);
        i = i + 1;
    }
    return 0;
}
var csb = str_builder_new();
str_builder_add_cstr(csb, adir);
str_builder_add_cstr(csb, "/chan");
var cdir = str_data(str_builder_build(csb));
xmkdir_p(cdir, 448);
var chsb = str_builder_new();
str_builder_add_cstr(chsb, "#!/bin/sh\ntrap 'exit 0' TERM\no=\"$0.out.$$\"\n{\necho \"env=$AGNOS_IPC_FD\"\n");
str_builder_add_cstr(chsb, "case \"$(readlink /proc/$$/fd/3)\" in socket:*) echo sock=yes;; *) echo sock=no;; esac\n");
str_builder_add_cstr(chsb, "for f in 4 5 6 7 8 9; do [ -e /proc/$$/fd/$f ] && echo \"leak=$f\"; done\n");
str_builder_add_cstr(chsb, "} > \"$o.tmp\"\n");
str_builder_add_cstr(chsb, "printf '\\000\\000\\000\\016{\"target\":\"*\"}' >&3\n");
str_builder_add_cstr(chsb, "r=$(head -c 1 <&3 | od -v -An -tu1 | tr -d ' ')\necho \"reply=$r\" >> \"$o.tmp\"\n");
str_builder_add_cstr(chsb, "setsid sleep 30 >/dev/null 2>&1 &\necho \"bg=$!\" >> \"$o.tmp\"\n");
str_builder_add_cstr(chsb, "mv \"$o.tmp\" \"$o\"\nwhile :; do sleep 0.05; done\n");
var chan_exe = _t_script(cdir, "agnos-agent-user-agent", str_data(str_builder_build(chsb)));
agent_set_agents_dir(cdir);

# The fixture's report file for a started agent: <exe>.out.<pid>
fn _t_out(exe, pid) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, exe);
    str_builder_add_cstr(sb, ".out.");
    str_builder_add_int(sb, pid);
    return str_data(str_builder_build(sb));
}

# The number after "<key>=" on a line of the report, or 0.
fn _t_report_int(buf, n, key) {
    var kl = strlen(key);
    var i = 0;
    while (i + kl < n) {
        if (i == 0 || load8(buf + i - 1) == 10) {
            if (memeq(buf + i, key, kl) == 1) {
                var v = 0;
                var j = i + kl;
                while (j < n && load8(buf + j) >= 48 && load8(buf + j) <= 57) {
                    v = v * 10 + load8(buf + j) - 48;
                    j = j + 1;
                }
                return v;
            }
        }
        i = i + 1;
    }
    return 0;
}

fn _t_has_line(buf, n, line) {
    var ll = strlen(line);
    var i = 0;
    while (i + ll <= n) {
        if (i == 0 || load8(buf + i - 1) == 10) {
            if (memeq(buf + i, line, ll) == 1) {
                if (i + ll == n || load8(buf + i + ll) == 10) { return 1; }
            }
        }
        i = i + 1;
    }
    return 0;
}

# Wait up to ~3 s for this process's descriptor count to be `want`.
fn _t_wait_fds(want) {
    var i = 0;
    while (i < 300) {
        if (count_fds(sys_getpid()) == want) { return 1; }
        _t_nap_ms(10);
        i = i + 1;
    }
    return 0;
}

# The baseline, once the channels of the agents stopped above are closed: the
# service applies removals on its next pass, so wait for the count to hold
# still for 200 ms (bounded ~3 s).
fn _t_settled_fds() {
    var last = count_fds(sys_getpid());
    var same = 0;
    var i = 0;
    while (i < 60) {
        _t_nap_ms(50);
        var now = count_fds(sys_getpid());
        if (now == last) { same = same + 1; } else { same = 0; last = now; }
        if (same >= 4) { return last; }
        i = i + 1;
    }
    return last;
}
var fds0 = _t_settled_fds();
var lc = agent_handle_new(agent_next_id(), str_from("channel"));
var c_t, c_pid = agent_start(lc, 0, 0);
assert_eq(is_ok(c_t), 1, "channel: the agent starts");
var cout = _t_out(chan_exe, c_pid);
assert_eq(_t_wait_file_ipc(cout), 1, "channel: the agent reported");
var crep = alloc(512);
var crn = file_read_all(cout, crep, 511);
assert(crn > 0, "channel: the report is readable");
assert_eq(_t_has_line(crep, crn, "env=3"), 1, "channel: AGNOS_IPC_FD=3 is in the agent's environment");
assert_eq(_t_has_line(crep, crn, "sock=yes"), 1, "channel: fd 3 is a socket");
var leaked = 0;
var lci = 0;
while (lci + 5 <= crn) {
    if (memeq(crep + lci, "leak=", 5) == 1) { leaked = 1; }
    lci = lci + 1;
}
assert_eq(leaked, 0, "channel: nothing else of daimon's reaches the agent (fds 4-9 closed)");
assert_eq(_t_has_line(crep, crn, "reply=1"), 1, "channel: the agent's frame was ACKed");
var bg1 = _t_report_int(crep, crn, "bg=");
assert(bg1 > 0, "channel: the agent's background child is running");
var cq = msg_bus_queue(cbus, "999");
assert_eq(vec_len(cq), 1, "channel: the frame reached daimon's bus");
if (vec_len(cq) == 1) {
    var crec = vec_get(cq, 0);
    assert_eq(str_eq(ipc_msg_source(crec), str_from_int(agent_id(lc))), 1,
      "channel: its source is the agent daimon started (by id)");
    assert_eq(str_eq(ipc_msg_target(crec), str_from("*")), 1, "channel: with the target it sent");
}
assert_eq(count_fds(sys_getpid()), fds0 + 1, "channel: daimon holds one descriptor for it (its own end)");
agent_stop(lc, STOP_USER);
assert_eq(agent_exit_code(lc), 0, "channel: the agent stops cleanly");
assert_eq(_t_wait_fds(fds0), 1,
  "channel: stopping the agent closes daimon's end, though its child still holds the other end");

# A restart gets a fresh channel; an agent that exits on its own has it closed too.
var c2_t, c2_pid = agent_start(lc, 0, 0);
assert_eq(is_ok(c2_t), 1, "channel: restarted");
assert_eq(_t_wait_file_ipc(_t_out(chan_exe, c2_pid)), 1, "channel: the restarted agent reported");
var crn2 = file_read_all(_t_out(chan_exe, c2_pid), crep, 511);
assert_eq(_t_has_line(crep, crn2, "reply=1"), 1, "channel: the restarted agent's frame was ACKed too");
var bg2 = _t_report_int(crep, crn2, "bg=");
assert_eq(vec_len(msg_bus_queue(cbus, "999")), 2, "channel: the restarted agent's frame reached the bus");
sys_kill(c2_pid, 9);
assert_eq(_t_reap_wait(lc), 1, "channel: the killed agent is reaped");
assert_eq(_t_wait_fds(fds0), 1,
  "channel: reaping an agent closes its channel, though its child still holds the other end");
if (bg1 > 0) { sys_kill(bg1, 9); }
if (bg2 > 0) { sys_kill(bg2, 9); }
xunlink(_t_out(chan_exe, c_pid));
xunlink(_t_out(chan_exe, c2_pid));
xunlink(chan_exe);
xrmdir(cdir);
agent_set_agents_dir(adir);

# --- 2.4.2: containment, a cgroup per agent -----------------------------------
# Where this suite usually runs, daimon's cgroup is not its own to divide (a login
# session's scope is root's; CI's runner is not delegated), so agents start
# uncontained here. tests/containment.sh checks the whole behaviour inside a
# cgroup daimon may divide. These check the parts, on plain directories and files
# standing in for cgroups.
test_group("agent_containment");

# 1 if `body`, written to <dir>/<name>, names cgroup `want`.
fn _t_cg_of_is(dir, name, body, want) {
    var at = _agent_cg_of(_t_script(dir, name, body));
    if (at == 0) { return 0; }
    return streq(at, want);
}

var cg_state = agent_cgroup_init();
assert(cg_state == 1 || cg_state == 2, "containment: decided once, available (1) or not (2)");
assert_eq(agent_cgroup_init(), cg_state, "... and the same answer after");
var cg_own = _agent_cg_own();
assert(cg_own != 0, "containment: daimon's cgroup is read from /proc/self/cgroup (cgroup v2)");
if (cg_own != 0) {
    assert_eq(memeq(cg_own, "/sys/fs/cgroup", 14), 1, "... as a directory under /sys/fs/cgroup");
}
var cgh = agent_handle_new(agent_next_id(), str_from("contain"));
var cgs_t, cgs_pid = agent_start(cgh, 0, 0);
assert_eq(is_ok(cgs_t), 1, "containment: an agent starts either way");
var cg_want = 0;
if (cg_state == 1) { cg_want = 1; }
assert_eq(agent_contained(cgh), cg_want, "... contained exactly when daimon can make cgroups");
agent_stop(cgh, STOP_USER);
assert_eq(agent_contained(cgh), 0, "... and its cgroup is let go when its process is collected");
xunlink(_t_ready(user_exe, cgs_pid));

# A process's cgroup is the cgroup v2 line ("0::<path>") of its /proc/<pid>/cgroup.
var fcg = _t_path(adir, "fakecg");
xmkdir_p(fcg, 448);
assert_eq(_t_cg_of_is(fcg, "cg1", "0::/a/b\n", "/sys/fs/cgroup/a/b"), 1,
  "containment: a cgroup is read from its cgroup v2 line");
assert_eq(_t_cg_of_is(fcg, "cg2", "12:cpuset:/x\n1:name=systemd:/y\n0::/z\n", "/sys/fs/cgroup/z"), 1,
  "... past the cgroup v1 lines of a hybrid hierarchy");
assert_eq(_t_cg_of_is(fcg, "cg3", "0::/\n", "/sys/fs/cgroup"), 1, "... the root as /sys/fs/cgroup itself");
assert_eq(_agent_cg_of(_t_script(fcg, "cg4", "12:cpuset:/x\n")), 0, "... and none from cgroup v1 alone");
xunlink(_t_path(fcg, "cg1"));
xunlink(_t_path(fcg, "cg2"));
xunlink(_t_path(fcg, "cg3"));
xunlink(_t_path(fcg, "cg4"));

# An agent that exits before daimon checks where it is. A process that has exited
# and is not yet collected is not in cgroup.procs, and /proc/<pid>/cgroup still
# names its cgroup. Until the 2.4.2 review daimon read cgroup.procs: such an agent
# was judged never to have entered, audited as a failure, and what it left in its
# cgroup was out of reach.
var true_argv = alloc(16);
store64(true_argv, "/bin/true");
store64(true_argv + 8, 0);
if (cg_own != 0) {
    assert_eq(_agent_cg_in(cg_own, sys_getpid()), 1, "containment: a process is found in its cgroup");
    var zt_t, zt_pid = agent_spawn_with_limits("/bin/true", true_argv, 0, 0, 0, 0 - 1, 0 - 1);
    assert_eq(_t_wait_state(zt_pid, 90, 1), 1, "... and one that has exited and is not yet collected");
    assert_eq(_agent_cg_in(cg_own, zt_pid), 1, "... is found there too");
    daimon_reap_within(zt_pid, 3000);
    assert_eq(_agent_cg_in(cg_own, 1073741823), 0, "... and a process that does not exist is in none");
}
# The same through a start's own cgroup, where agents are contained.
var zh = agent_handle_new(agent_next_id(), str_from("exits-at-once"));
var zprocs = _agent_cg_prepare(zh);
var zmade = 0;
if (zprocs != 0) { zmade = 1; }
assert_eq(zmade, cg_want, "containment: a start gets a cgroup exactly when daimon can make them");
var zc_t, zc_pid = _agent_spawn("/bin/true", true_argv, 0, 0, 0, 0 - 1, 0 - 1, zprocs);
assert_eq(_t_wait_state(zc_pid, 90, 1), 1, "... an agent that exits at once");
assert_eq(_agent_cg_confirm(zh, zc_pid), cg_want, "... is found in its cgroup, when it has one");
var zdir = agent_cgroup_dir(zh);
daimon_reap_within(zc_pid, 3000);
_agent_cg_release(zh);
var zgone = 1;
if (zdir != 0) {
    if (is_dir(str_from(zdir)) == 1) { zgone = 0; }
}
assert_eq(zgone, 1, "... and the cgroup is removed once the agent is collected");

# Without cgroup.kill (a kernel before 5.14; here, a plain directory) SIGKILL
# goes to each member in turn.
var slp_argv = alloc(24);
store64(slp_argv, "/bin/sleep");
store64(slp_argv + 8, "30");
store64(slp_argv + 16, 0);
var slp_t, slp_pid = agent_spawn_with_limits("/bin/sleep", slp_argv, 0, 0, 0, 0 - 1, 0 - 1);
assert_eq(is_ok(slp_t), 1, "containment: a process to end");
var slb = str_builder_new();
str_builder_add_int(slb, slp_pid);
str_builder_add_cstr(slb, "\n");
_t_script(fcg, "cgroup.procs", str_data(str_builder_build(slb)));
_agent_cg_signal(fcg, SIGKILL);
assert_eq(daimon_reap_within(slp_pid, 3000), 137, "... SIGKILL reaches each member of cgroup.procs");
xunlink(_t_path(fcg, "cgroup.procs"));
xrmdir(fcg);

# A cgroup queued for removal stays queued while it is not empty.
var dq = _t_path(adir, "drain");
xmkdir_p(dq, 448);
var dq_busy = _t_script(dq, "busy", "x");
# Where agents are contained, cgroups of the agents above may still be queued:
# let them go first (bounded by a stop's grace, 7 s), so the count is this one's.
var dqi = 0;
while (dqi < 700 && agent_cgroups_pending() > 0) {
    agent_cgroups_tick(daimon_now_ms());
    _t_nap_ms(10);
    dqi = dqi + 1;
}
var pend0 = agent_cgroups_pending();
_agent_cg_queue(dq, 0);
agent_cgroups_tick(daimon_now_ms());
assert_eq(agent_cgroups_pending(), pend0 + 1, "containment: a cgroup that is not empty stays queued");
xunlink(dq_busy);
agent_cgroups_tick(daimon_now_ms());
assert_eq(agent_cgroups_pending(), pend0, "... and is removed once it is empty");
assert_eq(is_dir(str_from(dq)), 0, "... from disk");

# A cgroup holding cgroups the agent made inside it cannot be removed. Once
# nothing runs in it or below (cgroup.events), they are removed, deepest first.
var ev = _t_path(adir, "events");
xmkdir_p(ev, 448);
_t_script(ev, "cgroup.events", "populated 1\nfrozen 0\n");
assert_eq(_agent_cg_populated(ev), 1, "containment: a cgroup where something runs is populated");
_t_script(ev, "cgroup.events", "populated 0\nfrozen 0\n");
assert_eq(_agent_cg_populated(ev), 0, "... and one where nothing does is not");
xunlink(_t_path(ev, "cgroup.events"));
assert_eq(_agent_cg_populated(ev), 1, "... and one whose state cannot be read counts as populated");
xrmdir(ev);
var tr = _t_path(adir, "tree");
xmkdir_p(_t_path(_t_path(tr, "a"), "b"), 448);
xmkdir_p(_t_path(tr, "c"), 448);
assert_eq(_agent_cg_remove_tree(tr, 1), 0, "containment: cgroups deeper than the walk goes are left");
assert_eq(is_dir(str_from(_t_path(_t_path(tr, "a"), "b"))), 1, "... all of them");
assert_eq(_agent_cg_remove_tree(tr, AGENT_CG_PRUNE_DEPTH), 1, "... and within it, every one is removed");
assert_eq(is_dir(str_from(tr)), 0, "... the cgroup itself too");
# Where agents are contained, through the queue, on a real cgroup.
var nest_gone = 1;
if (cg_state == 1) {
    var nd = _t_path(_agent_cg_base, "agent-nested");
    sys_mkdir(nd, 493);
    sys_mkdir(_t_path(nd, "made-by-the-agent"), 493);
    _agent_cg_queue(nd, 0);
    agent_cgroups_tick(daimon_now_ms());
    if (is_dir(str_from(nd)) == 1) { nest_gone = 0; }
}
assert_eq(nest_gone, 1, "containment: the queue removes a cgroup with the cgroups made inside it");
assert_eq(agent_cgroups_pending(), pend0, "... and lets it go");
# When the agent's process is collected and nothing runs in its cgroup, the
# cgroups it made inside are removed then, not reported as processes left behind.
var rel_gone = 1;
if (cg_state == 1) {
    var rh = agent_handle_new(agent_next_id(), str_from("nests"));
    _agent_cg_prepare(rh);
    var rd = agent_cgroup_dir(rh);
    sys_mkdir(_t_path(rd, "made-by-the-agent"), 493);
    _agent_cg_release(rh);
    if (is_dir(str_from(rd)) == 1) { rel_gone = 0; }
}
assert_eq(rel_gone, 1, "containment: an agent's cgroup goes when it does, with the empty cgroups it made");
assert_eq(agent_cgroups_pending(), pend0, "... without waiting in the queue");

# The upkeep runs on every tick, and alloc has no free: a tick that allocated
# would grow daimon for as long as it runs. Only the walk allocates, at most
# AGENT_CG_PRUNE_TRIES times for a cgroup it cannot remove (here a plain
# directory holding a file, whose cgroup.events says nothing runs in it).
var st = _t_path(adir, "stuck");
xmkdir_p(st, 448);
var st_ev = _t_script(st, "cgroup.events", "populated 0\n");
_agent_cg_queue(st, 0);
var sti = 0;
while (sti < AGENT_CG_PRUNE_TRIES) {
    agent_cgroups_tick(daimon_now_ms());
    sti = sti + 1;
}
var st_a0 = alloc(8);
sti = 0;
while (sti < 100) {
    agent_cgroups_tick(daimon_now_ms());
    sti = sti + 1;
}
assert_eq(alloc(8) - st_a0 - 8, 0, "containment: past its tries, the queue's upkeep allocates nothing");
xunlink(st_ev);
agent_cgroups_tick(daimon_now_ms());
assert_eq(agent_cgroups_pending(), pend0, "... and the cgroup goes once it can");

# Clean up the fixtures (ready markers carry pids; remove what we know).
xunlink(_t_ready(user_exe, s_pid));
xunlink(_t_ready(user_exe, s2_pid));
xunlink(_t_ready(svc_exe, k_pid));
xunlink(user_exe);
xunlink(svc_exe);
xunlink(sys_exe);
xunlink(runner);
xrmdir(edir);
xrmdir(adir);
agent_set_agents_dir(0);

# exit_group: the program epilogue lib/syscalls prescribes (exit(2) ends only
# the calling thread).
syscall(SYS_EXIT_GROUP, assert_summary());
