# daimon.bcyr — daimon benchmarks, against THE REAL src/ modules (2.2.3)
#
# Run: cyrius bench tests/daimon.bcyr        (scripts/bench-history.sh appends a run)
#
# ⭐ 2.2.3 — NO MIRRORS. Until 2.2.3 this file benchmarked simplified local copies
# of the functions it named. 2.2.1 showed the consequence with `cmp`: the bench
# binary was BYTE-IDENTICAL before and after that release, i.e. it could not
# observe any change to daimon's source. Some copies did different work from the
# code they were named after:
#   vector_insert_100x128d   filled arrays and pushed them to a vec — never
#                            vindex_insert
#   vector_search_1k_64d     scored and kept the max — the real search also RANKS
#   scheduler_100_tasks      counted fake structs in a map — not samay at all
#   supervisor_register_1000 one map_set per agent — the real call fills three
#   mcp_manifest_100_tools   insertion-SORTED the keys, which the manifest never
#                            does, and built no JSON, which it always does
#   edge_register_100        a bare map_set — no duplicate-name scan
#   rag_ingest_5k_chars      chunk_text only — now named rag_chunk_5k_chars;
#                            the full ingest is tests/rag_ingest.bcyr
# Every benchmark now calls the shipping function, so numbers from before 2.2.3
# are not comparable for those seven; the CHANGELOG records old vs new.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/fs.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/bayan.cyr"
include "lib/chrono.cyr"
include "lib/fnptr.cyr"
include "lib/bench.cyr"
include "lib/syscalls.cyr"
include "lib/math.cyr"
include "lib/process.cyr"
include "lib/sakshi.cyr"
include "lib/libro.cyr"

include "src/syscalls.cyr"
include "src/error.cyr"
include "lib/sandhi.cyr"
include "src/http.cyr"
include "src/config.cyr"
include "src/audit.cyr"
include "src/secmem.cyr"
include "src/trace.cyr"
include "src/agent.cyr"
include "src/supervisor.cyr"
include "src/sched.cyr"
include "src/vector_store.cyr"
include "src/rag.cyr"
include "src/mcp.cyr"
include "src/edge.cyr"

var _cos_a = 0;
var _cos_b = 0;
var _vindex_1k = 0;
var _cos_query = 0;
var _mcp_reg = 0;
var _edge_fleet_100 = 0;
var _edge_ids_100 = 0;
var _edge_fleet_500 = 0;
var _rag_text = 0;
var _schema_body = 0;

# ================================================================
# Benchmark functions (each called by bench_run)
# ================================================================

fn bench_config_default() { config_new(); return 0; }

fn bench_cosine_128d() {
    cosine_similarity(_cos_a, _cos_b, 128);
    return 0;
}

# 100 inserts of 128-d entries into a fresh index — what an ingest does per chunk.
fn bench_vector_insert_100() {
    var vi = vindex_new();
    var i = 0;
    while (i < 100) {
        var emb = alloc(128 * 8);
        var j = 0;
        while (j < 128) {
            store64(emb + j * 8, f64_from(i * 128 + j));
            j = j + 1;
        }
        vindex_insert(vi, vec_entry_new(i, emb, 128, _rag_text, _rag_text));
        i = i + 1;
    }
    return 0;
}

# Top-5 search over 1,000 64-d entries — /v1/rag/query's default top_k.
fn bench_vector_search_1k() {
    vindex_search(_vindex_1k, _cos_query, 64, 5);
    return 0;
}

fn bench_rag_chunk_5k() {
    chunk_text(_rag_text, 50, 10);
    return 0;
}

# samay: submit 100 tasks of mixed priority, then list the pending queue
# (priority-sorted) — daimon's scheduler since 2.0.0.
fn bench_scheduler_100() {
    var s = task_scheduler_new();
    var i = 0;
    while (i < 100) {
        var t = scheduled_task_new(str_from("task"), str_from("d"), str_from("agent"),
          (i % 10) + 1, resource_req_default());
        task_scheduler_submit_task(s, t);
        i = i + 1;
    }
    return vec_len(task_scheduler_pending_tasks(s));
}

fn bench_supervisor_register_1000() {
    var sup = supervisor_new();
    var i = 0;
    while (i < 1000) {
        supervisor_register(sup, str_from_int(i));
        i = i + 1;
    }
    return 0;
}

fn bench_mcp_register_100() {
    var reg = mcp_registry_new();
    var i = 0;
    while (i < 100) {
        var name = str_cat(str_from("tool-"), str_from_int(i));
        mcp_register_builtin(reg, mcp_tool_new(name, str_from("desc"), 0));
        i = i + 1;
    }
    return 0;
}

# The GET /v1/mcp/tools body for 100 tools, exactly as the route builds it.
fn bench_mcp_manifest_100() {
    mcp_manifest_json(_mcp_reg);
    return 0;
}

fn bench_mcp_find_tool() {
    mcp_find_tool(_mcp_reg, "tool-50");
    return 0;
}

fn bench_mcp_extract_schema() {
    mcp_extract_input_schema(_schema_body);
    return 0;
}

# 100 registrations into a fresh fleet — each one scans the fleet for a
# duplicate name, as POST /v1/edge/nodes does.
fn bench_edge_register_100() {
    var ef = edge_fleet_new(edge_fleet_config_default());
    var i = 0;
    while (i < 100) {
        var name = str_cat(str_from("node-"), str_from_int(i));
        edge_fleet_register(ef, edge_node_new(name, str_from("x86_64"), 4, 4096));
        i = i + 1;
    }
    return 0;
}

fn bench_edge_heartbeat_100() {
    var i = 0;
    while (i < 100) {
        edge_fleet_heartbeat(_edge_fleet_100, vec_get(_edge_ids_100, i), 2, 50);
        i = i + 1;
    }
    return 0;
}

fn bench_edge_stats_500() {
    edge_fleet_stats(_edge_fleet_500);
    return 0;
}

fn bench_cb_cycle() {
    var cb = cb_new(3, 0, 2);
    cb_record_failure(cb);
    cb_record_failure(cb);
    cb_record_failure(cb);
    cb_record_success(cb);
    cb_record_success(cb);
    return 0;
}

# stdlib contract (not a daimon module) — unchanged.
fn bench_hashmap_1000() {
    var m = map_new();
    var i = 0;
    while (i < 1000) {
        var key = str_from_int(i);
        map_set(m, str_data(key), i);
        i = i + 1;
    }
    i = 0;
    while (i < 1000) {
        var key = str_from_int(i);
        map_get(m, str_data(key));
        i = i + 1;
    }
    return 0;
}

# bayan's FLAT parser. daimon read every request body with it until 2.3.2 and no
# longer does; kept as the baseline for http_body_read3 below (same body).
fn bench_json_parse() {
    json_parse(str_from("{\"name\":\"test\",\"port\":\"8090\",\"host\":\"localhost\"}"));
    return 0;
}

# 2.3.2 — how a handler reads its body now: the typed parse, the boundary checks
# (object, no duplicate key, no U+0000) and three field reads, decoded.
fn bench_http_body_read3() {
    var root = http_body_json(str_from("{\"name\":\"test\",\"port\":\"8090\",\"host\":\"localhost\"}"));
    http_json_str(root, "name");
    http_json_int(root, "port");
    http_json_str(root, "host");
    return 0;
}

var _bench_sz_buf = 0;
fn bench_secure_zero() {
    secure_zero(_bench_sz_buf, 4096);
    return 0;
}

var _bench_tid_buf = 0;
fn bench_trace_id_hex() {
    trace_id_hex(305419896, _bench_tid_buf);
    return 0;
}

# 2.3.0 — the agent lifecycle.
var _bench_true_argv = 0;
var _bench_idle_agents = 0;
var _bench_live_agent = 0;

# One agent start as POST /v1/agents/{id}/start runs it — fork, the child's
# descriptor / stdin / SIGPIPE / limit setup, exec of /bin/true, the parent's
# wait for the exec report — plus the reap of the exited child.
fn bench_agent_spawn_reap() {
    var r_t, r_v = agent_spawn_with_limits("/bin/true", _bench_true_argv, 0, 0, 0);
    if (is_ok(r_t) == 1) { daimon_reap_within(r_v, 5000); }
    return 0;
}

# The reap sweep every agent route now runs first, over 100 agents with no
# process — the common case, a load and a compare each.
fn bench_agent_reap_sweep_100_idle() {
    var i = 0;
    while (i < 100) {
        agent_reap(vec_get(_bench_idle_agents, i));
        i = i + 1;
    }
    return 0;
}

# The sweep's cost for each RUNNING agent: one non-blocking waitpid.
fn bench_agent_reap_live() {
    agent_reap(_bench_live_agent);
    return 0;
}

# 2.3.1 — task start + complete, the work of POST .../start and .../complete:
# lookup, SCHEDULED -> RUNNING with started_at, RUNNING -> COMPLETED with the
# node's capacity returned. The task is then put back as schedule_pending
# leaves a placed task (three stores and a reserve, included in the time), so
# every iteration measures the same work.
var _bench_sched = 0;
var _bench_node = 0;
var _bench_task = 0;
fn bench_sched_start_complete() {
    var id = ScheduledTask_task_id(_bench_task);
    sched_task_start(_bench_sched, id);
    sched_task_complete(_bench_sched, id, TASK_COMPLETED, 0);
    ScheduledTask_set_status(_bench_task, TASK_SCHEDULED);
    node_capacity_reserve(_bench_node, ScheduledTask_resource_requirements(_bench_task));
    ScheduledTask_set_reserved_on(_bench_task, NodeCapacity_node_id(_bench_node));
    return 0;
}

# ================================================================
# Main
# ================================================================

fn main() {
    alloc_init();
    # The real circuit breaker logs a WARN each time it opens, and samay logs
    # every task it cannot place; 100,000 log lines would time the logger.
    sakshi_set_level(SK_ERROR);
    daimon_audit_init();

    _cos_a = alloc(128 * 8);
    _cos_b = alloc(128 * 8);
    var i = 0;
    while (i < 128) {
        store64(_cos_a + i * 8, f64_from(i));
        store64(_cos_b + i * 8, f64_from(128 - i));
        i = i + 1;
    }

    # 1,000 64-d entries, the same values the old copy used.
    _vindex_1k = vindex_new();
    i = 0;
    while (i < 1000) {
        var emb = alloc(64 * 8);
        var j = 0;
        while (j < 64) {
            store64(emb + j * 8, f64_from(i * 64 + j));
            j = j + 1;
        }
        vindex_insert(_vindex_1k, vec_entry_new(i, emb, 64, str_from("c"), str_from("m")));
        i = i + 1;
    }
    _cos_query = alloc(64 * 8);
    i = 0;
    while (i < 64) {
        store64(_cos_query + i * 8, f64_from(64 - i));
        i = i + 1;
    }

    _mcp_reg = mcp_registry_new();
    i = 0;
    while (i < 100) {
        var name = str_cat(str_from("tool-"), str_from_int(i));
        mcp_register_builtin(_mcp_reg, mcp_tool_new(name, str_from("desc"), 0));
        i = i + 1;
    }

    _edge_fleet_100 = edge_fleet_new(edge_fleet_config_default());
    _edge_ids_100 = vec_new();
    i = 0;
    while (i < 100) {
        var en = edge_node_new(str_cat(str_from("hb-"), str_from_int(i)), str_from("x86_64"), 4, 4096);
        edge_fleet_register(_edge_fleet_100, en);
        vec_push(_edge_ids_100, str_cstr(edge_node_id(en)));
        i = i + 1;
    }
    _edge_fleet_500 = edge_fleet_new(edge_fleet_config_default());
    i = 0;
    while (i < 500) {
        edge_fleet_register(_edge_fleet_500,
          edge_node_new(str_cat(str_from("st-"), str_from_int(i)), str_from("x86_64"), 4, 4096));
        i = i + 1;
    }

    var rag_sb = str_builder_new();
    i = 0;
    while (i < 100) {
        str_builder_add_cstr(rag_sb, "The quick brown fox jumps over the lazy dog. ");
        i = i + 1;
    }
    _rag_text = str_builder_build(rag_sb);

    var head = str_from("{\"name\":\"echo\",\"callback_url\":\"http://127.0.0.1:9000\",\"inputSchema\":");
    var sj_a = str_from("{\"type\":\"object\",\"properties\":{\"text\":");
    var sj_b = str_from("{\"type\":\"string\"}},\"required\":[\"text\"]}}");
    _schema_body = str_cat(head, str_cat(sj_a, sj_b));

    _bench_sz_buf = alloc(4096);
    _bench_tid_buf = alloc(17);

    var benches = vec_new();

    var b1 = bench_new("config_default");
    bench_run(b1, &bench_config_default, 10000);
    vec_push(benches, b1);

    var b2 = bench_new("cosine_128d");
    bench_run(b2, &bench_cosine_128d, 10000);
    vec_push(benches, b2);

    var b3 = bench_new("vector_insert_100x128d");
    bench_run(b3, &bench_vector_insert_100, 100);
    vec_push(benches, b3);

    var b4 = bench_new("vector_search_1k_64d");
    bench_run(b4, &bench_vector_search_1k, 100);
    vec_push(benches, b4);

    var b5 = bench_new("rag_chunk_5k_chars");
    bench_run(b5, &bench_rag_chunk_5k, 1000);
    vec_push(benches, b5);

    var b6 = bench_new("scheduler_100_tasks");
    bench_run(b6, &bench_scheduler_100, 100);
    vec_push(benches, b6);

    var b7 = bench_new("supervisor_register_1000");
    bench_run(b7, &bench_supervisor_register_1000, 10);
    vec_push(benches, b7);

    var b8 = bench_new("mcp_register_100_tools");
    bench_run(b8, &bench_mcp_register_100, 100);
    vec_push(benches, b8);

    var b9 = bench_new("mcp_manifest_100_tools");
    bench_run(b9, &bench_mcp_manifest_100, 1000);
    vec_push(benches, b9);

    var b10 = bench_new("mcp_find_tool_in_100");
    bench_run(b10, &bench_mcp_find_tool, 100000);
    vec_push(benches, b10);

    var b10b = bench_new("mcp_extract_input_schema");
    bench_run(b10b, &bench_mcp_extract_schema, 10000);
    vec_push(benches, b10b);

    var b11 = bench_new("edge_register_100");
    bench_run(b11, &bench_edge_register_100, 100);
    vec_push(benches, b11);

    var b12 = bench_new("edge_heartbeat_100");
    bench_run(b12, &bench_edge_heartbeat_100, 1000);
    vec_push(benches, b12);

    var b13 = bench_new("edge_stats_500");
    bench_run(b13, &bench_edge_stats_500, 1000);
    vec_push(benches, b13);

    var b14 = bench_new("circuit_breaker_cycle");
    bench_run(b14, &bench_cb_cycle, 100000);
    vec_push(benches, b14);

    var b15 = bench_new("hashmap_1000_insert_lookup");
    bench_run(b15, &bench_hashmap_1000, 100);
    vec_push(benches, b15);

    var b16 = bench_new("json_parse");
    bench_run(b16, &bench_json_parse, 10000);
    vec_push(benches, b16);

    var b17 = bench_new("secure_zero_4k");
    bench_run(b17, &bench_secure_zero, 100000);
    vec_push(benches, b17);

    var b18 = bench_new("trace_id_hex");
    bench_run(b18, &bench_trace_id_hex, 100000);
    vec_push(benches, b18);

    # 2.3.0 — agent lifecycle fixtures: 100 agents with no process, and one
    # whose process is a real, running `sleep`.
    _bench_true_argv = alloc(16);
    store64(_bench_true_argv, "/bin/true");
    store64(_bench_true_argv + 8, 0);
    _bench_idle_agents = vec_new();
    var ai = 0;
    while (ai < 100) {
        vec_push(_bench_idle_agents, agent_handle_new(ai + 1, str_from("idle")));
        ai = ai + 1;
    }
    var sl_argv = alloc(24);
    store64(sl_argv, "/bin/sleep");
    store64(sl_argv + 8, "600");
    store64(sl_argv + 16, 0);
    var sl_t, sl_pid = agent_spawn_with_limits("/bin/sleep", sl_argv, 0, 0, 0);
    _bench_live_agent = agent_handle_new(1000, str_from("live"));
    agent_set_pid(_bench_live_agent, sl_pid);
    agent_set_status(_bench_live_agent, AGENT_RUNNING);

    var b19 = bench_new("agent_spawn_reap");
    bench_run(b19, &bench_agent_spawn_reap, 200);
    vec_push(benches, b19);

    var b20 = bench_new("agent_reap_sweep_100_idle");
    bench_run(b20, &bench_agent_reap_sweep_100_idle, 100000);
    vec_push(benches, b20);

    var b21 = bench_new("agent_reap_live");
    bench_run(b21, &bench_agent_reap_live, 100000);
    vec_push(benches, b21);

    daimon_signal(sl_pid, SIGKILL);
    daimon_reap_within(sl_pid, 1000);

    # 2.3.1 — one placed task on a node with room for it.
    _bench_sched = task_scheduler_new();
    _bench_node = node_capacity_new(str_from("bench-n1"), f64_from(64), 1048576, 1048576, 0);
    task_scheduler_register_node(_bench_sched, _bench_node);
    _bench_task = scheduled_task_new(str_from("bench"), str_from("d"), str_from("agent-1"), 5,
      resource_req_default());
    task_scheduler_submit_task(_bench_sched, _bench_task);
    task_scheduler_schedule_pending(_bench_sched);

    var b22 = bench_new("sched_start_complete");
    bench_run(b22, &bench_sched_start_complete, 100000);
    vec_push(benches, b22);

    var b23 = bench_new("http_body_read3");
    bench_run(b23, &bench_http_body_read3, 10000);
    vec_push(benches, b23);

    bench_report_all(benches);
    return 0;
}

var r = main();
syscall(SYS_EXIT, r);
