# daimon.tcyr — cross-cutting checks: the error module, jget, samay, and the
# stdlib contracts daimon relies on (hashmap, flat JSON).
#
# Run: cyrius test tests/daimon.tcyr
#
# ⭐ 2.2.3 — NO MIRRORS. Until the 2.2.x test-integrity arc, this file carried
# simplified local COPIES of the functions it claimed to test, so a green run
# said nothing about daimon's shipping source — two security defects shipped
# green that way. Every copied module now has its own suite that includes the
# real src/ file, and each move found something the copy had hidden:
#
#   module(s)                 suite                  found on its first real run
#   agent                     agent.tcyr       2.2.0 read_vm_rss always 0; count_fds and
#                                                    count_threads always 0 and 1 (see below)
#   error                     (here)           2.2.1 the copied enum had DRIFTED; error_json
#                                                    let a quote inject fields
#   supervisor                supervisor.tcyr  2.2.1 registry keyed by borrowed pointers
#   ipc                       ipc.tcyr         2.2.1 borrowed keys; unregister by pointer
#                                              2.2.3 agent_ipc_new crashed; bind made a
#                                                    directory at the socket path
#   http                      http.tcyr        2.2.2 unknown verbs were served as GET
#   config                    config.tcyr      2.2.3 —
#   memory + secmem           memory.tcyr      2.2.3 the store killed the process on its
#                                                    first call; traversal; truncation
#   vector_store + rag        rag.tcyr         2.2.3 a query of another dimension read past
#                                                    every embedding
#   mcp                       mcp.tcyr         2.2.3 an external tool could hijack a builtin
#   screen                    screen.tcyr      2.2.3 borrowed agent ids and map keys
#   trace                     trace.tcyr       2.2.3 malformed trace headers half-adopted
#   edge                      edge.tcyr        2.2.3 the health checker had no caller
#   federation + fed_v_store  federation.tcyr  2.2.3 borrowed name, ids and keys
#
# ⛔ One correction to the 2.2.0 row: that release recorded count_fds reading 0
# as a stdlib procfs gap ("KNOWN GAP"). It was daimon passing a raw pointer
# where dir_list takes a Str; tests/agent.tcyr pins the real diagnosis.

include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/alloc.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/bayan.cyr"
include "lib/chrono.cyr"
include "lib/syscalls.cyr"
include "lib/assert.cyr"
include "lib/math.cyr"

# The REAL error module (2.2.1). The copy it replaced had DRIFTED: its enum
# ended `DAIMON_ERR_IO = 10`, a code src/ never defines, while the real code 10
# is `DAIMON_ERR_IPC_FAULT` — which no test had ever touched.
include "src/error.cyr"

fn main() {
    alloc_init();

    # =============================================================
    # error — status mapping
    # =============================================================
    test_group("error");
    assert_eq(error_to_status(DAIMON_ERR_INVALID_PARAM), 400, "invalid_param -> 400");
    assert_eq(error_to_status(DAIMON_ERR_AGENT_NOT_FOUND), 404, "not_found -> 404");
    assert_eq(error_to_status(DAIMON_ERR_AGENT_EXISTS), 409, "exists -> 409");
    assert_eq(error_to_status(DAIMON_ERR_SUPERVISOR), 500, "supervisor -> 500");
    assert_eq(error_to_status(DAIMON_ERR_IPC), 500, "ipc -> 500");
    assert_eq(error_to_status(DAIMON_ERR_SCHEDULER), 500, "scheduler -> 500");
    assert_eq(error_to_status(DAIMON_ERR_FEDERATION), 500, "federation -> 500");
    assert_eq(error_to_status(DAIMON_ERR_API), 500, "api -> 500");
    assert_eq(error_to_status(DAIMON_ERR_STORAGE), 500, "storage -> 500");
    assert_eq(DAIMON_ERR_IPC_FAULT, 10, "IPC_FAULT is code 10");
    assert_eq(error_to_status(DAIMON_ERR_IPC_FAULT), 500, "ipc_fault -> 500");
    assert_eq(error_to_status(99999), 500, "unknown code falls through to 500");

    # error_json — the one fn in src/error.cyr the old copy never had.
    assert(str_eq(error_json(404, str_from("agent not found")),
        str_from("{\"error\":\"agent not found\",\"code\":404}")) == 1,
      "error_json renders a plain message exactly");
    # ⛔ A quote in msg must not close the string. Before 2.2.1 this produced
    # {"error":"x","admin":true,"y":"","code":400} — two injected fields.
    var inj = error_json(400, str_from("x\",\"admin\":true,\"y\":\""));
    assert(str_contains(inj, str_from("\"admin\":true")) == 0,
      "error_json: a quote in msg cannot inject a field");
    assert(str_contains(inj, str_from("\\\"admin\\\"")) == 1,
      "error_json: the quotes arrive escaped as \\\"");
    var bs = error_json(400, str_from("a\\b"));
    assert(str_contains(bs, str_from("a\\\\b")) == 1,
      "error_json: a backslash in msg arrives escaped");

    # json_escape_str is also what /v1/rag/query escapes its context with since
    # 2.2.3. No control byte may leave it raw: RFC 8259 forbids them inside a
    # string, and a strict parser rejects the whole response.
    var cbuf = alloc(8);
    memcpy(cbuf, "a b c d", 7);
    store8(cbuf + 1, 9);    # TAB
    store8(cbuf + 3, 10);   # LF
    store8(cbuf + 5, 1);    # SOH
    var ctl = json_escape_str(str_new(cbuf, 7));
    assert(str_contains(ctl, str_from("\\t")) == 1, "json_escape_str escapes a tab");
    assert(str_contains(ctl, str_from("\\n")) == 1, "json_escape_str escapes a newline");
    var ctl_ok = 1;
    var ci = 0;
    while (ci < str_len(ctl)) {
        if (load8(str_data(ctl) + ci) < 32) { ctl_ok = 0; }
        ci = ci + 1;
    }
    assert_eq(ctl_ok, 1, "json_escape_str leaves no raw control byte in its output");

    # =============================================================
    # hashmap — the stdlib contract daimon's registries rely on
    # =============================================================
    test_group("hashmap");
    var m = map_new();
    map_set(m, "alpha", 1);
    map_set(m, "beta", 2);
    map_set(m, "gamma", 3);
    assert_eq(map_count(m), 3, "count 3");
    assert_eq(map_get(m, "alpha"), 1, "get alpha");
    assert_eq(map_get(m, "beta"), 2, "get beta");
    assert_eq(map_get(m, "gamma"), 3, "get gamma");
    assert_eq(map_get(m, "missing"), 0, "get missing");
    map_delete(m, "beta");
    assert_eq(map_count(m), 2, "count after delete");
    assert_eq(map_get(m, "beta"), 0, "beta gone");
    assert_eq(map_get(m, "alpha"), 1, "alpha still there");
    map_set(m, "alpha", 100);
    assert_eq(map_get(m, "alpha"), 100, "overwrite alpha");
    assert_eq(map_count(m), 2, "count unchanged after overwrite");

    # =============================================================
    # JSON — the flat parser the api_* handlers use
    # =============================================================
    test_group("json");
    var jpairs = json_parse(str_from("{\"name\":\"test\",\"port\":\"8090\"}"));
    assert(jpairs != 0, "parse ok");
    var jname = json_get(jpairs, str_from("name"));
    assert(jname != 0, "got name");
    assert(str_eq(jname, str_from("test")) == 1, "name is test");
    assert_eq(json_get_int(jpairs, str_from("port")), 8090, "port is 8090");

    # =============================================================
    # jget — cstr-keyed lookup (src/error.cyr)
    # =============================================================
    test_group("jget");
    var jg_pairs = json_parse(str_from("{\"host\":\"localhost\",\"port\":\"9090\"}"));
    var jg_host = jget(jg_pairs, "host");
    assert(jg_host != 0, "jget host found");
    assert(str_eq(jg_host, str_from("localhost")) == 1, "jget host value");
    var jg_port = jget_int(jg_pairs, "port");
    assert_eq(jg_port, 9090, "jget_int port");
    assert_eq(jget(jg_pairs, "missing"), 0, "jget missing returns 0");

    # =============================================================
    # samay — daimon's scheduler IS samay (2.0.0)
    # =============================================================
    test_group("samay_integration");
    var sam_s = task_scheduler_new();
    task_scheduler_register_node(sam_s, node_capacity_new(str_from("w1"), f64_from(8), 16384, 102400, 0));
    var sam_t = scheduled_task_new(str_from("job"), str_from("d"), str_from("a1"), 7, resource_req_default());
    var sam_r_t, sam_r_v = task_scheduler_submit_task(sam_s, sam_t);
    assert(is_ok(sam_r_t) == 1, "samay submit ok");
    var sam_dec = task_scheduler_schedule_pending(sam_s);
    assert_eq(vec_len(sam_dec), 1, "samay scheduled 1 task");
    assert_eq(str_eq_cstr(SchedulingDecision_assigned_node(vec_get(sam_dec, 0)), "w1"), 1, "assigned to w1");
    var sam_st = task_scheduler_stats(sam_s);
    assert_eq(SchedulerStats_total_tasks(sam_st), 1, "samay stats total=1");

    return assert_summary();
}

var r = main();
syscall(SYS_EXIT, r);
