# Fuzz: circuit breaker state machine
# Exercises all state transitions with random success/failure sequences
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/vec.cyr"
include "lib/str.cyr"
include "lib/chrono.cyr"
include "lib/syscalls.cyr"
include "lib/hashmap.cyr"

# ⭐ 2.2.1 — fuzzes THE REAL circuit breaker (src/supervisor.cyr), not a local
# copy. The copy it replaced hardcoded `store64(cb, 0)` for CLOSED and asserted
# `load64(cb) != 1` for OPEN — correct only while CircuitState stays 0/1/2, and
# silently wrong the day it does not. Assertions now name CB_CLOSED / CB_OPEN /
# CB_HALF_OPEN, so a renumbering fails to compile instead of fuzzing a fiction.
include "src/supervisor.cyr"

alloc_init();

alloc_init();

# Test threshold = 1
var cb1 = cb_new(1, 0, 3);
cb_record_failure(cb1);
if (load64(cb1) != CB_OPEN) { syscall(60, 1); }
if (cb_can_execute(cb1) != 1) { syscall(60, 2); }
if (load64(cb1) != CB_HALF_OPEN) { syscall(60, 3); }
cb_record_success(cb1);
cb_record_success(cb1);
cb_record_success(cb1);
if (load64(cb1) != CB_CLOSED) { syscall(60, 4); }

# Test threshold = 5
var cb5 = cb_new(5, 0, 2);
var fi = 0;
while (fi < 5) { cb_record_failure(cb5); fi = fi + 1; }
if (load64(cb5) != CB_OPEN) { syscall(60, 11); }
cb_can_execute(cb5);
if (load64(cb5) != CB_HALF_OPEN) { syscall(60, 12); }
cb_record_success(cb5);
cb_record_success(cb5);
if (load64(cb5) != CB_CLOSED) { syscall(60, 13); }

# Test threshold = 10
var cb10 = cb_new(10, 0, 1);
fi = 0;
while (fi < 10) { cb_record_failure(cb10); fi = fi + 1; }
if (load64(cb10) != CB_OPEN) { syscall(60, 21); }
cb_can_execute(cb10);
cb_record_success(cb10);
if (load64(cb10) != CB_CLOSED) { syscall(60, 22); }

# Rapid alternation
var cb_alt = cb_new(3, 0, 1);
var ai = 0;
while (ai < 200) {
    if (ai % 3 == 0) { cb_record_failure(cb_alt); }
    else { cb_record_success(cb_alt); }
    var s = load64(cb_alt);
    if (s > 2) { syscall(60, 30); }
    ai = ai + 1;
}

syscall(60, 0);
