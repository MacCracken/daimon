# Fuzz: task state machine — THE REAL scheduler (samay), 2.2.3
#
# daimon's scheduler has been samay since 2.0.0, but until 2.2.3 this harness
# fuzzed a local `transition()` it defined itself — a scheduler daimon no longer
# ships — and exited through the x86-only `syscall(60, n)`. It now drives samay's
# scheduled_task_transition on real ScheduledTask values: the original valid
# paths and invalid pairs, the exhaustive 7x7 matrix, then 5,000 random walks and
# a random-operation run against the scheduler itself. The properties:
#   * an accepted transition lands exactly on its target; a refused one leaves
#     the status untouched;
#   * COMPLETED, FAILED and CANCELLED are terminal — nothing leaves them;
#   * the status is always one of the seven states;
#   * the scheduler's stats account for every task it holds.
# 2.3.1: the random-operation run starts and completes tasks through daimon's
# own sched_task_start / sched_task_complete (src/sched.cyr) — the functions
# the new routes call — and checks after EVERY operation that the node's
# reservations are exactly the tasks holding one:
#   * running_tasks = the number of tasks with reserved_on set, and the node's
#     free cpu / memory = its total minus theirs;
#   * a task holding a reservation is SCHEDULED or RUNNING, never terminal;
#   * a RUNNING task has a started_at (samay's stats depend on it);
#   * a refused start / complete leaves the task's status untouched.
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/io.cyr"
include "lib/hashmap.cyr"
include "lib/tagged.cyr"
include "lib/bayan.cyr"
include "lib/math.cyr"
include "lib/chrono.cyr"
include "lib/syscalls.cyr"

include "fuzz/rng.cyr"
include "src/sched.cyr"

alloc_init();
# samay logs every task that cannot be placed at WARN; the random-operation run
# below makes thousands of those on purpose (a 64-core node fills up), and CI
# logs do not need 3.7 MB of them. Errors still print.
sakshi_set_level(SK_ERROR);

fn _task() {
    return scheduled_task_new(str_from("t"), str_from("d"), str_from("a"), 5, resource_req_default());
}
fn _at(status) {
    var t = _task();
    ScheduledTask_set_status(t, status);
    return t;
}
fn _terminal(s) {
    if (s == TASK_COMPLETED) { return 1; }
    if (s == TASK_FAILED) { return 1; }
    if (s == TASK_CANCELLED) { return 1; }
    return 0;
}

# --- fixed paths (carried forward) ---------------------------------------------
var t1 = _task();
if (is_err_result(scheduled_task_transition(t1, TASK_SCHEDULED)) == 1) { sys_exit(1); }
if (is_err_result(scheduled_task_transition(t1, TASK_RUNNING)) == 1) { sys_exit(2); }
if (is_err_result(scheduled_task_transition(t1, TASK_COMPLETED)) == 1) { sys_exit(3); }
var t2 = _task();
if (is_err_result(scheduled_task_transition(t2, TASK_CANCELLED)) == 1) { sys_exit(4); }
var t3 = _task();
scheduled_task_transition(t3, TASK_SCHEDULED);
scheduled_task_transition(t3, TASK_RUNNING);
if (is_err_result(scheduled_task_transition(t3, TASK_PREEMPTED)) == 1) { sys_exit(5); }
if (is_err_result(scheduled_task_transition(t3, TASK_QUEUED)) == 1) { sys_exit(6); }
if (is_err_result(scheduled_task_transition(_at(TASK_RUNNING), TASK_FAILED)) == 1) { sys_exit(7); }
if (is_err_result(scheduled_task_transition(_at(TASK_SCHEDULED), TASK_QUEUED)) == 1) { sys_exit(8); }

var bad = alloc(16 * 8);
store64(bad, TASK_COMPLETED);   store64(bad + 8, TASK_RUNNING);
store64(bad + 16, TASK_COMPLETED); store64(bad + 24, TASK_QUEUED);
store64(bad + 32, TASK_FAILED);    store64(bad + 40, TASK_QUEUED);
store64(bad + 48, TASK_CANCELLED); store64(bad + 56, TASK_QUEUED);
store64(bad + 64, TASK_QUEUED);    store64(bad + 72, TASK_RUNNING);
store64(bad + 80, TASK_QUEUED);    store64(bad + 88, TASK_COMPLETED);
store64(bad + 96, TASK_PREEMPTED); store64(bad + 104, TASK_RUNNING);
store64(bad + 112, TASK_PREEMPTED); store64(bad + 120, TASK_COMPLETED);
var bp = 0;
while (bp < 8) {
    var from = load64(bad + bp * 16);
    if (is_ok(scheduled_task_transition(_at(from), load64(bad + bp * 16 + 8))) == 1) { sys_exit(10 + bp); }
    bp = bp + 1;
}

# --- exhaustive 7x7 ---------------------------------------------------------------
var cases = 0;
var from_s = 0;
while (from_s <= 6) {
    var to_s = 0;
    while (to_s <= 6) {
        var tx = _at(from_s);
        var rt, rv = scheduled_task_transition(tx, to_s);
        if (is_ok(rt) == 1) {
            if (ScheduledTask_status(tx) != to_s) { sys_exit(30); }   # lands on target
            if (_terminal(from_s) == 1) { sys_exit(31); }             # left a terminal state
        } else {
            if (ScheduledTask_status(tx) != from_s) { sys_exit(32); } # refused, untouched
        }
        cases = cases + 1;
        to_s = to_s + 1;
    }
    from_s = from_s + 1;
}

# --- random walks -------------------------------------------------------------------
var NW = 5000;
var w = 0;
while (w < NW) {
    var tw = _task();
    var steps = fz_below(20);
    var st = 0;
    while (st < steps) {
        var before = ScheduledTask_status(tw);
        var rt2, rv2 = scheduled_task_transition(tw, fz_below(7));
        var after = ScheduledTask_status(tw);
        if (after < 0) { sys_exit(40); }
        if (after > 6) { sys_exit(41); }
        if (is_err_result(rt2) == 1) {
            if (after != before) { sys_exit(42); }
        }
        if (_terminal(before) == 1) {
            if (after != before) { sys_exit(43); }
        }
        st = st + 1;
    }
    cases = cases + 1;
    w = w + 1;
}

# --- the scheduler: random operations, stats must account for every task ------------
var s = task_scheduler_new();
task_scheduler_register_node(s, node_capacity_new(str_from("w1"), f64_from(64), 1048576, 1048576, 0));
var ids = vec_new();
var did_cancel = 0;
var did_finish = 0;
var did_start = 0;
var did_refuse = 0;
var NS = 2000;
var o = 0;
while (o < NS) {
    var op = fz_below(5);
    if (op == 0) {
        var nt = _task();
        var sr_t, sr_v = task_scheduler_submit_task(s, nt);
        if (is_ok(sr_t) == 1) { vec_push(ids, sr_v); }
    }
    if (op == 1) { task_scheduler_schedule_pending(s); }
    if (vec_len(ids) > 0) {
        var pick = vec_get(ids, fz_below(vec_len(ids)));
        if (op == 2) {
            if (is_ok(task_scheduler_cancel_task(s, pick)) == 1) { did_cancel = did_cancel + 1; }
        }
        var tk = task_scheduler_get_task(s, pick);
        var before_st = ScheduledTask_status(tk);
        if (op == 4) {
            # Start it the way POST /v1/scheduler/tasks/{id}/start does.
            var st_t, st_v = sched_task_start(s, pick);
            if (is_ok(st_t) == 1) { did_start = did_start + 1; }
            else {
                if (ScheduledTask_status(tk) != before_st) { sys_exit(60); }  # refused, untouched
                did_refuse = did_refuse + 1;
            }
        }
        if (op == 3) {
            # ...and complete it the way .../complete does; now and then with a
            # status complete must refuse.
            var fin = TASK_COMPLETED;
            var roll = fz_below(8);
            if (roll < 4) { fin = TASK_FAILED; }
            if (roll == 7) { fin = TASK_RUNNING; }
            var cp_t, cp_v = sched_task_complete(s, pick, fin, str_from("fuzz"));
            if (is_ok(cp_t) == 1) { did_finish = did_finish + 1; }
            else {
                if (ScheduledTask_status(tk) != before_st) { sys_exit(61); }  # refused, untouched
                if (fin == TASK_RUNNING) { if (cp_v != SCHED_OP_BAD_STATUS) { sys_exit(62); } }
                did_refuse = did_refuse + 1;
            }
        }
    }
    var stt = task_scheduler_stats(s);
    var accounted = SchedulerStats_queued(stt) + SchedulerStats_running(stt)
    + SchedulerStats_completed(stt) + SchedulerStats_failed(stt);
    if (accounted != SchedulerStats_total_tasks(stt)) { sys_exit(50); }

    # Reservation accounting (2.3.1): every default task is 1 cpu / 256 MB.
    var alltk = map_values(TaskScheduler_tasks(s));
    var held = 0;
    var ti = 0;
    while (ti < vec_len(alltk)) {
        var tt = vec_get(alltk, ti);
        var tst = ScheduledTask_status(tt);
        if (ScheduledTask_reserved_on(tt) != 0) {
            held = held + 1;
            if (tst != TASK_SCHEDULED) { if (tst != TASK_RUNNING) { sys_exit(63); } }
        }
        if (tst == TASK_RUNNING) { if (ScheduledTask_started_at(tt) == 0) { sys_exit(64); } }
        ti = ti + 1;
    }
    var w1 = map_get(TaskScheduler_nodes(s), str_from("w1"));
    if (NodeCapacity_running_tasks(w1) != held) { sys_exit(65); }
    if (NodeCapacity_available_memory_mb(w1) != 1048576 - held * 256) { sys_exit(66); }
    if (f64_eq(NodeCapacity_available_cpu(w1), f64_from(64 - held)) != 1) { sys_exit(67); }
    cases = cases + 1;
    o = o + 1;
}

# The run must actually have cancelled and finished tasks, or the stats check
# above held vacuously.
if (did_cancel == 0) { sys_exit(51); }
if (did_finish == 0) { sys_exit(52); }
if (did_start == 0) { sys_exit(53); }
if (did_refuse == 0) { sys_exit(54); }

fz_done("scheduler_fsm", cases);
