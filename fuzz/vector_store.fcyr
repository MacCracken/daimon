# Fuzz: vector store — THE REAL src/vector_store.cyr (2.2.3)
#
# Until 2.2.3 this harness fuzzed a local COPY of cosine_similarity and never
# touched the index at all; its "search ranking" check sorted three hand-made
# vectors with its own loop. It now drives the real module: the original fixed
# cases, then 3,000 generated vector pairs and 300 generated indexes. The
# properties:
#   * cosine is within [-1, 1] (with float slack), symmetric, and 1 for a
#     non-zero vector against itself;
#   * a search returns min(top_k, n) results, ranked 0..k-1 by NON-INCREASING
#     score, each score equal to the cosine of the query and that entry;
#   * a query whose dimension differs from the index's returns nothing — the
#     2.2.3 fix; it used to read past the end of every embedding.
include "lib/alloc.cyr"
include "lib/string.cyr"
include "lib/fmt.cyr"
include "lib/str.cyr"
include "lib/vec.cyr"
include "lib/io.cyr"
include "lib/math.cyr"
include "lib/tagged.cyr"
include "lib/chrono.cyr"
include "lib/syscalls.cyr"

include "src/error.cyr"
include "src/vector_store.cyr"
include "fuzz/rng.cyr"

alloc_init();

var EPS = f64_div(f64_from(1), f64_from(1000000));
fn _abs(x) {
    if (f64_lt(x, f64_from(0)) == 1) { return f64_sub(f64_from(0), x); }
    return x;
}
fn _near(a, b) {
    if (f64_lt(_abs(f64_sub(a, b)), EPS) == 1) { return 1; }
    return 0;
}

# A random vector of `dim` components in [-100, 100] (all-zero is possible).
fn _rand_vec(dim) {
    var v = alloc(dim * 8);
    var i = 0;
    while (i < dim) {
        store64(v + i * 8, f64_from(fz_below(201) - 100));
        i = i + 1;
    }
    return v;
}
fn _nonzero(v, dim) {
    var i = 0;
    while (i < dim) {
        if (f64_eq(load64(v + i * 8), f64_from(0)) == 0) { return 1; }
        i = i + 1;
    }
    return 0;
}

# --- fixed cases (carried forward) -------------------------------------------
var dim = 64;
var v = alloc(dim * 8);
var i = 0;
while (i < dim) { store64(v + i * 8, f64_from(i + 1)); i = i + 1; }
if (_near(cosine_similarity(v, v, dim), f64_from(1)) == 0) { sys_exit(1); }
var a = alloc(16);
var b = alloc(16);
store64(a, f64_from(1));
store64(a + 8, f64_from(0));
store64(b, f64_from(0));
store64(b + 8, f64_from(1));
if (_near(cosine_similarity(a, b, 2), f64_from(0)) == 0) { sys_exit(2); }
store64(b, f64_from(0 - 1));
store64(b + 8, f64_from(0));
if (_near(cosine_similarity(a, b, 2), f64_from(0 - 1)) == 0) { sys_exit(3); }
if (cosine_similarity(a, b, 0) != 0) { sys_exit(4); }
var z = alloc(16);
store64(z, f64_from(0));
store64(z + 8, f64_from(0));
if (cosine_similarity(z, a, 2) != f64_from(0)) { sys_exit(5); }

# --- generated vector pairs -----------------------------------------------------
var ONE_UP = f64_add(f64_from(1), EPS);
var ONE_DOWN = f64_sub(f64_from(0 - 1), EPS);
var NP = 3000;
var n = 0;
while (n < NP) {
    var d = 1 + fz_below(64);
    var x = _rand_vec(d);
    var y = _rand_vec(d);
    var cxy = cosine_similarity(x, y, d);
    if (f64_gt(cxy, ONE_UP) == 1) { sys_exit(10); }
    if (f64_lt(cxy, ONE_DOWN) == 1) { sys_exit(11); }
    if (_near(cxy, cosine_similarity(y, x, d)) == 0) { sys_exit(12); }
    if (_nonzero(x, d) == 1) {
        if (_near(cosine_similarity(x, x, d), f64_from(1)) == 0) { sys_exit(13); }
    }
    n = n + 1;
}

# --- generated indexes ------------------------------------------------------------
var NI = 300;
var total = NP;
var m = 0;
while (m < NI) {
    var idim = 1 + fz_below(16);
    var vi = vindex_new();
    var count = fz_below(40);
    var embs = vec_new();          # embeddings by entry id, to re-score results
    var e = 0;
    while (e < count) {
        var emb = _rand_vec(idim);
        vec_push(embs, emb);
        vindex_insert(vi, vec_entry_new(e, emb, idim, str_from("c"), str_from("m")));
        e = e + 1;
    }
    if (vindex_len(vi) != count) { sys_exit(20); }
    var q = _rand_vec(idim);
    var k = fz_below(50);
    var res = vindex_search(vi, q, idim, k);
    var want = k;
    if (count < want) { want = count; }
    if (vec_len(res) != want) { sys_exit(21); }
    var r = 0;
    while (r < vec_len(res)) {
        var sr = vec_get(res, r);
        if (search_result_rank(sr) != r) { sys_exit(22); }
        var rescored = cosine_similarity(q, vec_get(embs, load64(sr)), idim);
        if (_near(search_result_score(sr), rescored) == 0) { sys_exit(25); }
        if (r > 0) {
            if (f64_gt(search_result_score(sr), search_result_score(vec_get(res, r - 1))) == 1) {
                sys_exit(23);                           # ranked out of order
            }
        }
        r = r + 1;
    }
    # A query of any other dimension is refused outright.
    if (count > 0) {
        var wrong = _rand_vec(idim + 1);
        if (vec_len(vindex_search(vi, wrong, idim + 1, 5)) != 0) { sys_exit(24); }
    }
    total = total + 1;
    m = m + 1;
}

fz_done("vector_store", total);
