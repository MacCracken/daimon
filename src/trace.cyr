# =========================================================================
# trace — distributed tracing over sakshi (span stack + 128-bit trace-id)
# =========================================================================
#
# daimon participates in a distributed trace: it adopts an inbound trace id
# (W3C `traceparent` or `X-Trace-Id`), correlates all sakshi spans/events
# under it, spans key operations, and echoes the id back (`X-Trace-Id`) so a
# caller can stitch daimon's spans into its own trace.
#
# sakshi's tracing model is a span stack + a trace id, which is 128-bit since
# sakshi 2.4.4 (sakshi_trace_set_128 / _id_hi / _id_lo). daimon carries the
# FULL W3C trace-id through adoption, the X-Trace-Id echo and the outbound
# `traceparent` it injects on MCP forwards (trace_mcp_forward_method, via
# sandhi_rpc_mcp_call_with_headers).
#
# (Until 2.2.3 this header still listed two LIMITATIONS — "an i64 trace id,
# folded to its low 64 bits" and "no outbound HTTP propagation" — that 1.3.4
# and the header-capable sandhi forward had already removed. Found when the
# module got its first test of its own.)
#
# Opt-in: `daimon serve --trace`. Off by default — per-request span emission
# is noisy for production — and when off every helper is a cheap no-op.

var _trace_enabled = 0;

fn trace_set_enabled(on) { _trace_enabled = on; return 0; }
fn trace_enabled() { return _trace_enabled; }

# Parse up to `n` hex chars at data+off into an i64. Stops at the first
# non-hex char.
fn _trace_parse_hex(data, off, n): i64 {
    var v = 0;
    var i = 0;
    while (i < n) {
        var c = load8(data + off + i);
        var d = 0 - 1;
        if (c >= 48) { if (c <= 57) { d = c - 48; } }    # 0-9
        if (c >= 97) { if (c <= 102) { d = c - 87; } }   # a-f
        if (c >= 65) { if (c <= 70) { d = c - 55; } }    # A-F
        if (d < 0) { return v; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

# Generate a random, non-zero trace id (positive 63-bit).
fn _trace_gen_id(): i64 {
    var b = alloc(8);
    random_bytes(b, 8);
    var id = load64(b);
    if (id < 0) { id = 0 - id; }
    if (id <= 0) { id = clock_now_ns(); }
    return id;
}

# 1 if the `n` bytes at data+off are all hex digits (either case).
fn _trace_all_hex(data, off, n): i64 {
    var i = 0;
    while (i < n) {
        if (_trace_parse_hex(data, off + i, 1) == 0) {
            if (load8(data + off + i) != 48) { return 0; }   # '0' parses to 0 too
        }
        i = i + 1;
    }
    return 1;
}

# 1 if `tp` is a structurally valid W3C traceparent:
#     vv-<32 hex trace-id>-<16 hex parent-id>-<2 hex flags>     (55 bytes)
# with version ff reserved. Hex case is accepted either way.
fn _trace_valid_traceparent(tp): i64 {
    if (strlen(tp) < 55) { return 0; }
    if (load8(tp + 2) != 45) { return 0; }    # '-'
    if (load8(tp + 35) != 45) { return 0; }
    if (load8(tp + 52) != 45) { return 0; }
    if (_trace_all_hex(tp, 0, 2) == 0) { return 0; }
    if (_trace_all_hex(tp, 3, 32) == 0) { return 0; }
    if (_trace_all_hex(tp, 36, 16) == 0) { return 0; }
    if (_trace_all_hex(tp, 53, 2) == 0) { return 0; }
    if (_trace_parse_hex(tp, 0, 2) == 255) { return 0; }   # version ff is invalid
    return 1;
}

# Adopt a trace id from the request headers, or generate a fresh one, and set
# it on sakshi as a full 128-bit id (sakshi 2.4.4+). Priority: W3C `traceparent`
# trace-id (full 128 bits) > `X-Trace-Id` (exactly 32 hex = 128-bit, exactly 16
# hex = 64-bit) > a generated 128-bit random. sandhi_server_find_header returns
# a NUL-terminated cstr (the header value) or 0 — not a Str; use strlen / the
# raw pointer.
#
# ⛔ 2.2.3 — a MALFORMED header is ignored, not partially adopted. The parser
# stops at the first non-hex byte and returns what it has, and the old checks
# were only "at least 35 bytes" (traceparent) and "at least 32" (X-Trace-Id), so
# `00-abc-…` was adopted as trace-id 0xabc plus whatever the low half's offset
# held (tests/trace.tcyr pins it), so two unrelated clients sending the same
# malformed prefix would share one trace id. W3C Trace Context §3.2: a vendor MUST ignore an invalid
# traceparent. An all-zero id is invalid in both headers (the old X-Trace-Id arm
# adopted it, which switched the X-Trace-Id echo off for that request).
fn trace_adopt_or_new(buf, blen): i64 {
    # W3C traceparent: "00-<32hex trace-id>-<16hex span-id>-<2hex flags>".
    # trace-id is chars 3..34: hi 64 bits = chars 3..18, lo = chars 19..34.
    var tp = sandhi_server_find_header(buf, blen, "traceparent");
    if (tp != 0) {
        if (_trace_valid_traceparent(tp) == 1) {
            var hi = _trace_parse_hex(tp, 3, 16);
            var lo = _trace_parse_hex(tp, 19, 16);
            if (hi != 0 || lo != 0) {
                sakshi_trace_set_128(hi, lo);
                return 0;
            }
        }
    }
    var xt = sandhi_server_find_header(buf, blen, "X-Trace-Id");
    if (xt != 0) {
        var xl = strlen(xt);
        if (xl == 32) {
            if (_trace_all_hex(xt, 0, 32) == 1) {
                var xhi = _trace_parse_hex(xt, 0, 16);
                var xlo = _trace_parse_hex(xt, 16, 16);
                if (xhi != 0 || xlo != 0) {
                    sakshi_trace_set_128(xhi, xlo);
                    return 0;
                }
            }
        }
        if (xl == 16) {
            if (_trace_all_hex(xt, 0, 16) == 1) {
                var id2 = _trace_parse_hex(xt, 0, 16);
                if (id2 != 0) { sakshi_trace_set_128(0, id2); return 0; }
            }
        }
    }
    # Generate a full 128-bit random id (daimon-initiated trace).
    sakshi_trace_set_128(_trace_gen_id(), _trace_gen_id());
    return 0;
}

# Begin a request trace: adopt/generate the 128-bit id, set it on sakshi, enter
# the root span. Returns the low 64 bits (0 when tracing is disabled).
fn trace_begin(buf, blen, name, name_len): i64 {
    if (_trace_enabled == 0) { return 0; }
    trace_adopt_or_new(buf, blen);
    sakshi_span_enter(name, name_len);
    return sakshi_trace_id();
}

fn trace_end(): i64 {
    if (_trace_enabled == 0) { return 0; }
    return sakshi_span_exit();
}

# Nested span around a sub-operation (MCP dispatch, agent op). No-op when off.
fn trace_span_enter(name, name_len): i64 {
    if (_trace_enabled == 0) { return 0; }
    return sakshi_span_enter(name, name_len);
}

fn trace_span_exit(): i64 {
    if (_trace_enabled == 0) { return 0; }
    return sakshi_span_exit();
}

# Format an i64 trace id as exactly 16 lowercase hex chars into `buf` (needs
# >= 17 bytes), NUL-terminated. Returns buf. Used for the X-Trace-Id echo.
fn trace_id_hex(id, buf): i64 {
    var i = 0;
    while (i < 16) {
        var shift = (15 - i) * 4;
        var nib = (id >> shift) & 15;
        var c = 48 + nib;             # 0-9
        if (nib >= 10) { c = 87 + nib; }  # a-f
        store8(buf + i, c);
        i = i + 1;
    }
    store8(buf + 16, 0);
    return buf;
}

# Format a full 128-bit trace id as 32 lowercase hex chars into `buf` (needs
# >= 33 bytes), NUL-terminated: hi then lo. Returns buf.
fn trace_id_hex_128(hi, lo, buf): i64 {
    trace_id_hex(hi, buf);        # buf[0..15]  + NUL at buf[16]
    trace_id_hex(lo, buf + 16);   # buf[16..31] + NUL at buf[32] (overwrites buf[16])
    return buf;
}

# Extra-header cstr echoing the active trace id ("X-Trace-Id: <32 hex>\r\n"),
# for the http_send_response `extra_headers` slot — lets a caller stitch
# daimon's spans into its trace. Emits the full 128-bit id. Returns 0 when
# tracing is off or no trace is active (so the common path pays one comparison).
fn trace_response_header(): i64 {
    if (_trace_enabled == 0) { return 0; }
    var hi = sakshi_trace_id_hi();
    var lo = sakshi_trace_id_lo();
    if (hi == 0 && lo == 0) { return 0; }
    var hbuf = alloc(33);
    trace_id_hex_128(hi, lo, hbuf);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "X-Trace-Id: ");
    str_builder_add_cstr(sb, hbuf);
    str_builder_add_cstr(sb, "\r\n");
    # str_cstr (not str_data) — sandhi appends extra_headers as a NUL-terminated
    # cstr; the builder's raw data is not NUL-terminated.
    return str_cstr(str_builder_build(sb));
}

# Outbound propagation: forward an MCP tools/call with a W3C `traceparent`
# header carrying the active 128-bit trace id + a fresh span id, so the
# downstream endpoint joins this trace. Falls back to the plain (headerless)
# call when tracing is off. url_cstr / body_cstr are NUL-terminated cstrs.
fn trace_mcp_forward(url_cstr, body_cstr): i64 {
    return trace_mcp_forward_method(url_cstr, "tools/call", body_cstr);
}

# 2.1.0: the same outbound hop for ANY MCP method. Resources and prompts forward
# through here too ("resources/read", "prompts/get"), so tracing, header
# injection and the sandhi entry points stay single-sourced — the method was
# always a parameter of sandhi_rpc_mcp_call; only this wrapper had hardcoded it.
fn trace_mcp_forward_method(url_cstr, method_cstr, body_cstr): i64 {
    if (_trace_enabled == 0) {
        return sandhi_rpc_mcp_call(url_cstr, method_cstr, body_cstr);
    }
    var hdrs = sandhi_headers_new();
    sandhi_headers_set(hdrs, "traceparent", _trace_build_traceparent());
    return sandhi_rpc_mcp_call_with_headers(url_cstr, method_cstr, body_cstr, hdrs);
}

# Build a W3C traceparent cstr for the active trace: "00-<32hex trace-id>-<16hex
# span-id>-01" (version 00, sampled). A fresh random span-id marks this hop.
fn _trace_build_traceparent(): i64 {
    var tbuf = alloc(33);
    trace_id_hex_128(sakshi_trace_id_hi(), sakshi_trace_id_lo(), tbuf);
    var sbuf = alloc(17);
    trace_id_hex(_trace_gen_id(), sbuf);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "00-");
    str_builder_add_cstr(sb, tbuf);
    str_builder_add_cstr(sb, "-");
    str_builder_add_cstr(sb, sbuf);
    str_builder_add_cstr(sb, "-01");
    return str_cstr(str_builder_build(sb));
}
