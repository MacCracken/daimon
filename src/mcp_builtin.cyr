# =========================================================================
# mcp_builtin — in-process builtin MCP tool dispatch (bote libro tools)
# =========================================================================
#
# Hosts bote's five libro audit-chain tools as daimon MCP builtins:
#   libro_query  libro_verify  libro_export  libro_proof  libro_retention
#
# daimon owns one libro chain (chain_new — libro, via the bote MCP bundle);
# bote's libro_tools handlers (lib/bote-core_bote.cyr, 2.5.0) read / verify / export it after
# libro_tools_init binds it. The five tools are registered in daimon's own
# MCP registry (so /v1/mcp/tools lists them alongside builtins + external
# tools) and dispatched here by calling the bote handlers directly with the
# raw MCP `arguments` object. bote's own dispatcher returns the handler JSON
# verbatim as the tools/call result (dispatch.cyr `resp_success(id, result)`);
# daimon mirrors that convention rather than re-wrapping.
#
# The chain is seeded with one genesis entry at init so verify / export /
# query return real data on a fresh host. Feeding daimon's own audit events
# (agent lifecycle, MCP calls) into the chain is a follow-up once the
# audit-event source is settled (see roadmap v1.3.0 arc).

# Register the five libro tools as builtins + bind bote's libro_tools to
# daimon's audit chain (audit.cyr owns it; daimon_audit_init must run first).
# Call once from app_init after the MCP registry exists.
fn mcp_libro_init(reg) {
    libro_tools_init(daimon_audit_chain());

    var schema = str_from("{\"type\":\"object\"}");
    mcp_register_builtin(reg, mcp_tool_new(str_from("libro_query"),
        str_from("Search the libro audit chain (filter by source/agent/severity/time + paginate)"), schema));
    mcp_register_builtin(reg, mcp_tool_new(str_from("libro_verify"),
        str_from("Verify the libro chain's hash-link integrity"), schema));
    mcp_register_builtin(reg, mcp_tool_new(str_from("libro_export"),
        str_from("Return every entry on the libro chain as a JSON array"), schema));
    mcp_register_builtin(reg, mcp_tool_new(str_from("libro_proof"),
        str_from("Generate a Merkle inclusion proof for the entry at the given index"), schema));
    mcp_register_builtin(reg, mcp_tool_new(str_from("libro_retention"),
        str_from("Apply a retention policy to the libro chain, archive old entries"), schema));
    return 0;
}

# ⛔ libro_retention IS DENIED BY DEFAULT (2.5.1), as nein's mutating tools are.
# It archives entries off daimon's audit chain, and `POST /v1/mcp/call` has no
# caller authentication: measured on 2.5.0, one local call with
# {"policy":"keep_count","value":0} answered "archived":2,"retained":0, and
# libro_export then had no entries. Whoever can reach the API could erase the
# record of what they did with it. It stays registered, so the manifest still
# lists it, and answers nein's refusal, audited `libro.retention.deny`, until
# daimon has caller identity (roadmap 2.6.x). The other four libro tools read.
#
# Flipping `_libro_retention_enabled` to 1 re-opens it; it is there for an
# operator on a trusted single-tenant host to choose, as `_nein_admin_enabled`.
var _libro_retention_enabled = 0;

fn _mcp_libro_retention(args) {
    if (_libro_retention_enabled == 1) { return libro_tool_retention(args, 0); }
    daimon_audit(SEV_SECURITY, "mcp", "libro.retention.deny",
      "libro_retention denied: it archives audit entries, and daimon has no MCP caller authentication");
    return nein_mcp_err("access denied: tool gated by host policy");
}

# mcp_web_init: register bote's web tools (web_fetch / web_search) as builtin MCP tools. web_search targets
# the SearXNG instance at BOTE_SEARXNG_URL (unset -> the tool reports it, never faked). The handlers live in
# bote (lib/bote-core_bote.cyr, 2.5.0); daimon only hosts + dispatches them. Call from app_init after the
# registry exists.
fn mcp_web_init(reg) {
    var schema = str_from("{\"type\":\"object\"}");
    mcp_register_builtin(reg, mcp_tool_new(str_from("web_fetch"),
        str_from("Fetch a web page and return its readable text; args {url} (http/https only)"), schema));
    mcp_register_builtin(reg, mcp_tool_new(str_from("web_search"),
        str_from("Search the web via SearXNG and return the top results; args {query, count?}"), schema));
    return 0;
}

# 1 for a builtin whose answer waits on the network (bote's web tools), which
# api_mcp_call runs in a detached child (server_detach, 2.3.4) rather than on
# daimon's loop. The libro and nein tools answer from memory.
fn mcp_builtin_waits(name_c) {
    if (streq(name_c, "web_fetch") == 1) { return 1; }
    if (streq(name_c, "web_search") == 1) { return 1; }
    return 0;
}

# Dispatch a builtin tool in-process. name_c: tool name (cstr). args: the raw
# MCP `arguments` object (cstr). Returns the handler's JSON result (cstr), or
# 0 if name_c is not a known builtin (the caller falls back to 501).
fn mcp_dispatch_builtin(name_c, args) {
    if (streq(name_c, "libro_query") == 1) { return libro_tool_query(args, 0); }
    if (streq(name_c, "libro_verify") == 1) { return libro_tool_verify(args, 0); }
    if (streq(name_c, "libro_export") == 1) { return libro_tool_export(args, 0); }
    if (streq(name_c, "libro_proof") == 1) { return libro_tool_proof(args, 0); }
    if (streq(name_c, "libro_retention") == 1) { return _mcp_libro_retention(args); }
    if (streq(name_c, "web_fetch") == 1) { return web_fetch_handler(args, 0); }
    if (streq(name_c, "web_search") == 1) { return web_search_handler(args, 0); }
    # nein firewall tools. The gate runs inside nein_mcp_dispatch; claims is
    # bote's reserved 0 (3.x ABI) and the seam lights up when it populates.
    if (is_nein_tool(name_c) == 1) { return nein_mcp_dispatch(name_c, args, 0); }
    return 0;
}

# =========================================================================
# nein — firewall MCP tools (2.1.8)
# =========================================================================
#
# nein owns no transport. It exports six flat-arg tools, a tool table and a
# dispatch-by-name adapter; daimon supplies the registry, the transport and the
# access gate. Wired per nein's own docs/guides/mcp-host-integration.md
# §"Path B — dispatch by name (recommended for daimon)", which is written
# against these exact daimon functions.
#
# ⛔ THE MUTATING TOOLS ARE DENIED BY DEFAULT, AND THAT IS NOT A PLACEHOLDER.
# `nein_allow` / `nein_deny` APPLY LIVE FIREWALL RULES, and `POST /v1/mcp/call`
# has NO caller authentication — it dispatches on a tool name taken from the
# request body. bote's `claims` argument, the seam an identity would arrive
# through, is a reserved 0 in the 3.x ABI, so there is nothing to authorise
# against yet. Registering live firewall mutation on an unauthenticated endpoint
# would be a remote root-equivalent hole, strictly worse than the SSRF and
# rate-limiter defects this project has already fixed.
#
# The gate therefore fails CLOSED until daimon has caller identity (roadmap):
# it permits only what nein classifies as NEIN_TOOL_OFFLINE (nein_validate,
# which touches nothing outside the process). nein classifies; daimon
# hardcodes no tool name.
#
# ⛔ THE LIVE READERS ARE DENIED TOO, since 2.5.2. nein_status / nein_list /
# nein_diff (NEIN_TOOL_READS_LIVE) run `nft list ruleset` as root and return the
# live ruleset, set elements, allowed sources and comments included, to whoever
# calls. 2.1.8 – 2.5.1 permitted them as "read-only" (nein_tool_read_only). nein
# 1.9.0's migration guide says to permit them only to callers allowed to see the
# ruleset, and daimon cannot tell callers apart. (They also wait on `nft` on the
# loop, for up to 60 s since nein 1.8.2: mcp_builtin_waits does not detach them.)
#
# Flipping `_nein_admin_enabled` (the mutating pair) or `_nein_live_reads_enabled`
# (the live readers) to 1 before authentication is wired re-opens exactly the
# exposure above. They exist so an operator on a trusted single-tenant host can
# make that choice deliberately, not by default.
#
# ⚠ On agnos the tools ARE registered and return a specific refusal — nein 1.6.12
# fails closed there with "nftables backend unavailable on agnos", because agnos
# has its own network stack and no nft binary. A diagnosable error beats a tool
# that silently vanishes from the manifest on one target.
var _nein_admin_enabled = 0;
var _nein_live_reads_enabled = 0;

# gate_fp contract (nein 1.9.0): fn(tool_name: cstring, claims: i64) ->
# NEIN_GATE_PERMIT to permit; any other answer denies. nein calls this BEFORE a
# tool acts and returns an "access denied" envelope on a denial, never touching
# the firewall. Through nein 1.8 the permit was 1, which 1.9.0 reads as a denial:
# on 2.5.2's first build every nein tool, nein_validate included, was refused.
fn daimon_nein_gate(tool_name_c, claims) {
    var cls = nein_tool_class(nein_tool_index(tool_name_c));
    if (cls == NEIN_TOOL_OFFLINE) { return NEIN_GATE_PERMIT; }
    if (cls == NEIN_TOOL_READS_LIVE) {
        if (_nein_live_reads_enabled == 1) { return NEIN_GATE_PERMIT; }
        daimon_audit(SEV_SECURITY, "mcp", "nein.gate.deny",
          "nein tool that reads the live firewall denied — daimon has no MCP caller authentication");
        return 0;
    }
    if (cls == NEIN_TOOL_MUTATES) {
        if (_nein_admin_enabled == 1) { return NEIN_GATE_PERMIT; }
        daimon_audit(SEV_SECURITY, "mcp", "nein.gate.deny",
          "mutating nein firewall tool denied — daimon has no MCP caller authentication");
        return 0;
    }
    # Unknown name (class 0): deny. A gate that permits what it cannot classify is
    # the wrong default, even though nein_mcp_dispatch answers "unknown nein tool".
    return 0;
}

# Register nein's six tools, reading descriptors out of nein's own tool table
# rather than restating them here — a restated table is a table that drifts.
# Installs the gate BEFORE any call can be served. Call once from app_init.
fn mcp_nein_init(reg) {
    # nein 1.9.0 answers 1 when it refuses the gate (one gate per process). nein
    # then runs only offline tools, which fails closed; say so.
    if (nein_mcp_set_gate(&daimon_nein_gate) != 0) {
        sakshi_warn("nein refused daimon's gate: only nein_validate will run", 56);
        daimon_audit(SEV_SECURITY, "mcp", "nein.gate.install.fail", "nein refused daimon's tool gate");
    }
    var schema = str_from("{\"type\":\"object\"}");
    var i = 0;
    while (i < nein_tool_count()) {
        mcp_register_builtin(reg, mcp_tool_new(
            str_from(nein_tool_name(i)),
            str_from(nein_tool_desc(i)),
            schema));
        i = i + 1;
    }
    return 0;
}

# Is this a nein tool name? Table lookup, not a "nein_" prefix test, so a future
# daimon tool starting with those characters cannot be swallowed by the routing.
fn is_nein_tool(name_c) {
    var i = 0;
    while (i < nein_tool_count()) {
        if (streq(nein_tool_name(i), name_c) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}
