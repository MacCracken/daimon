# =========================================================================
# http — HTTP constants, JSON escaping (VULN-002), request/response helpers
# =========================================================================

# --- HTTP constants ---

var MAX_REQUEST_SIZE = 65536;
var MAX_HEADER_SIZE = 8192;

# --- JSON escaping (VULN-002) ---

# (json_escape_str moved to src/error.cyr at 2.2.1 — error_json needs it, and error.cyr
#  is included before this file, so every caller here still resolves it.)

# --- HTTP helpers ---

# Sandhi-backed shims. Same signatures as the pre-1.1.4 hand-rolled
# parsers so api_* / http_route call sites stay unchanged. Sandhi
# brings hardening for free: case-insensitive header lookup, strict
# RFC 7230 §3.3.2 Content-Length parsing (rejects "10, 20" CL.CL
# smuggling vector that the old loose parser accepted), and tolerant
# Transfer-Encoding token scan.

# Method codes: 0 GET · 1 POST · 2 PUT · 3 DELETE · -1 anything else.
#
# ⛔ 2.2.2 — an unrecognised verb used to return 0, i.e. it was silently
# treated as GET. OPTIONS, PATCH or a garbage token reached every GET handler.
# The router's 2.1.0 MCP section documented the hazard and guarded ITSELF
# against it; the source was never fixed and no other route was guarded.
# HEAD still maps to GET — it is GET without a body by definition, and
# health-checkers issue it — so it can never reach a state-changing route.
fn http_parse_method(buf, len) {
    var m = sandhi_server_get_method(buf, len);
    if (streq(m, "GET") == 1) { return 0; }
    if (streq(m, "HEAD") == 1) { return 0; }
    if (streq(m, "POST") == 1) { return 1; }
    if (streq(m, "PUT") == 1) { return 2; }
    if (streq(m, "DELETE") == 1) { return 3; }
    return 0 - 1;
}

# Returns path WITHOUT query string. sandhi_server_get_path returns
# the full request-line path-and-query ("/foo?bar=baz");
# sandhi_server_path_only strips at the first '?'.
fn http_parse_path(buf, len) {
    return sandhi_server_path_only(sandhi_server_get_path(buf, len));
}

# VULN-001: 1 if the request carries a Transfer-Encoding header at all
# (daimon does not implement chunked decode and rejects with 501).
# Sandhi additionally rejects CL+TE conflict in its accept-loop with
# 400 before the handler runs (sandhi_server_request_has_cl_te_conflict).
fn http_has_transfer_encoding(buf, len) {
    if (sandhi_server_find_header(buf, len, "Transfer-Encoding") == 0) { return 0; }
    return 1;
}

# 2.3.0: 1 if the request carries an Origin header (any value, including an
# empty one or "null"). Browsers attach Origin to every cross-origin request —
# the text/plain POST that needs no CORS preflight among them — and a page on
# a DNS-rebinding name sends its own. daimon's clients (agents, CLIs, curl)
# send none. sandhi matches the whole header name, case-insensitively.
fn http_has_origin(buf, len) {
    if (sandhi_server_find_header(buf, len, "Origin") == 0) { return 0; }
    return 1;
}

# Query param value, or 0 if absent. URL-decoded by sandhi.
fn http_parse_query_param(buf, len, param_name) {
    return sandhi_server_get_param(sandhi_server_get_path(buf, len), param_name);
}

# Body as a Str struct (data+len), or 0 if no body. Bounded by
# Content-Length when the header is present (VULN-001 — never
# trust raw recv'd bytes past the declared length).
fn http_parse_body(buf, len) {
    var bo = sandhi_server_body_offset(buf, len);
    if (bo < 0) { return 0; }
    var avail = len - bo;
    if (avail <= 0) { return 0; }
    var cl = sandhi_server_content_length(buf, len);
    if (cl > 0 && cl < avail) { avail = cl; }
    return str_new(buf + bo, avail);
}

# --- JSON request bodies (2.3.2) ---
#
# ⛔ Through 2.3.1 almost every handler read its body with json_parse + jget:
# bayan's FLAT parser, whose own contract (bayan_json_parse) says the values
# are the raw source bytes with escapes NOT decoded, and that "a caller who
# needs decoded values should use" the tagged-tree parser. daimon stored the
# raw bytes as if decoded. Measured on the 2.3.1 binary:
#   {"name":"say \"hi\" \\o/ \u00e9"}      -> stored `say \"hi\" \\o/ \u00e9`
#   {"meta":{"x":1,"name":"nested"},"name":"top"}  -> name = nested
#   {"meta":{"x":1},"name":"after"}               -> name absent ("unnamed")
# The flat scan ends an unquoted value at its first `,` or `}`, so a nested
# object's keys surfaced as top-level fields and everything after it vanished —
# a parser differential against any real JSON parser on the same body.
#
# The typed parser decodes every escape (surrogate pairs included), keeps
# nesting, rejects malformed JSON, and returns each string as a FRESH
# allocation — so a decoded field is never a view into the request buffer
# sandhi reuses (the 2.2.x retention-leak class, closed at the source).

# The body as a JSON object, or 0 when it is not an acceptable one:
#   * not JSON, or JSON with trailing content;
#   * not an object at the top;
#   * a DUPLICATE top-level key. RFC 8259 leaves their meaning undefined, and
#     parsers disagree — daimon's lookup takes the first, JSON.parse the last —
#     which is exactly the gap CVE-2017-12635 (CouchDB) turned into admin
#     rights. One body, one meaning;
#   * a top-level string holding U+0000. Every such field ends up as a C
#     string somewhere (registry keys, argv, audit entries), where it would be
#     cut at the NUL and stop matching the value daimon checked.
# Nested values are left alone: daimon reads only top-level fields, and forwards
# nested ones (MCP `arguments`) without interpreting them.
# (The checks are json_object_ok, src/error.cyr, shared with agent channel
# frames since 2.3.3.)
fn http_body_json(body) {
    if (body == 0) { return 0; }
    var root = bayan_json_v_parse(body);
    if (json_object_ok(root) == 0) { return 0; }
    return root;
}

# 400 for a body http_body_json refused.
fn http_bad_body(fd) {
    http_bad_request(fd, str_from("the body must be one JSON object, without duplicate keys or U+0000 in a string"));
    return 0;
}

# 1 if the top-level field is present and not JSON null.
fn http_json_has(root, key) {
    var v = bayan_json_v_obj_get(root, key);
    if (v == 0) { return 0; }
    if (bayan_json_v_is_null(v) == 1) { return 0; }
    return 1;
}

# A top-level string field, decoded — or 0 when it is absent, null, or neither
# a string nor a number. A number is taken as its JSON text ("agent_id": 3 ->
# "3"): the flat reader handed back the raw token, and daimon's own ids are
# numbers, so clients send them unquoted. true / false, objects and arrays are
# not strings.
fn http_json_str(root, key) {
    var v = bayan_json_v_obj_get(root, key);
    if (v == 0) { return 0; }
    if (bayan_json_v_is_str(v) == 1) { return bayan_json_v_str(v); }
    if (bayan_json_v_is_int(v) == 1) { return bayan_json_v_build(v); }
    if (bayan_json_v_is_float(v) == 1) { return bayan_json_v_build(v); }
    return 0;
}

# A top-level integer field; 0 when absent — jget_int's contract. Accepts a JSON
# number (a fraction is truncated), a numeric string as the API always has
# ("7", read the way jget_int read it), and true / false as 1 / 0 (jget_int
# read `true` as 0).
fn http_json_int(root, key) {
    var v = bayan_json_v_obj_get(root, key);
    if (v == 0) { return 0; }
    if (bayan_json_v_is_str(v) == 1) { return str_to_int(bayan_json_v_str(v)); }
    if (bayan_json_v_is_bool(v) == 1) { return bayan_json_v_bool(v); }
    return bayan_json_v_int(v);
}

# A top-level field as text: a string decoded, any other value as compact JSON
# (`{"src":"a"}`, `42`), or 0 when absent or null. For free-form fields such as
# RAG `metadata`, which the Rust original took as any JSON value.
fn http_json_text(root, key) {
    var v = bayan_json_v_obj_get(root, key);
    if (v == 0) { return 0; }
    if (bayan_json_v_is_null(v) == 1) { return 0; }
    if (bayan_json_v_is_str(v) == 1) { return bayan_json_v_str(v); }
    return bayan_json_v_build(v);
}

# Status-code → reason-phrase. Centralized so http_send_response
# (sandhi-backed shim) can hand the right RFC 7231 phrase to
# sandhi_server_send_response. Codes daimon emits today: 200, 201,
# 204, 400, 403, 404, 405, 409, 413, 422, 429, 500, 501, 502.
fn _http_reason(status) {
    if (status == 200) { return "OK"; }
    if (status == 201) { return "Created"; }
    if (status == 204) { return "No Content"; }
    if (status == 400) { return "Bad Request"; }
    if (status == 403) { return "Forbidden"; }
    if (status == 404) { return "Not Found"; }
    if (status == 405) { return "Method Not Allowed"; }
    if (status == 409) { return "Conflict"; }
    if (status == 413) { return "Payload Too Large"; }
    if (status == 422) { return "Unprocessable Entity"; }
    if (status == 429) { return "Too Many Requests"; }
    # 500 was missing: error_to_status maps every non-4xx DaimonError to 500,
    # so those responses went out as "500 Error" rather than the RFC 7231
    # "500 Internal Server Error". Found alongside the 405 work (2.2.2).
    if (status == 500) { return "Internal Server Error"; }
    if (status == 501) { return "Not Implemented"; }
    if (status == 502) { return "Bad Gateway"; }
    return "Error";
}

# Sandhi-backed shim. Same signature as the pre-sandhi version so
# every api_* call site stays unchanged. Always emits
# Content-Type: application/json + Connection: close, matching
# daimon original behaviour.
fn http_send_response(fd, status, body_data, body_len) {
    # extra_headers echoes X-Trace-Id when `serve --trace` is on (else 0).
    sandhi_server_send_response(fd, status, _http_reason(status),
      "application/json", body_data, body_len, trace_response_header());
}

fn http_ok(fd, body) {
    http_send_response(fd, 200, str_data(body), str_len(body));
}

fn http_not_found(fd) {
    var body = str_from("{\"error\":\"not found\"}");
    http_send_response(fd, 404, str_data(body), str_len(body));
}

fn http_method_not_allowed(fd) {
    var body = str_from("{\"error\":\"method not allowed\"}");
    http_send_response(fd, 405, str_data(body), str_len(body));
}

# Route guard: 1 if `method` is `want`, otherwise answers 405 and returns 0.
# Every route in src/router.cyr goes through this or ends its arms in an
# explicit 405 — none may fall through to the next route on a wrong method.
fn route_method(fd, method, want) {
    if (method == want) { return 1; }
    http_method_not_allowed(fd);
    return 0;
}

fn http_bad_request(fd, msg) {
    var body = error_json(400, msg);
    http_send_response(fd, 400, str_data(body), str_len(body));
}

fn http_error(fd, code, msg) {
    var body = error_json(code, msg);
    http_send_response(fd, code, str_data(body), str_len(body));
}

