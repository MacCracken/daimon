# daimon — AGNOS agent orchestrator
# Ported from 9724 lines of Rust
#
# This is the composition entry point: shared preamble (syscall constants) +
# `include`s of the per-domain modules below (split out of the former
# 4.1k-line monolith) + the `main` serve loop. Each module is one src/*.cyr;
# cyrius flattens the includes into one global scope, so module order matches
# the original single-file source order (behavior-preserving split).
#
# Modules (in dependency / include order):
#   error      — error codes and HTTP status mapping
#   config     — service configuration
#   agent      — agent lifecycle, process spawning, /proc helpers
#   supervisor — circuit breaker, output capture, health monitoring, quotas
#   memory     — per-agent key-value store (filesystem-backed)
#   vector_store — in-memory cosine-similarity vector index
#   rag        — text chunking, bag-of-words embedding, retrieval pipeline
#   mcp        — MCP tool registry and dispatch types
#   mcp_pin    — what each tool's definition was at first sight; its store
#   files      — an index of the operator's roots; tags, ratings, smart folders
#   files_search — a question in words, answered with ranked files
#   screen     — capture permissions, rate limiting, recording sessions
#   sched      — task start / complete over samay (the scheduler since 2.0.0)
#   federation — multi-node clustering, Raft-like election, placement
#   edge       — edge fleet management, heartbeats, OTA, GPU inventory
#   ipc        — Unix domain sockets, message bus, RPC
#   app        — global service state + composition root (app_init)
#   http       — HTTP constants, JSON escaping, request/response helpers
#   api        — HTTP REST API route handlers + router (port 8090)
#   server     — rate limiting, per-request dispatch, sync + async serve loops

# Stdlib auto-included via cyrius.toml
include "lib/math.cyr"
include "lib/process.cyr"

# --- daimon modules (dependency order; split out of the former 4.1k-line main) ---
include "src/syscalls.cyr"
include "src/error.cyr"
include "src/config.cyr"
include "src/audit.cyr"
include "src/secmem.cyr"
include "src/trace.cyr"
include "src/agent.cyr"
include "src/supervisor.cyr"
include "src/sched.cyr"
include "src/memory.cyr"
include "src/vector_store.cyr"
include "src/rag.cyr"
include "src/mcp.cyr"
include "src/mcp_pin.cyr"
include "src/mcp_builtin.cyr"
include "src/files.cyr"
include "src/files_search.cyr"
include "src/screen.cyr"
include "src/federation.cyr"
include "src/fed_vector_store.cyr"
include "src/edge.cyr"
include "src/ipc.cyr"
include "src/app.cyr"
include "src/http.cyr"
include "src/api.cyr"
include "src/api_agent.cyr"
include "src/api_mcp.cyr"
include "src/api_files.cyr"
include "src/api_rag.cyr"
include "src/api_edge.cyr"
include "src/api_sched.cyr"
include "src/router.cyr"
include "src/server.cyr"

# =========================================================================
# main — entry point
# =========================================================================

# daimon consumer add|remove NAME [--data-dir DIR] (2.5.5). A token is shown once:
# only its digest is kept. Run by the operator, with no daimon needed: a running one
# reads the file for each use.
fn _main_consumer() {
    if (argc() < 4) {
        println("usage: daimon consumer add|remove NAME [--data-dir DIR]");
        return 1;
    }
    var dir = str_cstr(config_data_dir(_config));
    if (argc() >= 6) {
        if (streq(argv(4), "--data-dir") == 1) { dir = argv(5); }
    }
    var verb = argv(2);
    var name = argv(3);
    if (streq(verb, "add") == 1) {
        var token = mcp_consumer_add(dir, name);
        if (token == 0) {
            println("consumer: not added: a name is a-z 0-9 . _ -, is not taken, and the directory must be writable");
            return 1;
        }
        println(token);
        return 0;
    }
    if (streq(verb, "remove") == 1) {
        if (mcp_consumer_remove(dir, name) == 0) {
            println("consumer: no such consumer");
            return 1;
        }
        return 0;
    }
    println("usage: daimon consumer add|remove NAME [--data-dir DIR]");
    return 1;
}

fn main() {
    # Ignore SIGPIPE process-wide before anything can touch a socket. A write to
    # a peer that closed mid-response otherwise raises SIGPIPE, whose default
    # disposition TERMINATES the process — an unauthenticated remote DoS on any
    # flagsless socket write. The live HTTP path (serve / serve_async) already
    # inherits sandhi's own SIG_IGN, installed at the top of each of its serve
    # loops; this call is the daimon-owned belt-and-braces layer: it (a) uses the
    # 6.4.51 stdlib `signal_ignore`/`Signal` helper directly instead of a raw
    # syscall, (b) covers daimon's OWN flagsless `SYS_WRITE`s to sockets that do
    # not route through sandhi (the ipc.cyr control-socket path), and (c) keeps
    # the guarantee independent of sandhi's internal placement of its guard.
    # Idempotent + no allocator/args dependency (stack buffer + one rt_sigaction),
    # so it is safe as the very first statement. No-op on Windows/agnos.
    signal_ignore(SIGPIPE);

    alloc_init();
    args_init();

    app_init();

    # Parse CLI arguments
    if (argc() >= 2) {
        var cmd = argv(1);
        if (streq(cmd, "serve") == 1) {
            var port = config_port(_config);
            var use_async = 0;
            # Parse remaining args: port number or --async
            var argi = 2;
            while (argi < argc()) {
                var arg = argv(argi);
                if (streq(arg, "--async") == 1) { use_async = 1; }
                elif (streq(arg, "--trace") == 1) { trace_set_enabled(1); }
                elif (streq(arg, "--agents-dir") == 1) {
                    # 2.3.0: the operator's agent-executable directory
                    # (agent_find_executable, src/agent.cyr).
                    argi = argi + 1;
                    if (argi >= argc()) {
                        println("serve: --agents-dir needs a directory");
                        return 1;
                    }
                    agent_set_agents_dir(argv(argi));
                }
                elif (streq(arg, "--data-dir") == 1) {
                    # 2.5.4: where what must outlive a restart is kept.
                    argi = argi + 1;
                    if (argi >= argc()) {
                        println("serve: --data-dir needs a directory");
                        return 1;
                    }
                    config_set_data_dir(_config, str_from(argv(argi)));
                }
                elif (streq(arg, "--index-root") == 1) {
                    # 2.5.4: a directory the file index may cover. None by default:
                    # the API has no caller authentication until roadmap 2.6.x.
                    argi = argi + 1;
                    if (argi >= argc()) {
                        println("serve: --index-root needs a directory");
                        return 1;
                    }
                    if (files_add_root(argv(argi)) == 0) {
                        println("serve: --index-root takes an absolute path with no trailing slash, sixteen at most");
                        return 1;
                    }
                }
                elif (streq(arg, "--index-content") == 1) {
                    # 2.5.5: search reads what files hold, not only their names. Off
                    # apart from --index-root: a local process can then ask whether a
                    # file it could not open holds a word.
                    files_set_content(1);
                }
                elif (streq(arg, "--index-max") == 1) {
                    argi = argi + 1;
                    if (argi >= argc()) {
                        println("serve: --index-max needs a number");
                        return 1;
                    }
                    var im = _fx_int(argv(argi));
                    if ((im < 1024) || (im > 16777216)) {
                        println("serve: --index-max takes a number from 1024 to 16777216");
                        return 1;
                    }
                    files_set_max(im);
                }
                elif (streq(arg, "--tron-policy") == 1) {
                    # 2.5.5: t-ron's policy, the gate on a consumer's accept. With
                    # none, no consumer may accept.
                    argi = argi + 1;
                    if (argi >= argc()) {
                        println("serve: --tron-policy needs a file");
                        return 1;
                    }
                    if (mcp_pin_tron_open(argv(argi)) == 0) {
                        println("serve: t-ron refused that policy file");
                        return 1;
                    }
                }
                elif (streq(arg, "--mcp-pin-accept") == 1) {
                    # 2.5.4: reopens POST /v1/mcp/tools/{name}/accept, which is
                    # refused until callers are identified (roadmap 2.6.x).
                    _mcp_pin_accept_enabled = 1;
                }
                elif (streq(arg, "--agent-output") == 1) {
                    # 2.3.4: agents' stdout and stderr: daimon's own, or captured.
                    argi = argi + 1;
                    if (argi >= argc()) {
                        println("serve: --agent-output needs inherit or capture");
                        return 1;
                    }
                    if (streq(argv(argi), "inherit") == 1) { agent_set_output_mode(AGENT_OUTPUT_INHERIT); }
                    elif (streq(argv(argi), "capture") == 1) {
                        #ifdef CYRIUS_TARGET_AGNOS
                        # 2.4.0: refused, not ignored. spawn_path#43 copies daimon's
                        # whole fd table into each agent (agnos has no close-on-exec),
                        # so every agent would hold every other agent's output pipe;
                        # and exec_redirect#62 redirects one fd, so stderr could not
                        # be captured. Both filed with agnos, 2026-09-23.
                        println("serve: --agent-output capture is not supported on agnos yet");
                        return 1;
                        #endif
                        agent_set_output_mode(AGENT_OUTPUT_CAPTURE);
                    }
                    else {
                        println("serve: --agent-output takes inherit or capture");
                        return 1;
                    }
                }
                elif (streq(arg, "--agent-env") == 1) {
                    # 2.3.4 (VULN-015): what of daimon's environment agents get.
                    argi = argi + 1;
                    if (argi >= argc()) {
                        println("serve: --agent-env needs inherit or minimal");
                        return 1;
                    }
                    if (streq(argv(argi), "inherit") == 1) { agent_set_env_mode(AGENT_ENV_INHERIT); }
                    elif (streq(argv(argi), "minimal") == 1) { agent_set_env_mode(AGENT_ENV_MINIMAL); }
                    else {
                        println("serve: --agent-env takes inherit or minimal");
                        return 1;
                    }
                }
                elif (streq(arg, "--listen") == 1) {
                    # 2.3.0: the bind address (default 127.0.0.1, config.cyr).
                    # An IPv4 literal; 0.0.0.0 opens every interface.
                    argi = argi + 1;
                    if (argi >= argc()) {
                        println("serve: --listen needs an IPv4 address");
                        return 1;
                    }
                    if (sandhi_net_parse_ipv4(argv(argi)) < 0) {
                        println("serve: --listen takes an IPv4 address such as 127.0.0.1 or 0.0.0.0");
                        return 1;
                    }
                    config_set_listen_addr(_config, str_from(argv(argi)));
                }
                else {
                    # Parse as port number
                    port = 0;
                    var pi = 0;
                    while (load8(arg + pi) != 0) {
                        port = port * 10 + load8(arg + pi) - 48;
                        pi = pi + 1;
                    }
                }
                argi = argi + 1;
            }
            if (use_async == 1) { return serve_async(port); }
            return serve(port);
        }
        if (streq(cmd, "consumer") == 1) { return _main_consumer(); }
        if (streq(cmd, "version") == 1) {
            println(daimon_version());
            return 0;
        }
        if (streq(cmd, "help") == 1) {
            println("daimon — AGNOS agent orchestrator");
            println("Usage: daimon <command> [options]");
            println("");
            println("Commands:");
            println("  serve [port] [--async] [--trace] [--agents-dir DIR] [--listen ADDR]");
            println("        [--data-dir DIR] [--mcp-pin-accept] [--tron-policy FILE]");
            println("        [--index-root DIR]... [--index-content] [--index-max N]");
            println("        [--agent-env inherit|minimal] [--agent-output inherit|capture]");
            println("                          Start HTTP API server (default: 127.0.0.1:8090)");
            println("  consumer add|remove NAME [--data-dir DIR]");
            println("                          Issue or revoke a consumer's token (ADR-009)");
            println("  version                 Print version");
            println("  help                    Show this help");
            return 0;
        }
    }

    # Default: start server
    return serve(config_port(_config));
}

var r = main();
# exit_group (2.3.3): once an agent has started, the channel service thread is
# running, and sys_exit — exit(2) — ends only the calling thread. The process
# would stay up with its main thread gone. lib/syscalls says the same.
sys_exit_group(r);
