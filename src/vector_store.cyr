# =========================================================================
# vector_store — in-memory cosine-similarity search
# =========================================================================

# Cosine similarity between two f64 arrays of equal length
fn cosine_similarity(a, b, dim) {
    if (dim == 0) { return 0; }
    var dot = f64_from(0);
    var norm_a = f64_from(0);
    var norm_b = f64_from(0);
    var i = 0;
    while (i < dim) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        dot = f64_add(dot, f64_mul(x, y));
        norm_a = f64_add(norm_a, f64_mul(x, x));
        norm_b = f64_add(norm_b, f64_mul(y, y));
        i = i + 1;
    }
    var denom = f64_mul(f64_sqrt(norm_a), f64_sqrt(norm_b));
    if (f64_eq(denom, f64_from(0)) == 1) { return f64_from(0); }
    return f64_div(dot, denom);
}

# VectorEntry: {id, embedding_ptr, embedding_dim, content: Str, metadata: Str, created_at}
# 6 fields x 8 = 48 bytes

fn vec_entry_new(id, embedding, dim, content, metadata) {
    var ve = alloc(48);
    store64(ve, id);
    store64(ve + 8, embedding);
    store64(ve + 16, dim);
    store64(ve + 24, content);
    store64(ve + 32, metadata);
    store64(ve + 40, clock_epoch_secs());
    return ve;
}

fn vec_entry_id(ve) { return load64(ve); }
fn vec_entry_embedding(ve) { return load64(ve + 8); }
fn vec_entry_dim(ve) { return load64(ve + 16); }
fn vec_entry_content(ve) { return load64(ve + 24); }
fn vec_entry_metadata(ve) { return load64(ve + 32); }

# SearchResult: {id, content: Str, metadata: Str, score (f64), rank}
# 5 fields x 8 = 40 bytes

fn search_result_new(id, content, metadata, score, rank) {
    var sr = alloc(40);
    store64(sr, id);
    store64(sr + 8, content);
    store64(sr + 16, metadata);
    store64(sr + 24, score);
    store64(sr + 32, rank);
    return sr;
}

fn search_result_content(sr) { return load64(sr + 8); }
fn search_result_score(sr) { return load64(sr + 24); }
fn search_result_rank(sr) { return load64(sr + 32); }

# VectorIndex: {entries: vec of VectorEntry, dimension: i64}
# 2 fields x 8 = 16 bytes

fn vindex_new() {
    var vi = alloc(16);
    store64(vi, vec_new());
    store64(vi + 8, 0);  # dimension (0 = not set)
    return vi;
}

fn vindex_len(vi) { return vec_len(load64(vi)); }
fn vindex_dimension(vi) { return load64(vi + 8); }

fn vindex_insert(vi, entry) {
    var dim = vec_entry_dim(entry);
    if (dim == 0) { return Err(DAIMON_ERR_INVALID_PARAM); }

    var idx_dim = load64(vi + 8);
    if (idx_dim == 0) {
        store64(vi + 8, dim);
    }
    elif (idx_dim != dim) {
        return Err(DAIMON_ERR_INVALID_PARAM);
    }

    vec_push(load64(vi), entry);
    return Ok(vec_entry_id(entry));
}

fn vindex_search(vi, query, query_dim, top_k) {
    var entries = load64(vi);
    var n = vec_len(entries);
    if (n == 0) { return vec_new(); }
    if (top_k <= 0) { return vec_new(); }
    if (query_dim == 0) { return vec_new(); }
    # ⛔ 2.2.3 — the query must have the index's dimension. cosine_similarity
    # reads `query_dim` f64s from EACH entry's embedding, and vindex_insert
    # guarantees every entry has exactly vindex_dimension() of them — so a longer
    # query read past the end of every embedding into whatever the heap held
    # next, and scored on it. rag_query_text always passes 32 today, so no live
    # route could send a mismatch; found by the module's first real test.
    if (query_dim != load64(vi + 8)) { return vec_new(); }

    # ⛔ 2.2.3 — TOP-K SELECTION, not a full sort. This scored every entry, then
    # insertion-sorted ALL n of them to return the first top_k: O(n^2) per query
    # on POST /v1/rag/query, whose index anyone can grow through the
    # unauthenticated ingest route. daimon.bcyr's copy of this search never
    # ranked, so the benchmark said 316 us; run against the real function it
    # said 7.51 ms. Old vs new, 64-d entries, top_k 5, per query:
    #       1,000 entries     7.48 ms  ->  0.38 ms
    #       4,000 entries   115    ms  ->  1.51 ms
    #      10,000 entries   716    ms  ->  3.86 ms
    # — all of it on the single request thread. (That data is near the sort's
    # worst case; random data lowers its constant, never its n^2.)
    #
    # `best` now holds at most top_k (score, entry) pairs, best first. A new
    # entry goes after every kept pair that STRICTLY outscores it — so, as with
    # the full sort it replaces, a later entry precedes an earlier one it ties,
    # and the results are identical, order included. O(n * top_k), and a pair is
    # allocated only for an entry that makes the cut (the old loop allocated one
    # per entry, per query, under an allocator that never frees).
    var best = vec_new();
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        var score = cosine_similarity(query, vec_entry_embedding(e), query_dim);
        var bl = vec_len(best);
        var p = 0;
        while (p < bl) {
            if (f64_gt(load64(vec_get(best, p)), score) == 0) { break; }
            p = p + 1;
        }
        if (p < top_k) {
            var pair = alloc(16);
            store64(pair, score);
            store64(pair + 8, e);
            if (bl < top_k) {
                vec_push(best, pair);      # grow by one; the shift below fills it
                bl = bl + 1;
            }
            var q = bl - 1;                # when full, the last pair falls off
            while (q > p) {
                vec_set(best, q, vec_get(best, q - 1));
                q = q - 1;
            }
            vec_set(best, p, pair);
        }
        i = i + 1;
    }

    var results = vec_new();
    var ri = 0;
    while (ri < vec_len(best)) {
        var bp = vec_get(best, ri);
        var be = load64(bp + 8);
        vec_push(results, search_result_new(vec_entry_id(be), vec_entry_content(be),
            vec_entry_metadata(be), load64(bp), ri));
        ri = ri + 1;
    }
    return results;
}

fn vindex_remove(vi, target_id) {
    var entries = load64(vi);
    var n = vec_len(entries);
    var i = 0;
    while (i < n) {
        var e = vec_get(entries, i);
        if (vec_entry_id(e) == target_id) {
            vec_remove(entries, i);
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

