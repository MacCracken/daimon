# =========================================================================
# Platform shims — syscalls whose ARITY differs between the host and agnos
# =========================================================================
#
# ⛔⛔ agnos's `sys_unlink` TAKES A LENGTH AND THE HOST'S DOES NOT, and that single mismatch is why
# `cyrius build --agnos src/main.cyr` FAILED for daimon at 2.1.3:
#     error: 'sys_unlink' expects 2 arguments, got 1     x4
#       src/memory.cyr:113, src/memory.cyr:149, src/ipc.cyr:183, src/ipc.cyr:347
# The host arm takes a NUL-terminated path; agnos's takes `(path, pathlen)` because its VFS does not
# scan for the terminator. Both are correct for their target; a caller cannot write one line for both.
#
# ⚠ WHY THIS MATTERS BEYOND A BUILD ERROR: daimon is the declared back end for crab's M7 index and
# tags (crab `[deps.daimon]` 2.1.3, 2026-09-14), and crab runs ON agnos. A daimon that cannot be
# built for agnos cannot be talked to there, so the index half of that milestone is blocked here
# rather than in crab. ⇒ Filed as docs/development/issues/archive/2026-09-14-daimon-does-not-build-for-agnos.md
#
# ⚠ THE SHAPE IS crab's, because it is the same problem solved once already — `crab_fs_unlink_raw`
# (crab src/app.cyr:1306) is this function with a different name. Taking the length as a parameter
# rather than calling `str_len` inside keeps the host arm free of a scan it does not need.
# (daimon_unlink moved to src/syscalls.cyr at 2.1.7 — the portability layer now
#  lives in one file that tests/syscall_portability.tcyr can include on its own.)

# =========================================================================
# error — error codes and HTTP status mapping
# =========================================================================

enum DaimonError {
    DAIMON_ERR_NONE = 0;
    DAIMON_ERR_INVALID_PARAM = 1;
    DAIMON_ERR_AGENT_NOT_FOUND = 2;
    DAIMON_ERR_AGENT_EXISTS = 3;
    DAIMON_ERR_SUPERVISOR = 4;
    DAIMON_ERR_IPC = 5;
    DAIMON_ERR_SCHEDULER = 6;
    DAIMON_ERR_FEDERATION = 7;
    DAIMON_ERR_API = 8;
    DAIMON_ERR_STORAGE = 9;
    # Every daimon error constant carries the `DAIMON_` prefix as of 1.4.2, so
    # none can collide with a vendored library's flat-global `ERR_*` under
    # cyrius's single-pass, last-definition-wins link — and the set satisfies
    # cyrlint's `lint_error_enum_namespace` rule (6.4.51: leaf projects must
    # namespace their ERR_* codes; the canonical unprefixed set is sakshi's).
    # This retires the earlier per-name workarounds: `DAIMON_ERR_IPC_FAULT`
    # (=10) was introduced at 1.3.0 as `ERR_IPC_FAULT` purely to dodge majra's
    # `ERR_IPC = 4` (pulled in via the bote MCP bundle); with the prefix that
    # collision is structurally impossible, but the code is kept for
    # backward-compatible numbering alongside `DAIMON_ERR_IPC` (=5). Likewise
    # daimon may now define a `DAIMON_ERR_IO` without colliding with sigil's
    # `SIGIL_ERR_IO`.
    DAIMON_ERR_IPC_FAULT = 10;
}

# Map error code to HTTP status code
fn error_to_status(err) {
    if (err == DAIMON_ERR_INVALID_PARAM) { return 400; }
    if (err == DAIMON_ERR_AGENT_NOT_FOUND) { return 404; }
    if (err == DAIMON_ERR_AGENT_EXISTS) { return 409; }
    return 500;
}

# Format an error as JSON response body
# JSON key lookup using cstr comparison (avoids str_eq Str layout issues)
fn jget(pairs, key_cstr) {
    if (pairs == 0) { return 0; }
    var len = vec_len(pairs);
    var gi = 0;
    while (gi < len) {
        var p = vec_get(pairs, gi);
        var k = load64(p);  # key Str
        if (str_eq_cstr(k, key_cstr) == 1) {
            return load64(p + 8);  # value Str
        }
        gi = gi + 1;
    }
    return 0;
}

fn jget_int(pairs, key_cstr) {
    var v = jget(pairs, key_cstr);
    if (v == 0) { return 0; }
    return str_to_int(v);
}

fn error_json(code, msg) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"error\":\"");
    str_builder_add(sb, msg);
    str_builder_add_cstr(sb, "\",\"code\":");
    str_builder_add_int(sb, code);
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

