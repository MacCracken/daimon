# =========================================================================
# api_sched — scheduler endpoints
# =========================================================================

# POST /v1/scheduler/tasks — submit task
fn api_sched_submit(fd, body) {
    if (body == 0) { http_bad_request(fd, str_from("missing body")); return 0; }
    var root = http_body_json(body);
    if (root == 0) { http_bad_body(fd); return 0; }
    var name = http_json_str(root, "name");
    if (name == 0) { http_bad_request(fd, str_from("task name required")); return 0; }
    if (str_len(name) == 0) { http_bad_request(fd, str_from("task name cannot be empty")); return 0; }
    var agent_id = http_json_str(root, "agent_id");
    if (agent_id == 0) { agent_id = str_from("unknown"); }
    var desc = http_json_str(root, "description");
    if (desc == 0) { desc = str_from(""); }
    var priority = http_json_int(root, "priority");
    if (priority == 0) { priority = 5; }
    # samay >= 1.1.3 owns every Str it retains (its `_samay_own`), so these jget
    # VIEWS into the reused request buffer are safe to hand over as-is. daimon
    # 2.2.1 cloned them here as a stopgap after a live cross-request leak on this
    # endpoint; the fix now lives in the library, where it covers every caller.
    var task = scheduled_task_new(name, desc, agent_id, priority, resource_req_default());
    # Guarded to match api_edge_register, the structurally identical endpoint
    # eight lines away in api_edge.cyr, which has always checked its Result
    # while this one did not. samay's task_scheduler_submit_task returns
    # Ok(id) on every path today, so the Err arm is currently unreachable —
    # this is defensive, not a live fix. It matters if samay ever grows a
    # failure path: without it the Err PAYLOAD would be serialised as the
    # task_id in a 201 response.
    var result_t, result_v = task_scheduler_submit_task(_scheduler, task);
    if (is_err_result(result_t) == 1) {
        http_bad_request(fd, str_from("task submission failed"));
        return 0;
    }
    var tid = result_v;
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"task_id\":\"");
    str_builder_add(sb, tid);
    str_builder_add_cstr(sb, "\"}");
    http_send_response(fd, 201, str_data(str_builder_build(sb)), str_len(str_builder_build(sb)));
    return 0;
}

# GET /v1/scheduler/tasks
fn api_sched_list(fd) {
    var st = task_scheduler_stats(_scheduler);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"stats\":{\"total_tasks\":");
    str_builder_add_int(sb, load64(st));
    str_builder_add_cstr(sb, ",\"queued\":");
    str_builder_add_int(sb, load64(st + 8));
    str_builder_add_cstr(sb, ",\"running\":");
    str_builder_add_int(sb, load64(st + 16));
    str_builder_add_cstr(sb, ",\"completed\":");
    str_builder_add_int(sb, load64(st + 24));
    str_builder_add_cstr(sb, ",\"failed\":");
    str_builder_add_int(sb, load64(st + 32));
    str_builder_add_cstr(sb, "}}");
    http_ok(fd, str_builder_build(sb));
    return 0;
}

# daimon's name for a task status. (Was an array indexed by the status — a
# value outside 0..6 would have read past it.)
fn _api_task_status_name(st) {
    if (st == TASK_QUEUED) { return "Queued"; }
    if (st == TASK_SCHEDULED) { return "Scheduled"; }
    if (st == TASK_RUNNING) { return "Running"; }
    if (st == TASK_COMPLETED) { return "Completed"; }
    if (st == TASK_FAILED) { return "Failed"; }
    if (st == TASK_CANCELLED) { return "Cancelled"; }
    if (st == TASK_PREEMPTED) { return "Preempted"; }
    return "Unknown";
}

fn _api_json_str_or_null(sb, s) {
    if (s == 0) { str_builder_add_cstr(sb, "null"); return 0; }
    str_builder_add_cstr(sb, "\"");
    str_builder_add(sb, json_escape_str(s));
    str_builder_add_cstr(sb, "\"");
    return 0;
}

# One task as JSON. task_id / name / priority / status are what GET has always
# answered; agent_id, node (where it was placed) and fail_reason are 2.3.1
# additions — an executor needs them to find and report its work. node and
# fail_reason are null when unset.
fn _api_task_json(sb, task) {
    str_builder_add_cstr(sb, "{\"task_id\":\"");
    str_builder_add(sb, ScheduledTask_task_id(task));
    str_builder_add_cstr(sb, "\",\"name\":\"");
    str_builder_add(sb, json_escape_str(ScheduledTask_name(task)));
    str_builder_add_cstr(sb, "\",\"priority\":");
    str_builder_add_int(sb, ScheduledTask_priority(task));
    str_builder_add_cstr(sb, ",\"status\":\"");
    str_builder_add_cstr(sb, _api_task_status_name(ScheduledTask_status(task)));
    str_builder_add_cstr(sb, "\",\"agent_id\":\"");
    str_builder_add(sb, json_escape_str(ScheduledTask_agent_id(task)));
    str_builder_add_cstr(sb, "\",\"node\":");
    _api_json_str_or_null(sb, ScheduledTask_node_preference(task));
    str_builder_add_cstr(sb, ",\"fail_reason\":");
    _api_json_str_or_null(sb, ScheduledTask_fail_reason(task));
    str_builder_add_cstr(sb, "}");
    return 0;
}

fn _api_task_ok(fd, task) {
    var sb = str_builder_new();
    _api_task_json(sb, task);
    http_ok(fd, str_builder_build(sb));
    return 0;
}

# A SCHED_OP_* refusal as an HTTP error.
fn _api_sched_op_error(fd, code) {
    if (code == SCHED_OP_NOT_FOUND) {
        http_error(fd, 404, str_from("task not found"));
    } elif (code == SCHED_OP_BAD_STATUS) {
        http_bad_request(fd, str_from("status must be completed or failed"));
    } else {
        http_error(fd, 409, str_from("the task's status does not allow this"));
    }
    return 0;
}

# GET /v1/scheduler/tasks/{id}
fn api_sched_get_task(fd, id_cstr) {
    var task = task_scheduler_get_task(_scheduler, str_from(id_cstr));
    if (task == 0) { http_error(fd, 404, str_from("task not found")); return 0; }
    _api_task_ok(fd, task);
    return 0;
}

# An audit entry for a task event, naming the task and recording its agent.
fn _api_task_audit(sev, action, what, task) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, what);
    str_builder_add_cstr(sb, " ");
    str_builder_add(sb, ScheduledTask_task_id(task));
    daimon_audit_agent(sev, "scheduler", action, str_data(str_builder_build(sb)),
      str_cstr(ScheduledTask_agent_id(task)));
    return 0;
}

# POST /v1/scheduler/tasks/{id}/start — whatever runs the task reports it
# running: SCHEDULED -> RUNNING. 2.3.1.
fn api_sched_start(fd, id_cstr) {
    var r_t, r_v = sched_task_start(_scheduler, str_from(id_cstr));
    if (is_err_result(r_t) == 1) { _api_sched_op_error(fd, r_v); return 0; }
    _api_task_audit(SEV_INFO, "task.start", "task running:", r_v);
    _api_task_ok(fd, r_v);
    return 0;
}

# POST /v1/scheduler/tasks/{id}/complete — and reports it done: RUNNING ->
# COMPLETED, or FAILED with {"status":"failed","reason":"..."}. No body, or no
# status, means completed. The node's capacity is returned at once. 2.3.1.
fn api_sched_complete(fd, id_cstr, body) {
    var final_status = TASK_COMPLETED;
    var reason = 0;
    if (body != 0) {
        var root = http_body_json(body);
        if (root == 0) { http_bad_body(fd); return 0; }
        if (http_json_has(root, "status") == 1) {
            final_status = sched_final_status_parse(http_json_str(root, "status"));
            if (final_status < 0) {
                http_bad_request(fd, str_from("status must be completed or failed"));
                return 0;
            }
        }
        reason = http_json_str(root, "reason");   # decoded, and already an owned copy
    }
    var r_t, r_v = sched_task_complete(_scheduler, str_from(id_cstr), final_status, reason);
    if (is_err_result(r_t) == 1) { _api_sched_op_error(fd, r_v); return 0; }
    if (final_status == TASK_FAILED) {
        _api_task_audit(SEV_WARNING, "task.fail", "task failed:", r_v);
    } else {
        _api_task_audit(SEV_INFO, "task.complete", "task completed:", r_v);
    }
    _api_task_ok(fd, r_v);
    return 0;
}

# GET /v1/scheduler/nodes/{id}/tasks — the tasks placed on a node that are
# SCHEDULED or RUNNING: how an executor on that node finds its work. 2.3.1.
# (Before this, the API had no way to list tasks at all: GET
# /v1/scheduler/tasks answers counts.)
fn api_sched_node_tasks(fd, node_cstr) {
    var node_id = str_from(node_cstr);
    if (map_get(TaskScheduler_nodes(_scheduler), node_id) == 0) {
        http_error(fd, 404, str_from("node not found"));
        return 0;
    }
    var tasks = task_scheduler_tasks_for_node(_scheduler, node_id);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"node_id\":\"");
    str_builder_add(sb, json_escape_str(node_id));
    str_builder_add_cstr(sb, "\",\"tasks\":[");
    var i = 0;
    while (i < vec_len(tasks)) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        _api_task_json(sb, vec_get(tasks, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"count\":");
    str_builder_add_int(sb, vec_len(tasks));
    str_builder_add_cstr(sb, "}");
    http_ok(fd, str_builder_build(sb));
    return 0;
}

# POST /v1/scheduler/tasks/{id}/cancel
fn api_sched_cancel(fd, id_cstr) {
    var cx_t, cx_v = task_scheduler_cancel_task(_scheduler, str_from(id_cstr));
    if (is_err_result(cx_t) == 1) {
        http_error(fd, 404, str_from("task not found or invalid state"));
        return 0;
    }
    http_ok(fd, str_from("{\"ok\":true}"));
    return 0;
}

# POST /v1/scheduler/nodes — register scheduler node
fn api_sched_register_node(fd, body) {
    if (body == 0) { http_bad_request(fd, str_from("missing body")); return 0; }
    var root = http_body_json(body);
    if (root == 0) { http_bad_body(fd); return 0; }
    var node_id = http_json_str(root, "node_id");
    if (node_id == 0) { http_bad_request(fd, str_from("node_id required")); return 0; }
    if (str_len(node_id) == 0) { http_bad_request(fd, str_from("node_id cannot be empty")); return 0; }
    var total_cpu = http_json_int(root, "total_cpu");
    if (total_cpu <= 0) { http_bad_request(fd, str_from("total_cpu must be positive")); return 0; }
    var total_mem = http_json_int(root, "total_memory_mb");
    if (total_mem <= 0) { http_bad_request(fd, str_from("total_memory_mb must be positive")); return 0; }
    var total_disk = http_json_int(root, "total_disk_mb");
    if (total_disk == 0) { total_disk = 102400; }
    var gpu = http_json_int(root, "gpu_available");
    # samay >= 1.1.3 owns node_id (see api_sched_submit above).
    var nc = node_capacity_new(node_id, f64_from(total_cpu), total_mem, total_disk, gpu);
    task_scheduler_register_node(_scheduler, nc);
    http_send_response(fd, 201, "{\"ok\":true}", 11);
    return 0;
}

# POST /v1/scheduler/schedule — trigger scheduling
fn api_sched_schedule(fd) {
    var decisions = task_scheduler_schedule_pending(_scheduler);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"decisions\":[");
    var di = 0;
    while (di < vec_len(decisions)) {
        if (di > 0) { str_builder_add_cstr(sb, ","); }
        SchedulingDecision_to_json(vec_get(decisions, di), sb);
        di = di + 1;
    }
    str_builder_add_cstr(sb, "]}");
    http_ok(fd, str_builder_build(sb));
    return 0;
}

# GET /v1/scheduler/stats
fn api_sched_stats(fd) {
    var st = task_scheduler_stats(_scheduler);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"total_tasks\":");
    str_builder_add_int(sb, load64(st));
    str_builder_add_cstr(sb, ",\"queued\":");
    str_builder_add_int(sb, load64(st + 8));
    str_builder_add_cstr(sb, ",\"running\":");
    str_builder_add_int(sb, load64(st + 16));
    str_builder_add_cstr(sb, ",\"completed\":");
    str_builder_add_int(sb, load64(st + 24));
    str_builder_add_cstr(sb, ",\"failed\":");
    str_builder_add_int(sb, load64(st + 32));
    # 2.3.1: meaningful now that a task can start — samay derives both from
    # started_at, which the start route stamps (0 until a task has run).
    str_builder_add_cstr(sb, ",\"average_wait_time_ms\":");
    str_builder_add_int(sb, SchedulerStats_average_wait_time_ms(st));
    str_builder_add_cstr(sb, ",\"average_run_time_ms\":");
    str_builder_add_int(sb, SchedulerStats_average_run_time_ms(st));
    str_builder_add_cstr(sb, "}");
    http_ok(fd, str_builder_build(sb));
    return 0;
}
