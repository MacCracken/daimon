# =========================================================================
# mcp — MCP tool registry (registry types + SSRF guard)
# =========================================================================
#
# Registry types are standalone. Builtin tools gained an in-process
# dispatcher at 1.3.0 (see mcp_builtin.cyr) — daimon now depends on bote for
# its libro audit-tool handlers + libro for the underlying chain. The
# registry itself stays bote-agnostic: it stores name/description/schema and
# routes builtin calls to mcp_dispatch_builtin.

# McpToolDescription: {name: Str, description: Str, input_schema: Str}
# 3 fields x 8 = 24 bytes

fn mcp_tool_new(name, desc, schema) {
    var t = alloc(24);
    store64(t, name);
    store64(t + 8, desc);
    store64(t + 16, schema);
    return t;
}

fn mcp_tool_name(t) { return load64(t); }
fn mcp_tool_desc(t) { return load64(t + 8); }
fn mcp_tool_schema(t) { return load64(t + 16); }

# Extract the MCP `inputSchema` from a registration body as compact JSON text.
# inputSchema is a nested JSON object (e.g. {"type":"object","properties":{…}})
# — the flat jget/json_parse path mangles nested values (it scans to the first
# `,`/`}`), so we use bayan's typed engine: parse the body, look up the schema
# (accepting the snake_case `input_schema` alias too), require a JSON object, and
# re-emit it compactly. The returned Str is fresh str_builder heap, not aliased
# to the request buffer. Returns str_from("{}") when the field is absent or is
# not a JSON object — back-compatible with registrants that send no schema.
# See docs/development/issues/2026-06-11-mcp-manifest-omits-tool-input-schema.md.
fn mcp_extract_input_schema(body) {
    if (body == 0) { return str_from("{}"); }
    var root = bayan_json_v_parse(body);
    if (root == 0) { return str_from("{}"); }
    if (bayan_json_v_is_obj(root) == 0) { return str_from("{}"); }
    var sv = bayan_json_v_obj_get(root, "inputSchema");
    if (sv == 0) { sv = bayan_json_v_obj_get(root, "input_schema"); }
    if (sv == 0) { return str_from("{}"); }
    if (bayan_json_v_is_obj(sv) == 0) { return str_from("{}"); }
    return bayan_json_v_build(sv);
}

# Schema text to emit for a tool in the MCP manifest. The stored schema is JSON
# object text ({} or a real schema). Fall back to a permissive {"type":"object"}
# when a tool has no schema (0 / empty) so the emitted `inputSchema` is always
# valid JSON — builtins register with no schema today.
fn mcp_manifest_schema(t) {
    var s = mcp_tool_schema(t);
    if (s == 0) { return str_from("{\"type\":\"object\"}"); }
    if (str_len(s) == 0) { return str_from("{\"type\":\"object\"}"); }
    return s;
}

# McpToolResult: {content: Str, is_error: i64}
fn mcp_result_text(text) {
    var r = alloc(16);
    store64(r, text);
    store64(r + 8, 0);
    return r;
}

fn mcp_result_error(msg) {
    var r = alloc(16);
    store64(r, msg);
    store64(r + 8, 1);
    return r;
}

# McpHostRegistry: {builtin: map, external: map}
fn mcp_registry_new() {
    var reg = alloc(16);
    store64(reg, map_new());     # builtin: name_cstr -> McpToolDescription
    store64(reg + 8, map_new()); # external: name_cstr -> McpToolDescription
    return reg;
}

fn mcp_register_builtin(reg, tool) {
    var name = mcp_tool_name(tool);
    map_set(load64(reg), str_cstr(name), tool);
}

# Deep-copy the tool's Strs and callback_url into registry-owned storage
# before storing. The Strs handed in by api_mcp_register point into the
# transient per-connection request buffer, which sync mode reuses for later
# requests — storing them raw lets subsequent requests overwrite the registry
# (names/descriptions/URLs render as fragments of later request bytes; a
# clobbered URL sidesteps the registration-time SSRF guard). The bump
# allocator never frees, so a plain str_clone is stable for the process
# lifetime. See docs/development/issues/2026-06-11-mcp-registry-aliases-
# request-buffer.md.
fn mcp_register_external(reg, tool, callback_url) {
    var name = str_clone(mcp_tool_name(tool));
    var desc = str_clone(mcp_tool_desc(tool));
    var schema = str_clone(mcp_tool_schema(tool));
    var owned = mcp_tool_new(name, desc, schema);
    var ext = alloc(16);
    store64(ext, owned);
    store64(ext + 8, str_clone(callback_url));
    map_set(load64(reg + 8), str_cstr(name), ext);
}

fn mcp_tool_count(reg) {
    return map_count(load64(reg)) + map_count(load64(reg + 8));
}

fn mcp_find_tool(reg, name_cstr) {
    var t = map_get(load64(reg), name_cstr);
    if (t != 0) { return t; }
    var ext = map_get(load64(reg + 8), name_cstr);
    if (ext != 0) { return load64(ext); }
    return 0;
}

# Look up the callback URL for an external tool. Returns 0 if the name
# resolves to a builtin or isn't registered. Pairs with mcp_find_tool —
# call both at the dispatch site to decide builtin vs external routing.
fn mcp_find_external_url(reg, name_cstr) {
    var ext = map_get(load64(reg + 8), name_cstr);
    if (ext == 0) { return 0; }
    return load64(ext + 8);
}

# Validate a callback URL (basic SSRF protection)
fn validate_callback_url(url) {
    if (url == 0) { return Err(DAIMON_ERR_INVALID_PARAM); }
    if (str_len(url) == 0) { return Err(DAIMON_ERR_INVALID_PARAM); }
    # Must start with http:// or https://
    if (str_starts_with(url, str_from("http://")) == 0) {
        if (str_starts_with(url, str_from("https://")) == 0) {
            return Err(DAIMON_ERR_INVALID_PARAM);
        }
    }
    return Ok(0);
}

fn mcp_deregister(reg, name_cstr) {
    return map_delete(load64(reg + 8), name_cstr);
}

# =========================================================================
# MCP resources + prompts registries (2.1.0)
# =========================================================================
#
# Sibling registries to the tool registry above, deliberately built on the SAME
# shape: a builtin map and an external map, the external entries wrapping a
# {description, callback_url} pair. A consumer (thoth) reaches resources and
# prompts through daimon exactly the way it reaches tools, so the spine has one
# discovery surface rather than one per MCP noun.
#
# ⚠ WHY EXPLICIT REGISTRATION AND NOT FAN-OUT AGGREGATION. The obvious
# alternative is to skip these registries entirely and answer `resources/list`
# by asking every registered host at request time, since an MCP server already
# knows its own resources and a registration can go stale. It was rejected on
# BLOCKING behaviour: the forward path builds no options struct, so every sandhi
# timeout getter returns 0 and a dropped-SYN host blocks the single sync worker
# for as long as the OS takes to give up. Aggregation would put that cost on
# every list, multiplied by the number of hosts, and one hung host would stall
# a consumer's whole turn. With registration, listing is local and instant, and
# only a read/get — one host, explicitly addressed — can block.
#
# ⚠ str_clone EVERY FIELD, exactly as mcp_register_external does. The Strs handed
# in by an api_* handler point into the transient per-connection request buffer,
# which sync mode REUSES for later requests: storing them raw lets a subsequent
# request overwrite the registry, which is a documented CVE-class bug in this
# very file (docs/development/issues/2026-06-11-mcp-registry-aliases-request-
# buffer.md) — a clobbered callback_url sidesteps the registration-time SSRF
# guard. The bump allocator never frees, so a plain str_clone is stable for the
# process lifetime.

# McpResourceDescription: {uri, name, description, mime_type} — 4 x 8 = 32 bytes
fn mcp_resource_new(uri, name, desc, mime) {
    var r = alloc(32);
    store64(r, uri);
    store64(r + 8, name);
    store64(r + 16, desc);
    store64(r + 24, mime);
    return r;
}

fn mcp_resource_uri(r)  { return load64(r); }
fn mcp_resource_name(r) { return load64(r + 8); }
fn mcp_resource_desc(r) { return load64(r + 16); }
fn mcp_resource_mime(r) { return load64(r + 24); }

# McpPromptDescription: {name, description, arguments_json} — 3 x 8 = 24 bytes
fn mcp_prompt_new(name, desc, args) {
    var p = alloc(24);
    store64(p, name);
    store64(p + 8, desc);
    store64(p + 16, args);
    return p;
}

fn mcp_prompt_name(p) { return load64(p); }
fn mcp_prompt_desc(p) { return load64(p + 8); }
fn mcp_prompt_args(p) { return load64(p + 16); }

# Extract an MCP prompt's `arguments` from a registration body as compact JSON
# ARRAY text. Same reasoning as mcp_extract_input_schema — the flat jget scanner
# stops at the first `,`/`}` and would mangle a nested array of argument objects
# — but the required shape here is an ARRAY, not an object. Returns "[]" when the
# field is absent or is not an array, so the emitted `arguments` is always valid
# JSON for a registrant that sends none.
fn mcp_extract_prompt_arguments(body) {
    if (body == 0) { return str_from("[]"); }
    var root = bayan_json_v_parse(body);
    if (root == 0) { return str_from("[]"); }
    if (bayan_json_v_is_obj(root) == 0) { return str_from("[]"); }
    var av = bayan_json_v_obj_get(root, "arguments");
    if (av == 0) { return str_from("[]"); }
    if (bayan_json_v_is_arr(av) == 0) { return str_from("[]"); }
    return bayan_json_v_build(av);
}

# Arguments text to emit for a prompt in a listing — always valid JSON array text.
fn mcp_prompt_args_text(p) {
    var a = mcp_prompt_args(p);
    if (a == 0) { return str_from("[]"); }
    if (str_len(a) == 0) { return str_from("[]"); }
    return a;
}

fn mcp_resource_registry_new() {
    var reg = alloc(16);
    store64(reg, map_new());     # builtin:  uri_cstr -> McpResourceDescription
    store64(reg + 8, map_new()); # external: uri_cstr -> {desc*, callback_url}
    return reg;
}

fn mcp_prompt_registry_new() {
    var reg = alloc(16);
    store64(reg, map_new());     # builtin:  name_cstr -> McpPromptDescription
    store64(reg + 8, map_new()); # external: name_cstr -> {desc*, callback_url}
    return reg;
}

fn mcp_register_resource_builtin(reg, res) {
    map_set(load64(reg), str_cstr(mcp_resource_uri(res)), res);
}

fn mcp_register_resource_external(reg, res, callback_url) {
    var uri  = str_clone(mcp_resource_uri(res));
    var name = str_clone(mcp_resource_name(res));
    var desc = str_clone(mcp_resource_desc(res));
    var mime = str_clone(mcp_resource_mime(res));
    var owned = mcp_resource_new(uri, name, desc, mime);
    var ext = alloc(16);
    store64(ext, owned);
    store64(ext + 8, str_clone(callback_url));
    map_set(load64(reg + 8), str_cstr(uri), ext);
}

fn mcp_register_prompt_builtin(reg, p) {
    map_set(load64(reg), str_cstr(mcp_prompt_name(p)), p);
}

fn mcp_register_prompt_external(reg, p, callback_url) {
    var name = str_clone(mcp_prompt_name(p));
    var desc = str_clone(mcp_prompt_desc(p));
    var args = str_clone(mcp_prompt_args(p));
    var owned = mcp_prompt_new(name, desc, args);
    var ext = alloc(16);
    store64(ext, owned);
    store64(ext + 8, str_clone(callback_url));
    map_set(load64(reg + 8), str_cstr(name), ext);
}

fn mcp_resource_count(reg) { return map_count(load64(reg)) + map_count(load64(reg + 8)); }
fn mcp_prompt_count(reg)   { return map_count(load64(reg)) + map_count(load64(reg + 8)); }

fn mcp_find_resource(reg, uri_cstr) {
    var r = map_get(load64(reg), uri_cstr);
    if (r != 0) { return r; }
    var ext = map_get(load64(reg + 8), uri_cstr);
    if (ext != 0) { return load64(ext); }
    return 0;
}

fn mcp_find_resource_url(reg, uri_cstr) {
    var ext = map_get(load64(reg + 8), uri_cstr);
    if (ext == 0) { return 0; }
    return load64(ext + 8);
}

fn mcp_find_prompt(reg, name_cstr) {
    var p = map_get(load64(reg), name_cstr);
    if (p != 0) { return p; }
    var ext = map_get(load64(reg + 8), name_cstr);
    if (ext != 0) { return load64(ext); }
    return 0;
}

fn mcp_find_prompt_url(reg, name_cstr) {
    var ext = map_get(load64(reg + 8), name_cstr);
    if (ext == 0) { return 0; }
    return load64(ext + 8);
}

fn mcp_deregister_resource(reg, uri_cstr) { return map_delete(load64(reg + 8), uri_cstr); }
fn mcp_deregister_prompt(reg, name_cstr)  { return map_delete(load64(reg + 8), name_cstr); }
