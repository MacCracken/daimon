# =========================================================================
# api — service-level endpoints (health, metrics)
# =========================================================================

# =========================================================================
# api — HTTP REST API route handlers + router (port 8090)
# =========================================================================

# --- API Routes ---

fn api_health(fd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"status\":\"ok\",\"agents\":");
    str_builder_add_int(sb, map_count(_agents));
    str_builder_add_cstr(sb, ",\"mcp_tools\":");
    str_builder_add_int(sb, mcp_tool_count(_mcp_registry));
    str_builder_add_cstr(sb, ",\"mcp_resources\":");
    str_builder_add_int(sb, mcp_resource_count(_mcp_resources));
    str_builder_add_cstr(sb, ",\"mcp_prompts\":");
    str_builder_add_int(sb, mcp_prompt_count(_mcp_prompts));
    str_builder_add_cstr(sb, ",\"edge_nodes\":");
    str_builder_add_int(sb, edge_fleet_node_count(_edge_fleet));
    str_builder_add_cstr(sb, "}");
    http_ok(fd, str_builder_build(sb));
}

fn api_metrics(fd) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"agents\":");
    str_builder_add_int(sb, map_count(_agents));
    str_builder_add_cstr(sb, ",\"mcp_tools\":");
    str_builder_add_int(sb, mcp_tool_count(_mcp_registry));
    str_builder_add_cstr(sb, ",\"mcp_resources\":");
    str_builder_add_int(sb, mcp_resource_count(_mcp_resources));
    str_builder_add_cstr(sb, ",\"mcp_prompts\":");
    str_builder_add_int(sb, mcp_prompt_count(_mcp_prompts));
    str_builder_add_cstr(sb, ",\"vector_entries\":");
    # ⛔ 2.2.3 — the RAG pipeline's OWN index. This read a global `_vindex` that
    # app_init created and nothing ever inserted into (rag_pipeline_new makes
    # its own), so the metric was 0 forever. Measured on 2.2.2: after a
    # successful ingest that a query then retrieved, /v1/metrics reported
    # "vector_entries":0. The orphan global is gone.
    str_builder_add_int(sb, vindex_len(rag_pipeline_index(_rag_pipeline)));
    str_builder_add_cstr(sb, ",\"edge_nodes\":");
    str_builder_add_int(sb, edge_fleet_node_count(_edge_fleet));
    str_builder_add_cstr(sb, ",\"federation_nodes\":");
    str_builder_add_int(sb, fed_mgr_node_count(_fed_mgr));
    # 2.3.3 agent channels: frames put on the bus, frames refused (a NACK, or
    # a fault that closed the channel), and bus messages dropped at a full
    # subscriber queue.
    str_builder_add_cstr(sb, ",\"ipc_messages\":");
    str_builder_add_int(sb, ipc_published_count());
    str_builder_add_cstr(sb, ",\"ipc_refused\":");
    str_builder_add_int(sb, ipc_refused_count());
    str_builder_add_cstr(sb, ",\"bus_dropped\":");
    str_builder_add_int(sb, msg_bus_dropped_count());
    # 2.3.4: open agent channels, and the bytes the bus holds (bounded by
    # IPC_BUS_BYTES_MAX; freed as messages are taken).
    str_builder_add_cstr(sb, ",\"ipc_channels\":");
    str_builder_add_int(sb, ipc_channel_count());
    str_builder_add_cstr(sb, ",\"bus_bytes\":");
    str_builder_add_int(sb, msg_bus_bytes());
    str_builder_add_cstr(sb, "}");
    http_ok(fd, str_builder_build(sb));
}
