# =========================================================================
# syscalls — the syscall numbers daimon owns, per arch
# =========================================================================
#
# Split out of src/main.cyr's preamble at 2.1.6 so the numbers can be
# INCLUDED BY A TEST on their own (tests/syscall_portability.tcyr) without
# dragging in the whole server. A number that no test can reach is how the
# two defects described below shipped for the life of the project.

# --- Syscall numbers the stdlib exposes no wrapper OR constant for ---
#
# ⚠ NEVER declare a `SYS_*` name here. daimon's source is parsed AFTER the
# auto-prepended stdlib, so a daimon `var SYS_FOO = <x86 number>` OVERRIDES the
# arch-aware peer's value for the WHOLE translation unit — including inside the
# stdlib's own `sys_*` wrappers. That is precisely how every daimon-aarch64
# artifact ever shipped ran `getpeername` as `fchmod` (per-IP rate limiter off,
# VULN-009) and `setrlimit` as `uname` (agent rlimits never applied, VULN-010):
# see docs/development/issues/archive/2026-09-14-aarch64-binary-issues-x86-syscall-
# numbers.md. The nine `SYS_*` globals that lived here are gone as of 2.1.6 —
# seven became `sys_*` wrapper calls, and the two below kept a number because
# the stdlib has neither wrapper nor constant for them. The `_DAIMON_SYS_`
# prefix cannot collide with, or override, a peer symbol.
#
# Numbers verified against the kernel UAPI headers, per arch, not from memory:
# x86_64 `asm/unistd_64.h`; aarch64 `asm-generic/unistd.h`.
#ifdef CYRIUS_ARCH_X86
var _DAIMON_SYS_GETSOCKOPT = 55;    # asm/unistd_64.h __NR_getsockopt
var _DAIMON_SYS_PRLIMIT64 = 302;    # asm/unistd_64.h __NR_prlimit64
#endif
#ifdef CYRIUS_ARCH_AARCH64
var _DAIMON_SYS_GETSOCKOPT = 209;   # asm-generic/unistd.h __NR_getsockopt
var _DAIMON_SYS_PRLIMIT64 = 261;    # asm-generic/unistd.h __NR_prlimit64
#endif
# pidfd_send_signal is 424 on BOTH arches (unified numbering — x86_64 and
# asm-generic agree), so it needs no arm; it is still namespaced so it can
# never shadow a future peer constant.
var _DAIMON_SYS_PIDFD_SEND_SIGNAL = 424;

# 2.3.0 — agent spawning (src/agent.cyr agent_spawn_with_limits). The stdlib has
# no pipe2 on x86_64 (its aarch64 peer uses 59 only inside sys_pipe, flags 0) and
# no close_range on either arch. Same header check as above.
#ifdef CYRIUS_ARCH_X86
var _DAIMON_SYS_PIPE2 = 293;        # asm/unistd_64.h __NR_pipe2
#endif
#ifdef CYRIUS_ARCH_AARCH64
var _DAIMON_SYS_PIPE2 = 59;         # asm-generic/unistd.h __NR_pipe2
#endif
var _DAIMON_SYS_CLOSE_RANGE = 436;  # both headers agree; Linux 5.9+
var _DAIMON_O_CLOEXEC = 524288;     # asm-generic/fcntl.h (1 << 19); x86_64's asm/fcntl.h includes it
var _DAIMON_RLIMIT_NOFILE = 7;      # asm-generic/resource.h, both arches

# =========================================================================
# Portability shims — one call shape, per-target bodies
# =========================================================================
#
# ⚠ THE AGNOS ARM IS NOT A FALLBACK. AGNOS is daimon's primary target: daimon
# IS the AGNOS agent orchestrator and every consumer is an AGNOS agent. The
# host (Linux) build is where daimon is developed; agnos is where it runs.
#
# agnos is a separate kernel, not a Linux flavour, and differs in three ways
# that reach every shim below (`agnos/kernel/core/syscall.cyr` is canonical —
# NOT the cyrius peer, which mirrors an older kernel and whose own header says
# so after a doc→peer→doc citation loop once let a wrong number verify itself):
#
#   1. EXPLICIT-LENGTH INVARIANT — every path argument carries its length.
#      Nothing assumes NUL-termination, so `rename`/`unlink` take (ptr, len)
#      pairs. Callers pass the length they already hold, so the host arm pays
#      no `strlen` scan it does not need.
#   2. DIFFERENT SYSCALL NUMBERS — agnos `rename` is 31, not Linux's 82.
#      Through 2.1.5 `src/memory.cyr` COMPILED on agnos against daimon's own
#      `SYS_RENAME = 82` and issued a silently wrong syscall on the
#      atomic-write path. 2.1.6 made that a loud compile error; 2.1.7 makes it
#      correct.
#   3. DIFFERENT SEMANTICS — see `daimon_reap` below, where the two kernels
#      disagree about what "wait for a child" even means.

# Remove a file. agnos: sys_unlink(path, len). Linux/macOS/Win: sys_unlink(path).
# (Moved here from src/error.cyr at 2.1.7 so the whole portability layer sits in
# one file that a test can include on its own.)
fn daimon_unlink(path_cstr, path_len) {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_unlink(path_cstr, path_len);
    #else
    return sys_unlink(path_cstr);
    #endif
}

# Rename a file. Returns 0 on success, negative on failure.
# agnos: sys_rename(old, oldlen, new, newlen) — explicit-length invariant.
# Linux: sys_rename(old, new); on aarch64 the peer routes it to renameat(AT_FDCWD).
fn daimon_rename(old_cstr, old_len, new_cstr, new_len) {
    #ifdef CYRIUS_TARGET_AGNOS
    return sys_rename(old_cstr, old_len, new_cstr, new_len);
    #else
    return sys_rename(old_cstr, new_cstr);
    #endif
}

# Non-blocking reap of one child. THE TWO KERNELS DISAGREE, so this normalises:
#     1  — the child has exited and was reaped
#     0  — the child is still alive
#    -1  — no such child
#
# Linux `waitpid(pid, &status, WNOHANG)` answers pid / 0 / -ECHILD.
# agnos `waitpid(pid)` (#4) is ALREADY non-blocking by design and answers
# exit_code / -2 (WOULD_BLOCK) / -1. The kernel is explicit that "-2 vs -1 IS
# THE WHOLE CONTRACT" — a parent loops while it gets -2 and stops on -1 —
# because collapsing them makes "my children are all running" indistinguishable
# from "I have none".
#
# ⛔ On agnos a reaped child's exit code may legitimately be 0, so "reaped" is
# `>= 0`, NOT `> 0`. Testing `> 0` would report every cleanly-exiting agent as
# still running, and `agent_stop` would then SIGKILL a process that had already
# exited normally.
fn daimon_reap(pid) {
    var c = daimon_reap_code(pid);
    if (c >= 0) { return 1; }
    if (c == 0 - 2) { return 0; }
    return 0 - 1;
}

# daimon_reap that KEEPS the exit status (2.3.0 — the lifecycle API reports it).
#    >= 0 — reaped; the exit code, or 128 + the signal number if a signal
#           killed it (the shell's convention, so one int carries both)
#      -2 — still running
#      -1 — no such child
# agnos's #4 already answers exactly this shape, so its arm passes through.
#
# ⛔ pid <= 0 is refused, not forwarded. waitpid(0) reaps ANY child in daimon's
# process group and waitpid(-1) ANY child at all: an agent record whose pid is
# still 0 would steal — and discard — another agent's exit status.
fn daimon_reap_code(pid) {
    if (pid <= 0) { return 0 - 1; }
    #ifdef CYRIUS_TARGET_AGNOS
    var wr = sys_waitpid(pid);
    if (wr >= 0) { return wr; }
    if (wr == 0 - 2) { return 0 - 2; }
    return 0 - 1;
    #else
    var status_buf: i32[1];
    var wr = sys_waitpid(pid, &status_buf, 1);   # WNOHANG
    if (wr == 0) { return 0 - 2; }
    if (wr < 0) { return 0 - 1; }
    var st = load32(&status_buf);
    if (WIFEXITED(st) == 1) { return WEXITSTATUS(st); }
    if (WIFSIGNALED(st) == 1) { return 128 + WTERMSIG(st); }
    return 0 - 2;   # not an exit (no WUNTRACED, so not expected)
    #endif
}

# Deliver `sig` to agent process `pid`: 0 on success, negative on failure.
# VULN-004: pidfd_open + pidfd_send_signal, falling back to kill(2) on kernels
# before 5.3. (For daimon's OWN unreaped children kill(2) is already safe: a
# pid cannot be reused until its parent reaps it, and daimon clears an agent's
# pid in the same step that reaps it. The pidfd path is kept for the audit
# trail VULN-004 records.)
# ⛔ pid <= 0 is refused: kill(0, sig) signals daimon's whole process group,
# daimon included, and kill(-1, sig) every process daimon may signal.
# agnos: no agent process exists there until 2.4.x maps sys_spawn_path.
fn daimon_signal(pid, sig) {
    if (pid <= 0) { return 0 - 1; }
    #ifdef CYRIUS_TARGET_AGNOS
    return 0 - 1;
    #else
    var pidfd = sys_pidfd_open(pid, 0);
    if (pidfd >= 0) {
        var r = syscall(_DAIMON_SYS_PIDFD_SEND_SIGNAL, pidfd, sig, 0, 0);
        sys_close(pidfd);
        return r;
    }
    return sys_kill(pid, sig);
    #endif
}

# Wait for a child to exit, bounded. Returns 1 if reaped, 0 if it outlived the
# bound, -1 if no such child. Called only after SIGKILL, which cannot be caught.
#
# agnos has NO blocking wait — #4 is a poll and the blocking form is deferred
# upstream pending per-proc kernel stacks — so the loop is the only shape
# available there. The host arm polls too, deliberately: the previous
# `sys_waitpid(pid, &status, 0)` blocked FOREVER if the child sat in
# uninterruptible sleep, hanging the whole supervisor on one wedged agent.
# A bounded poll degrades that to an unreaped child, which agent_stop leaves
# STOPPING with its pid kept, and agent_reap collects later (2.3.0).
var DAIMON_REAP_BUDGET_MS = 1000;  # the SIGKILL-to-reap budget

fn daimon_reap_wait(pid) {
    var r = daimon_reap_within(pid, DAIMON_REAP_BUDGET_MS);
    if (r >= 0) { return 1; }
    if (r == 0 - 2) { return 0; }
    return 0 - 1;
}

# Poll daimon_reap_code, 1 ms apart, until `ms` milliseconds of MONOTONIC time
# have passed. Returns what the last poll returned: the exit code, -2 if the
# child outlived the bound, -1 if there is no such child. 2.3.0: the SIGTERM
# grace in agent_stop and the SIGKILL-to-reap budget above are both this loop.
# (Counting sleeps instead of reading the clock ran a 5 s grace to 5.36 s —
# measured — because each 1 ms sleep costs more than 1 ms.)
fn daimon_reap_within(pid, ms) {
    # `sys_nanosleep(req, rem)` is the one sleep primitive BOTH the Linux and
    # agnos peers define (agnos also has sys_sleep_ms, Linux does not), so it is
    # what keeps this loop free of an #ifdef. timespec = {i64 tv_sec, i64 tv_nsec};
    # element-typed `i64[2]` per CLAUDE.md — a bare `var ts[2]` is TWO BYTES in a
    # function since cyrius 6.2.1 and would corrupt the frame when written via &ts.
    var ts: i64[2];
    store64(&ts, 0);
    store64(&ts + 8, 1000000);      # 1 ms
    var deadline = clock_now_ms() + ms;
    var r = daimon_reap_code(pid);
    while (r == 0 - 2) {
        if (clock_now_ms() >= deadline) { return r; }
        sys_nanosleep(&ts, 0);
        r = daimon_reap_code(pid);
    }
    return r;
}

# Peer IPv4 address of a connected socket, as a 32-bit integer.
# Returns 0 when the platform CANNOT report one — which is a distinct answer
# from "the peer is 0.0.0.0", and callers must treat it as "unidentified", not
# as "allow".
#
# agnos exposes no getpeername: `sock_accept` (#57) hands back a raw conn_id
# (0..7) and the kernel keeps the address behind it. So the per-IP bucket has
# no key there, and `rate_check` falls back to a SHARED bucket rather than
# waving the request through — see src/server.cyr. Silently allowing everyone
# is exactly the VULN-009 shape 2.1.6 fixed for aarch64, and it must not come
# back through a different door.
fn daimon_peer_ip(cfd) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #else
    var addr_buf = alloc(32);   # sockaddr_in = 16 bytes, pad
    var addr_len = alloc(8);
    store32(addr_len, 16);
    var r = sys_getpeername(cfd, addr_buf, addr_len);
    if (r < 0) { return 0; }
    # sockaddr_in: family(2) + port(2) + addr(4) — IP at offset 4
    return load32(addr_buf + 4);
    #endif
}
