# =========================================================================
# router — HTTP method/path dispatch (http_route)
# =========================================================================

# --- Main HTTP router ---

# ⛔ 2.3.0 — agent control refuses browser-originated requests. Verified before
# the guard: a `Content-Type: text/plain` POST carrying `Origin:
# https://attacker.example` STARTED an agent — a browser sends that from any web
# page without a CORS preflight — and daimon answers any Host header, so a
# DNS-rebinding page reaches it too. The classes of CVE-2022-28108 (Selenium
# Grid: CSRF via text/plain) and CVE-2024-28224 (Ollama: DNS rebinding).
# daimon's own clients send no Origin. Every other route is unchanged until
# authentication (roadmap 2.5.x). Returns 1 if it answered 403.
fn _route_refuse_browser(fd, buf, buf_len) {
    if (http_has_origin(buf, buf_len) == 0) { return 0; }
    daimon_audit(SEV_WARNING, "http", "agent.control.origin",
      "browser-originated agent control refused");
    http_error(fd, 403, str_from("agent control does not accept browser-originated requests"));
    return 1;
}

# The id in "<id><suffix>" — a fresh NUL-terminated copy — when `sub` ends with
# `suffix` and the id is not empty; otherwise 0. (2.3.0: the agent actions. The
# edge and scheduler routes below inline the same copy.)
fn _route_id_before(sub, sublen, suffix, slen) {
    if (sublen <= slen) { return 0; }
    if (memeq(sub + sublen - slen, suffix, slen) != 1) { return 0; }
    var id_len = sublen - slen;
    var id_buf = alloc(id_len + 1);
    memcpy(id_buf, sub, id_len);
    store8(id_buf + id_len, 0);
    return id_buf;
}

fn http_route(fd, method, path, buf, buf_len) {
    # GET /v1/health
    if (streq(path, "/v1/health") == 1) {
        if (route_method(fd, method, 0) == 0) { return 0; }
        api_health(fd);
        return 0;
    }

    # /v1/agents
    if (streq(path, "/v1/agents") == 1) {
        if (method == 0) { api_list_agents(fd); return 0; }
        if (method == 1) {
            api_register_agent(fd, http_parse_body(buf, buf_len));
            return 0;
        }
        http_method_not_allowed(fd);
        return 0;
    }

    # /v1/agents/{id} (GET, DELETE) and /v1/agents/{id}/{start,stop,pause,resume}
    # (POST only — a state change never rides a GET, 2.2.2). 2.3.0.
    if (memeq(path, "/v1/agents/", 11) == 1) {
        var asub = path + 11;
        var aslen = strlen(asub);
        var aid = _route_id_before(asub, aslen, "/start", 6);
        if (aid != 0) {
            if (route_method(fd, method, 1) == 0) { return 0; }
            if (_route_refuse_browser(fd, buf, buf_len) == 1) { return 0; }
            api_agent_start(fd, aid);
            return 0;
        }
        aid = _route_id_before(asub, aslen, "/stop", 5);
        if (aid != 0) {
            if (route_method(fd, method, 1) == 0) { return 0; }
            if (_route_refuse_browser(fd, buf, buf_len) == 1) { return 0; }
            api_agent_stop(fd, aid);
            return 0;
        }
        aid = _route_id_before(asub, aslen, "/pause", 6);
        if (aid != 0) {
            if (route_method(fd, method, 1) == 0) { return 0; }
            if (_route_refuse_browser(fd, buf, buf_len) == 1) { return 0; }
            api_agent_pause(fd, aid);
            return 0;
        }
        aid = _route_id_before(asub, aslen, "/resume", 7);
        if (aid != 0) {
            if (route_method(fd, method, 1) == 0) { return 0; }
            if (_route_refuse_browser(fd, buf, buf_len) == 1) { return 0; }
            api_agent_resume(fd, aid);
            return 0;
        }
        if (aslen > 0) {
            if (method == 0) { api_get_agent(fd, asub); return 0; }
            if (method == 3) {
                if (_route_refuse_browser(fd, buf, buf_len) == 1) { return 0; }
                api_agent_delete(fd, asub);
                return 0;
            }
            http_method_not_allowed(fd);
            return 0;
        }
    }

    # /v1/mcp/tools
    if (streq(path, "/v1/mcp/tools") == 1) {
        if (method == 0) { api_mcp_manifest(fd); return 0; }
        if (method == 1) { api_mcp_register(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }
    if (streq(path, "/v1/mcp/manifest") == 1) {
        if (route_method(fd, method, 0) == 0) { return 0; }
        api_mcp_manifest(fd);
        return 0;
    }

    # DELETE /v1/mcp/tools/{name}
    if (memeq(path, "/v1/mcp/tools/", 14) == 1) {
        if (method == 3) { api_mcp_deregister(fd, path + 14); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }

    # --- MCP resources + prompts (2.1.0) ---
    #
    # ⚠ ORDER MATTERS. The two-segment paths (/resources/read, /resources/deregister)
    # are matched BEFORE the bare /resources, and every match is a full streq — no
    # memeq prefix branch exists here on purpose. A resource URI contains "://" and
    # further slashes, so it travels in the BODY; nothing about a resource ever rides
    # a path segment, which is what makes plain equality sufficient and safe.
    #
    # ⚠ METHOD GUARD. http_parse_method maps ANY unrecognized verb to 0 (GET), so a
    # route must never be written as "if not POST then GET". Each arm below tests its
    # method explicitly and answers 405 otherwise. (2.2.2: http_parse_method now
    # returns -1 for an unknown verb, so it can no longer masquerade as GET.)
    if (streq(path, "/v1/mcp/resources/read") == 1) {
        if (method == 1) { api_mcp_resource_read(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }
    if (streq(path, "/v1/mcp/resources/deregister") == 1) {
        if (method == 1) { api_mcp_resource_deregister(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }
    if (streq(path, "/v1/mcp/resources") == 1) {
        if (method == 0) { api_mcp_resources_list(fd); return 0; }
        if (method == 1) { api_mcp_resource_register(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }
    if (streq(path, "/v1/mcp/prompts/get") == 1) {
        if (method == 1) { api_mcp_prompt_get(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }
    if (streq(path, "/v1/mcp/prompts/deregister") == 1) {
        if (method == 1) { api_mcp_prompt_deregister(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }
    if (streq(path, "/v1/mcp/prompts") == 1) {
        if (method == 0) { api_mcp_prompts_list(fd); return 0; }
        if (method == 1) { api_mcp_prompt_register(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }

    # POST /v1/mcp/call
    if (streq(path, "/v1/mcp/call") == 1) {
        if (route_method(fd, method, 1) == 0) { return 0; }
        api_mcp_call(fd, http_parse_body(buf, buf_len));
        return 0;
    }

    # POST /v1/rag/ingest
    if (streq(path, "/v1/rag/ingest") == 1) {
        if (route_method(fd, method, 1) == 0) { return 0; }
        api_rag_ingest(fd, http_parse_body(buf, buf_len));
        return 0;
    }

    # POST /v1/rag/query
    if (streq(path, "/v1/rag/query") == 1) {
        if (route_method(fd, method, 1) == 0) { return 0; }
        api_rag_query(fd, http_parse_body(buf, buf_len));
        return 0;
    }

    # /v1/edge/nodes
    if (streq(path, "/v1/edge/nodes") == 1) {
        if (method == 0) { api_edge_list(fd, buf, buf_len); return 0; }
        if (method == 1) { api_edge_register(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }

    # GET /v1/edge/stats
    if (streq(path, "/v1/edge/stats") == 1) {
        if (route_method(fd, method, 0) == 0) { return 0; }
        api_edge_stats(fd);
        return 0;
    }

    # /v1/edge/nodes/{id}/heartbeat
    if (memeq(path, "/v1/edge/nodes/", 15) == 1) {
        var sub = path + 15;
        # Check for /heartbeat suffix
        var sublen = strlen(sub);
        if (sublen > 10) {
            if (memeq(sub + sublen - 10, "/heartbeat", 10) == 1) {
                if (route_method(fd, method, 1) == 0) { return 0; }
                var id_len = sublen - 10;
                var id_buf = alloc(id_len + 1);
                memcpy(id_buf, sub, id_len);
                store8(id_buf + id_len, 0);
                api_edge_heartbeat(fd, id_buf, http_parse_body(buf, buf_len));
                return 0;
            }
        }
        # Check for /decommission suffix (13 chars)
        if (sublen > 13) {
            if (memeq(sub + sublen - 13, "/decommission", 13) == 1) {
                # ⛔ POST only (2.2.2). A plain GET here decommissioned the node:
                # measured, GET .../1/decommission took status 0 -> 4. Edge ids
                # are sequential, so a cross-origin <img src> could walk the
                # whole fleet — a GET needs no CORS preflight and daimon has no
                # auth. State changes must never ride a safe method.
                if (route_method(fd, method, 1) == 0) { return 0; }
                var dc_len = sublen - 13;
                var dc_buf = alloc(dc_len + 1);
                memcpy(dc_buf, sub, dc_len);
                store8(dc_buf + dc_len, 0);
                api_edge_decommission(fd, dc_buf);
                return 0;
            }
        }
        # Plain /v1/edge/nodes/{id}
        if (route_method(fd, method, 0) == 0) { return 0; }
        api_edge_get(fd, sub);
        return 0;
    }

    # /v1/scheduler/tasks
    if (streq(path, "/v1/scheduler/tasks") == 1) {
        if (method == 0) { api_sched_list(fd); return 0; }
        if (method == 1) { api_sched_submit(fd, http_parse_body(buf, buf_len)); return 0; }
        http_method_not_allowed(fd);
        return 0;
    }

    # POST /v1/scheduler/nodes
    if (streq(path, "/v1/scheduler/nodes") == 1) {
        # POST only (2.2.2). Every method used to land here, so a GET answered
        # "400 missing body" — misleading, and it hid that nodes cannot be
        # listed at all. A GET is now an honest 405.
        if (route_method(fd, method, 1) == 0) { return 0; }
        api_sched_register_node(fd, http_parse_body(buf, buf_len));
        return 0;
    }

    # POST /v1/scheduler/schedule
    if (streq(path, "/v1/scheduler/schedule") == 1) {
        if (route_method(fd, method, 1) == 0) { return 0; }
        api_sched_schedule(fd);
        return 0;
    }

    # GET /v1/scheduler/stats
    if (streq(path, "/v1/scheduler/stats") == 1) {
        if (route_method(fd, method, 0) == 0) { return 0; }
        api_sched_stats(fd);
        return 0;
    }

    # /v1/scheduler/tasks/{id} or /v1/scheduler/tasks/{id}/cancel
    if (memeq(path, "/v1/scheduler/tasks/", 20) == 1) {
        var sub = path + 20;
        var sublen = strlen(sub);
        if (sublen > 7) {
            if (memeq(sub + sublen - 7, "/cancel", 7) == 1) {
                # ⛔ POST only (2.2.2). A plain GET cancelled the task — measured,
                # Queued -> Cancelled. Same CSRF-by-GET class as decommission.
                if (route_method(fd, method, 1) == 0) { return 0; }
                var cn_len = sublen - 7;
                var cn_buf = alloc(cn_len + 1);
                memcpy(cn_buf, sub, cn_len);
                store8(cn_buf + cn_len, 0);
                api_sched_cancel(fd, cn_buf);
                return 0;
            }
        }
        if (route_method(fd, method, 0) == 0) { return 0; }
        api_sched_get_task(fd, sub);
        return 0;
    }

    # GET /v1/metrics
    if (streq(path, "/v1/metrics") == 1) {
        if (route_method(fd, method, 0) == 0) { return 0; }
        api_metrics(fd);
        return 0;
    }

    http_not_found(fd);
}
