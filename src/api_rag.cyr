# =========================================================================
# api_rag — RAG ingest/query endpoints
# =========================================================================

# POST /v1/rag/ingest
fn api_rag_ingest(fd, body) {
    if (body == 0) { http_bad_request(fd, str_from("missing body")); return 0; }
    var root = http_body_json(body);
    if (root == 0) { http_bad_body(fd); return 0; }
    var text = http_json_str(root, "text");
    if (text == 0) { http_bad_request(fd, str_from("text cannot be empty")); return 0; }
    if (str_len(text) == 0) { http_bad_request(fd, str_from("text cannot be empty")); return 0; }
    # Any JSON value, as in the Rust original: a string as itself, anything else
    # as compact JSON text (the flat parser kept an object only up to its first
    # comma).
    var metadata = http_json_text(root, "metadata");
    if (metadata == 0) { metadata = str_from("null"); }
    var ids = rag_ingest_text(_rag_pipeline, text, metadata);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"chunk_ids\":[");
    var ri = 0;
    while (ri < vec_len(ids)) {
        if (ri > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_int(sb, vec_get(ids, ri));
        ri = ri + 1;
    }
    str_builder_add_cstr(sb, "]}");
    var out = str_builder_build(sb);
    http_send_response(fd, 201, str_data(out), str_len(out));
    return 0;
}

# POST /v1/rag/query
fn api_rag_query(fd, body) {
    if (body == 0) { http_bad_request(fd, str_from("missing body")); return 0; }
    var root = http_body_json(body);
    if (root == 0) { http_bad_body(fd); return 0; }
    var query = http_json_str(root, "query");
    if (query == 0) { http_bad_request(fd, str_from("query cannot be empty")); return 0; }
    if (str_len(query) == 0) { http_bad_request(fd, str_from("query cannot be empty")); return 0; }
    var ctx = rag_query_text(_rag_pipeline, query);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"formatted_context\":\"");
    # ⛔ 2.2.3 — json_escape_str (src/error.cyr), not a second hand-rolled copy.
    # This loop escaped " \ \n \r and passed every other control byte through
    # RAW; the context echoes ingested text, so a TAB or 0x01 in a document came
    # back inside a JSON string, which RFC 8259 forbids. Measured on 2.2.2: a
    # query answer carrying 0x09 and 0x01 that Python's json.loads rejects.
    str_builder_add(sb, json_escape_str(ctx));
    str_builder_add_cstr(sb, "\"}");
    http_ok(fd, str_builder_build(sb));
    return 0;
}
