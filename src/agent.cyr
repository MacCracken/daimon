# =========================================================================
# agent — agent lifecycle, process spawning, /proc helpers
# =========================================================================

enum AgentStatus {
    AGENT_PENDING = 0;
    AGENT_STARTING = 1;
    AGENT_RUNNING = 2;
    AGENT_PAUSED = 3;
    AGENT_STOPPING = 4;
    AGENT_STOPPED = 5;
    AGENT_FAILED = 6;
}

enum StopReason {
    STOP_USER = 0;
    STOP_ERROR = 1;
    STOP_RESOURCE = 2;
    STOP_TIMEOUT = 3;
    STOP_PREEMPTED = 4;
}

# agnostik's AgentType, in its order. The type chooses the executable
# (agent_find_executable), as it did in the Rust original. 2.3.0.
enum AgentType {
    AGENT_TYPE_SYSTEM = 0;
    AGENT_TYPE_USER = 1;
    AGENT_TYPE_SERVICE = 2;
}

# Why a lifecycle operation was refused — the Err payload of agent_start,
# agent_spawn_with_limits, agent_pause and agent_resume. 2.3.0.
enum AgentOpError {
    AGENT_OP_BAD_STATE = 1;       # the agent's status does not allow it
    AGENT_OP_NO_EXECUTABLE = 2;   # nothing is installed for the agent's type
    AGENT_OP_NO_PROCESS = 3;      # pipe2 or fork failed
    AGENT_OP_NO_LIMITS = 4;       # an rlimit could not be applied (VULN-010)
    AGENT_OP_NO_EXEC = 5;         # execve failed
    AGENT_OP_UNSUPPORTED = 6;     # this target cannot do this yet (agnos: pause / resume)
    AGENT_OP_SIGNAL = 7;          # the signal could not be delivered
    AGENT_OP_ARGS = 8;            # the command line cannot be passed (agnos: a space, or > 127 bytes)
    AGENT_OP_CAPACITY = 9;        # no room for another agent's channel (agnos: CH_E_FULL). 2.4.1
}

# AgentHandle: {id, name, status, created_at, started_at, pid,
#               mem_used, cpu_time, fds_used, threads_used,
#               type, exit_code}
# 12 fields x 8 bytes = 96 bytes (type + exit_code added at 2.3.0)

fn agent_handle_new(id, name) {
    var h = alloc(136);
    store64(h, id);                # id (integer counter)
    # ⛔ str_clone THE NAME — copy at the RETENTION boundary. 2.2.1.
    #
    # `api_register_agent` passes `jget(pairs, "name")`: a VIEW into the
    # per-connection request buffer, which sandhi REUSES. Stored raw, the next
    # request from ANY client overwrote it, and `GET /v1/agents` served that
    # client's bytes back as this agent's name. Measured on the live binary:
    #
    #   POST /v1/agents {"name":"ORIGINAL_AGENT_NAME"} -> {"name":"ORIGINAL_AGENT_NAME"}
    #   (one unrelated POST /v1/rag/query from another client)
    #   GET  /v1/agents -> {"name":"y\":\"ZZZZZZZZZZZZZZZ"}
    #
    # A LIVE cross-request data disclosure on an unauthenticated endpoint — the
    # same class as the 2.1.6 RAG leak (docs/development/issues/archive/
    # 2026-09-22-rag-chunks-alias-the-request-buffer.md), whose "sweep, don't
    # spot-fix" instruction was never carried out until 2.2.1. Fixed here rather
    # than at the caller so every future caller of agent_handle_new is covered;
    # cloning a caller that already owns its Str (a literal, str_from_int) costs
    # one small copy and is harmless.
    store64(h + 8, str_clone(name));   # name: Str (owned)
    store64(h + 16, AGENT_PENDING); # status
    store64(h + 24, clock_epoch_secs());   # created_at (epoch secs)
    store64(h + 32, 0);            # started_at
    store64(h + 40, 0);            # pid
    store64(h + 48, 0);            # mem_used
    store64(h + 56, 0);            # cpu_time
    store64(h + 64, 0);            # fds_used
    store64(h + 72, 0);            # threads_used
    store64(h + 80, AGENT_TYPE_USER);   # type — agnostik's AgentConfig default
    store64(h + 88, 0 - 1);        # exit_code: -1 until the process has exited
    store64(h + 96, 0);            # a stop's SIGKILL deadline, ms (0 = no stop under way; 2.3.4)
    store64(h + 104, 0);           # when that stop sent SIGKILL, ms (0 = not yet)
    store64(h + 112, 0);           # 1 if its process runs under its limits (2.4.0; agnos cannot)
    store64(h + 120, 0);           # its cgroup's directory, a cstr, or 0 (2.4.2)
    store64(h + 128, 0);           # 1 if its process is in that cgroup (2.4.2)
    return h;
}

fn agent_id(h) { return load64(h); }
fn agent_name(h) { return load64(h + 8); }
fn agent_status(h) { return load64(h + 16); }
fn agent_created_at(h) { return load64(h + 24); }
fn agent_started_at(h) { return load64(h + 32); }
fn agent_pid(h) { return load64(h + 40); }
fn agent_mem_used(h) { return load64(h + 48); }
fn agent_cpu_time(h) { return load64(h + 56); }
fn agent_fds_used(h) { return load64(h + 64); }
fn agent_threads(h) { return load64(h + 72); }

fn agent_type(h) { return load64(h + 80); }
# The exit code of the agent's last process (128 + signal if a signal killed
# it), or -1 if it has not exited — or exited somewhere daimon could not see.
fn agent_exit_code(h) { return load64(h + 88); }
# 1 if the agent's process runs under its quota's limits: always on Linux (a
# start whose rlimits fail is refused), never on agnos, which has no limits yet
# (2.4.0; filed with agnos 2026-09-23).
fn agent_limits_enforced(h) { return load64(h + 112); }
# 1 if the agent's process runs in a cgroup of its own, so a stop reaches every
# process it starts, even one that left its process group (2.4.2).
fn agent_contained(h) { return load64(h + 128); }
fn agent_cgroup_dir(h) { return load64(h + 120); }

fn agent_set_status(h, s) { store64(h + 16, s); }
fn agent_set_pid(h, pid) { store64(h + 40, pid); }
fn agent_set_started_at(h, t) { store64(h + 32, t); }
fn agent_set_type(h, t) { store64(h + 80, t); }
fn agent_set_exit_code(h, c) { store64(h + 88, c); }
fn agent_set_limits_enforced(h, v) { store64(h + 112, v); }

# agnostik's serialised name for a type.
fn agent_type_name(t) {
    if (t == AGENT_TYPE_SYSTEM) { return "System"; }
    if (t == AGENT_TYPE_SERVICE) { return "Service"; }
    return "User";
}

# A type from its name — agnostik's form ("User") or all lower case ("user").
# Returns the type, or -1 for anything else.
fn agent_type_parse(s) {
    if (s == 0) { return 0 - 1; }
    if (str_eq_cstr(s, "System") == 1) { return AGENT_TYPE_SYSTEM; }
    if (str_eq_cstr(s, "system") == 1) { return AGENT_TYPE_SYSTEM; }
    if (str_eq_cstr(s, "User") == 1) { return AGENT_TYPE_USER; }
    if (str_eq_cstr(s, "user") == 1) { return AGENT_TYPE_USER; }
    if (str_eq_cstr(s, "Service") == 1) { return AGENT_TYPE_SERVICE; }
    if (str_eq_cstr(s, "service") == 1) { return AGENT_TYPE_SERVICE; }
    return 0 - 1;
}

# Global agent ID counter
var _next_agent_id = 1;

fn agent_next_id() {
    var id = _next_agent_id;
    _next_agent_id = _next_agent_id + 1;
    return id;
}

# /proc helpers — read resource usage for a PID

#ifdef CYRIUS_TARGET_AGNOS
# agnos (2.4.0) has no /proc. proclist#99 reports each live process as a
# 64-byte record: +0 pid, and +56 a word holding its CPU ticks (low 32 bits,
# 100 Hz) and its resident 4 KiB pages (high 32 bits). The table has 16 slots.
var _agent_pl: u8[1024];
var _AGENT_PL_ABSENT = 0 - 1;

# The +56 word of `pid`'s record, or -1 when no live process has that pid.
fn _agent_proc_word(pid) {
    var n = sys_proclist(&_agent_pl, 16);
    var i = 0;
    while (i < n) {
        if (load64(&_agent_pl + i * 64) == pid) { return load64(&_agent_pl + i * 64 + 56); }
        i = i + 1;
    }
    return _AGENT_PL_ABSENT;
}
#endif

fn read_vm_rss(pid) {
    if (pid == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    var w = _agent_proc_word(pid);
    if (w < 0) { return 0; }
    return (w >> 32) * 4096;
    #endif
    var path_sb = str_builder_new();
    str_builder_add_cstr(path_sb, "/proc/");
    str_builder_add_int(path_sb, pid);
    str_builder_add_cstr(path_sb, "/status");
    var path = str_builder_build(path_sb);

    var buf = alloc(8192);
    var n = file_read_all(str_data(path), buf, 8191);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);

    # Search for "VmRSS:" line
    var i = 0;
    while (i < n) {
        if (memeq(buf + i, "VmRSS:", 6) == 1) {
            var j = i + 6;
            # Skip whitespace.
            #
            # ⛔ 2.2.0 — this loop was `if (c != 32) break; if (c != 9) break;`,
            # which can NEVER advance: a byte cannot be both a space and a tab,
            # so whichever it is, one of the two tests fires on the first
            # iteration. `/proc/<pid>/status` writes `VmRSS:\t   12345 kB` — a
            # TAB — so `j` stayed on the tab, the digit parser below saw 9 (< 48)
            # and stopped immediately, and **read_vm_rss returned 0 for every
            # process, always**. Caught the first time this function was ever
            # executed (tests/agent.tcyr, the 2.2.0 test-integrity migration);
            # it had no caller and no test before that.
            #
            # The intent is "advance while it IS whitespace", so the break must
            # require BOTH to be false.
            while (j < n) {
                var wc = load8(buf + j);
                if (wc != 32) {
                    if (wc != 9) { break; }
                }
                j = j + 1;
            }
            # Parse number (in kB)
            var kb = 0;
            while (j < n) {
                var c = load8(buf + j);
                if (c < 48) { break; }
                if (c > 57) { break; }
                kb = kb * 10 + c - 48;
                j = j + 1;
            }
            return kb * 1024;
        }
        # Advance to next line
        while (i < n) {
            if (load8(buf + i) == 10) { i = i + 1; break; }
            i = i + 1;
        }
    }
    return 0;
}

# Read CPU time (utime+stime) from /proc/{pid}/stat in milliseconds
fn read_cpu_time_ms(pid) {
    if (pid == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    var cw = _agent_proc_word(pid);
    if (cw < 0) { return 0; }
    return (cw & 4294967295) * 10;   # 100 Hz ticks
    #endif
    var path_sb = str_builder_new();
    str_builder_add_cstr(path_sb, "/proc/");
    str_builder_add_int(path_sb, pid);
    str_builder_add_cstr(path_sb, "/stat");
    var path = str_builder_build(path_sb);
    var buf = alloc(4096);
    var n = file_read_all(str_data(path), buf, 4095);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    # Find ')' — fields are after the comm field
    var ci = 0;
    while (ci < n) {
        if (load8(buf + ci) == 41) { break; }  # ')'
        ci = ci + 1;
    }
    ci = ci + 2;  # skip ') '
    # utime is field 14 (0-indexed from start, 11th after comm)
    # stime is field 15 (12th after comm)
    var field = 0;
    var utime = 0;
    var stime = 0;
    while (ci < n) {
        # Skip whitespace
        while (ci < n) {
            if (load8(buf + ci) != 32) { break; }
            ci = ci + 1;
        }
        # Parse number
        var val = 0;
        while (ci < n) {
            var c = load8(buf + ci);
            if (c < 48) { break; }
            if (c > 57) { break; }
            val = val * 10 + c - 48;
            ci = ci + 1;
        }
        if (field == 11) { utime = val; }
        if (field == 12) { stime = val; }
        if (field > 12) { break; }
        field = field + 1;
    }
    # Convert ticks to ms (assume 100 Hz = 10ms per tick)
    return (utime + stime) * 10;
}

# Normalize a vector to unit length
fn normalize_vec(v, dim) {
    var mag_sq = f64_from(0);
    var ni = 0;
    while (ni < dim) {
        var x = load64(v + ni * 8);
        mag_sq = f64_add(mag_sq, f64_mul(x, x));
        ni = ni + 1;
    }
    var mag = f64_sqrt(mag_sq);
    var result = alloc(dim * 8);
    if (f64_eq(mag, f64_from(0)) == 1) {
        ni = 0;
        while (ni < dim) { store64(result + ni * 8, f64_from(0)); ni = ni + 1; }
    } else {
        ni = 0;
        while (ni < dim) {
            store64(result + ni * 8, f64_div(load64(v + ni * 8), mag));
            ni = ni + 1;
        }
    }
    return result;
}

# ⛔ 2.2.3 — `dir_list` takes a Str. Both counters below passed
# `str_data(path)`, a raw char pointer, so dir_list read the path's first
# sixteen BYTES as a Str header, opened a garbage path, and returned an empty
# vec: count_fds was always 0 and count_threads always 1.
#
# 2.2.0 recorded this as a stdlib procfs defect ("KNOWN GAP") on the strength
# of a control — `dir_list("/tmp")` enumerating fine — that was not a control.
# A string LITERAL passed to a `: Str` parameter is converted to a Str by the
# compiler; a `str_data(...)` expression is not. The control changed the
# argument's form along with the directory, and only the form mattered:
# measured, dir_list on /proc/<pid>/fd returns 4 entries given a Str and 0
# given str_data — and 0 for /tmp given str_data too.
fn count_fds(pid) {
    if (pid == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;   # agnos offers no way to count another process's descriptors
    #endif
    var path_sb = str_builder_new();
    str_builder_add_cstr(path_sb, "/proc/");
    str_builder_add_int(path_sb, pid);
    str_builder_add_cstr(path_sb, "/fd");
    var path = str_builder_build(path_sb);
    var entries = dir_list(path);
    if (entries == 0) { return 0; }
    return vec_len(entries);
}

fn count_threads(pid) {
    if (pid == 0) { return 1; }
    #ifdef CYRIUS_TARGET_AGNOS
    return 1;   # an agnos process is one thread
    #endif
    var path_sb = str_builder_new();
    str_builder_add_cstr(path_sb, "/proc/");
    str_builder_add_int(path_sb, pid);
    str_builder_add_cstr(path_sb, "/task");
    var path = str_builder_build(path_sb);
    var entries = dir_list(path);   # a Str — see count_fds
    if (entries == 0) { return 1; }
    var n = vec_len(entries);
    if (n == 0) { return 1; }
    return n;
}

# Update resource usage for an agent from /proc
fn agent_update_resources(h) {
    var pid = agent_pid(h);
    if (pid == 0) { return 0; }
    store64(h + 48, read_vm_rss(pid));
    store64(h + 64, count_fds(pid));
    store64(h + 72, count_threads(pid));
}

# Check if agent process is alive (kill -0)
fn agent_is_alive(h) {
    var pid = agent_pid(h);
    if (pid == 0) { return 0; }
    #ifdef CYRIUS_TARGET_AGNOS
    # kill#16 checks bounds and ownership, not whether the process lives.
    if (_agent_proc_word(pid) < 0) { return 0; }
    return 1;
    #endif
    var r = sys_kill(pid, 0);
    if (r == 0) { return 1; }
    return 0;
}

# Spawn an agent process — VULN-010: under resource limits.
#
# ⚠ prlimit64, NOT setrlimit. Through 2.1.5 this read `var SYS_SETRLIMIT = 160;`
# — the x86_64 number, declared unconditionally. On aarch64, 160 is `uname`, and
# it is not an ESYSXLAT row, so every daimon-aarch64 artifact ever shipped ran
# these two calls as `uname(<a small int>)`, got -EFAULT, did not check it, and
# exec'd the agent with NO RLIMIT_AS and NO RLIMIT_CPU. VULN-010 was silently
# off on that target (docs/development/issues/archive/2026-09-14-aarch64-binary-issues-
# x86-syscall-numbers.md).
#
# prlimit64 is the portable answer: the generic (aarch64) ABI supersedes
# get/setrlimit with it outright — asm-generic/unistd.h says so in a comment —
# and x86_64 has carried it since 2.6.36. One code path, one per-arch number
# (_DAIMON_SYS_PRLIMIT64, src/syscalls.cyr). `struct rlimit64` is {u64 cur, u64 max},
# the same 16-byte layout the old `struct rlimit` buffer already used, so the
# buffers below are unchanged.
#   prlimit64(pid, resource, new_limit, old_limit); pid 0 == calling process.
var RLIMIT_AS = 9;    # Address space
var RLIMIT_CPU = 0;   # CPU time in seconds

# The agent's channel is this fd inside the agent (2.3.3), announced as
# AGNOS_IPC_FD. 3 is the first descriptor after stdio — the convention systemd
# socket activation uses too (SD_LISTEN_FDS_START).
var AGENT_IPC_FD = 3;

# RLIMIT_NOFILE as daimon found it, {cur, max} (2.3.4). Every running agent
# holds one of daimon's descriptors (its channel; with --agent-output capture
# its output pipe too), and the loop keeps up to SERVE_MAX_CONNS connections
# open, so daimon raises its own soft limit to fit max_agents
# (agent_nofile_raise). Measured with the limit pinned at 1024 (systemd's
# default soft limit): with capture, the 507th start failed. Each agent is given
# this original limit back: a program that select()s cannot see a descriptor
# past 1023, the reason that default is low. Recorded before any agent is
# forked; the child only reads it.
var _agent_nofile: i64[2];
var _agent_nofile_set = 0;

# Raise daimon's soft RLIMIT_NOFILE to `want`, or to the hard limit if that is
# lower, and record the original for agents. Returns the soft limit in force.
fn agent_nofile_raise(want) {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0;
    #else
    var now: i64[2];
    if (syscall(_DAIMON_SYS_PRLIMIT64, 0, _DAIMON_RLIMIT_NOFILE, 0, &now) != 0) { return 0 - 1; }
    # The original is recorded once: a later call would otherwise record the
    # limit an earlier one raised (the test that asks twice caught exactly that).
    if (_agent_nofile_set == 0) {
        store64(&_agent_nofile, load64(&now));
        store64(&_agent_nofile + 8, load64(&now + 8));
        _agent_nofile_set = 1;
    }
    var cur = load64(&now);
    var max = load64(&now + 8);             # RLIM_INFINITY reads as -1
    if (cur < 0) { return cur; }            # already unlimited
    if (cur >= want) { return cur; }
    var target = want;
    if (max >= 0) {
        if (target > max) { target = max; }
    }
    var nl: i64[2];
    store64(&nl, target);
    store64(&nl + 8, max);
    if (syscall(_DAIMON_SYS_PRLIMIT64, 0, _DAIMON_RLIMIT_NOFILE, &nl, 0) != 0) { return cur; }
    return target;
    #endif
}

# 2.3.0 — the first time this runs for real (a route now reaches it), so it
# grew what a supervisor's spawn needs. `exe` is a NUL-terminated path; `argv`
# and `envp` are NULL-terminated arrays of NUL-terminated strings (argv[0] =
# exe; envp 0 = empty environment); mem_limit is bytes (RLIMIT_AS), cpu_limit
# seconds (RLIMIT_CPU), 0 = leave unlimited.
#
# `ipc_fd` (2.3.3) is the agent's end of its channel, or -1 for none: in the
# child it becomes fd AGENT_IPC_FD and every other inherited descriptor is closed.
# (-1, not 0: a daimon started with stdin closed can be handed fd 0 by socketpair.)
# `out_fd` (2.3.4) is the write end of a pipe for the agent's stdout AND stderr
# (`serve --agent-output capture`), or -1 to leave them daimon's.
#
# Returns Ok(pid) only once the child has EXEC'D. Anything that stops it first
# comes back as Err(AGENT_OP_*): the child reports {reason, errno} down a
# close-on-exec pipe, whose read returns EOF the moment execve succeeds. (The
# Rust original got this from std's Command::spawn, which uses the same pipe.)
# Before 2.3.0 a missing executable looked like a successful start, and only a
# later exit status of 127 told the difference.
fn agent_spawn_with_limits(exe, argv, envp, mem_limit, cpu_limit, ipc_fd, out_fd) {
    return _agent_spawn(exe, argv, envp, mem_limit, cpu_limit, ipc_fd, out_fd, 0);
}

# agent_spawn_with_limits, plus `cg_procs`: the cgroup.procs of a cgroup the child
# moves itself into before it execs (2.4.2; 0 for none). agent_start's path.
fn _agent_spawn(exe, argv, envp, mem_limit, cpu_limit, ipc_fd, out_fd, cg_procs) {
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(AGENT_OP_UNSUPPORTED);
    #else
    # Everything the child uses is built here, BEFORE the fork, so the child runs
    # straight-line syscalls from fork to exec.
    var rlim_as = alloc(16);
    store64(rlim_as, mem_limit);
    store64(rlim_as + 8, mem_limit);
    var rlim_cpu = alloc(16);
    store64(rlim_cpu, cpu_limit);
    store64(rlim_cpu + 8, cpu_limit);

    var pfd: i32[2];
    if (syscall(_DAIMON_SYS_PIPE2, &pfd, _DAIMON_O_CLOEXEC) != 0) {
        return Err(AGENT_OP_NO_PROCESS);
    }
    _agent_daimon_pid = sys_getpid();   # the child checks it still has this parent
    var rfd = load32(&pfd);
    var wfd = load32(&pfd + 4);

    # sys_fork() (not raw syscall(SYS_FORK)) for arch portability: x86_64
    # wraps SYS_FORK, aarch64 — which has no fork(2) — wraps clone(SIGCHLD)
    # via SYS_CLONE. Both return child-pid-in-parent / 0-in-child / -1-on-error.
    var pid = sys_fork();
    if (pid < 0) {
        sys_close(rfd);
        sys_close(wfd);
        return Err(AGENT_OP_NO_PROCESS);
    }
    if (pid == 0) {
        _agent_child(exe, argv, envp, rlim_as, mem_limit, rlim_cpu, cpu_limit, rfd, wfd, ipc_fd, out_fd, cg_procs);
    }

    sys_close(wfd);
    var rep: i64[1];
    store64(&rep, 0);
    var n = sys_read(rfd, &rep, 8);
    while (n == 0 - 4) { n = sys_read(rfd, &rep, 8); }   # EINTR
    sys_close(rfd);
    if (n > 0) {
        # The child reported and is exiting; collect it so it is not a zombie.
        daimon_reap_within(pid, DAIMON_REAP_BUDGET_MS);
        return Err(load32(&rep));
    }
    return Ok(pid);
    #endif
}

# daimon's pid at the fork (2.3.4), read by the child: see _agent_child.
var _agent_daimon_pid = 0;

# Host-only: agnos has no fork/execve/dup2 (its spawn is sys_spawn_path, 2.4.x),
# and agent_spawn_with_limits's agnos arm never reaches these.
#ifndef CYRIUS_TARGET_AGNOS
# The child's half, from fork to execve. It never returns: it execs, or writes
# {reason, errno} to the report pipe and exits 126 (limits) / 127 (exec) — the
# codes that still tell the two apart if the report is ever lost.
fn _agent_child(exe, argv, envp, rlim_as, mem_limit, rlim_cpu, cpu_limit, rfd, wfd, ipc_fd, out_fd, cg_procs) {
    sys_close(rfd);

    # 2.3.4 — the agent leads its own process group, so a stop, pause or resume
    # reaches the processes it starts (daimon_signal_tree); a stop used to leave
    # them running. And it dies with daimon: PR_SET_PDEATHSIG. The registry is
    # in memory, so an agent that outlived daimon could never be reached again.
    # If daimon was already gone when the prctl ran, the signal was never armed:
    # the parent check catches that window.
    syscall(_DAIMON_SYS_SETPGID, 0, 0);
    sys_prctl(_DAIMON_PR_SET_PDEATHSIG, SIGKILL, 0, 0, 0);
    if (sys_getppid() != _agent_daimon_pid) { sys_exit(127); }

    # 2.4.2 — into the agent's own cgroup, before anything it starts can exist, so
    # a stop reaches a process that leaves the group (setsid). "0" moves the
    # writer. A failure is not fatal: the parent checks where the agent is, and
    # reports it (agent_contained).
    if (cg_procs != 0) {
        var cgf = sys_open(cg_procs, 1, 0);   # O_WRONLY
        if (cgf >= 0) {
            sys_write(cgf, "0", 1);
            sys_close(cgf);
        }
    }

    # The agent's channel (2.3.3) becomes fd AGENT_IPC_FD, and its output pipe
    # (2.3.4) fds 1 and 2. The report pipe, the channel and the output pipe are
    # first moved above 9 (F_DUPFD_CLOEXEC), so no dup2 onto 1-3 can land on one
    # of them: dup2(3, 3) would leave close-on-exec set, and on aarch64 sys_dup2
    # is dup3, for which (3, 3) is EINVAL.
    var first_closed = 3;
    if (ipc_fd >= 0 || out_fd >= 0) {
        var w2 = syscall(SYS_FCNTL, wfd, _DAIMON_F_DUPFD_CLOEXEC, 10);
        if (w2 < 0) { _agent_child_fail(wfd, AGENT_OP_NO_PROCESS, 0 - w2, 127); }
        wfd = w2;
    }
    var c2 = 0 - 1;
    var o2 = 0 - 1;
    if (ipc_fd >= 0) {
        c2 = syscall(SYS_FCNTL, ipc_fd, _DAIMON_F_DUPFD_CLOEXEC, 10);
        if (c2 < 0) { _agent_child_fail(wfd, AGENT_OP_NO_PROCESS, 0 - c2, 127); }
    }
    if (out_fd >= 0) {
        o2 = syscall(SYS_FCNTL, out_fd, _DAIMON_F_DUPFD_CLOEXEC, 10);
        if (o2 < 0) { _agent_child_fail(wfd, AGENT_OP_NO_PROCESS, 0 - o2, 127); }
    }
    if (c2 >= 0) {
        if (sys_dup2(c2, AGENT_IPC_FD) < 0) { _agent_child_fail(wfd, AGENT_OP_NO_PROCESS, 0, 127); }
        first_closed = AGENT_IPC_FD + 1;
    }
    if (o2 >= 0) {
        if (sys_dup2(o2, 1) < 0) { _agent_child_fail(wfd, AGENT_OP_NO_PROCESS, 0, 127); }
        if (sys_dup2(o2, 2) < 0) { _agent_child_fail(wfd, AGENT_OP_NO_PROCESS, 0, 127); }
    }

    # Descriptors. lib/net.cyr's tcp_socket and sock_accept do not set
    # close-on-exec, so without this every agent inherited daimon's LISTENING
    # socket and the connection of the client that asked for the start.
    _agent_close_inherited(first_closed, wfd);
    var nul = sys_open("/dev/null", 0, 0);   # O_RDONLY: stdin, as Rust's Stdio::null()
    if (nul > 0) {
        sys_dup2(nul, 0);
        sys_close(nul);
    }

    # daimon ignores SIGPIPE (src/main.cyr), and an IGNORED disposition survives
    # execve. Reset it, as std::process::Command does (lib/syscalls.cyr says why).
    signal_default(SIGPIPE);

    # VULN-010: CHECKED. prlimit64 returns 0 or -errno, and an agent that cannot
    # be confined is not run at all.
    if (mem_limit > 0) {
        var ra = syscall(_DAIMON_SYS_PRLIMIT64, 0, RLIMIT_AS, rlim_as, 0);
        if (ra != 0) { _agent_child_fail(wfd, AGENT_OP_NO_LIMITS, 0 - ra, 126); }
    }
    if (cpu_limit > 0) {
        var rc = syscall(_DAIMON_SYS_PRLIMIT64, 0, RLIMIT_CPU, rlim_cpu, 0);
        if (rc != 0) { _agent_child_fail(wfd, AGENT_OP_NO_LIMITS, 0 - rc, 126); }
    }
    # The descriptor limit daimon started with, not the one it raised for
    # itself (agent_nofile_raise). Lowering a soft limit cannot fail; if it did,
    # the agent would merely keep daimon's, so it is not a reason to refuse it.
    if (_agent_nofile_set == 1) {
        syscall(_DAIMON_SYS_PRLIMIT64, 0, _DAIMON_RLIMIT_NOFILE, &_agent_nofile, 0);
    }

    var er = sys_execve(exe, argv, envp);
    _agent_child_fail(wfd, AGENT_OP_NO_EXEC, 0 - er, 127);
    return 0;
}

fn _agent_child_fail(wfd, reason, err, code) {
    var rep: i64[1];
    store32(&rep, reason);
    store32(&rep + 4, err);
    sys_write(wfd, &rep, 8);
    sys_exit(code);
    return 0;
}

# Close every descriptor from `first` up (3, or 4 when fd 3 is the agent's
# channel), except `keep` (the report pipe, which close-on-exec closes at
# execve). close_range is Linux 5.9+; before that, one close per descriptor below
# the soft RLIMIT_NOFILE, which no descriptor can reach (bounded by 2^20, the
# kernel's default fs.nr_open, if the limit reads as unlimited).
fn _agent_close_inherited(first, keep) {
    var ok = 1;
    if (keep > first) {
        if (syscall(_DAIMON_SYS_CLOSE_RANGE, first, keep - 1, 0) != 0) { ok = 0; }
    }
    if (ok == 1) {
        if (syscall(_DAIMON_SYS_CLOSE_RANGE, keep + 1, 0xFFFFFFFF, 0) != 0) { ok = 0; }
    }
    if (ok == 1) { return 0; }
    var lim: i64[2];
    var top = 1024;
    if (syscall(_DAIMON_SYS_PRLIMIT64, 0, _DAIMON_RLIMIT_NOFILE, 0, &lim) == 0) {
        top = load64(&lim);
    }
    if (top <= 0) { top = 1048576; }
    if (top > 1048576) { top = 1048576; }
    var f = first;
    while (f < top) {
        if (f != keep) { sys_close(f); }
        f = f + 1;
    }
    return 0;
}
#endif

# --- containment: a cgroup per agent (2.4.2) ----------------------------------
#
# A stop reaches the agent's process group (2.3.4), and a process that calls
# setsid leaves the group. Measured on 2.4.1: an agent's `setsid sleep` was still
# running after its stop answered. Where daimon's own cgroup (cgroup v2) is its to
# divide, each start of an agent runs in a cgroup of its own:
#     /sys/fs/cgroup<daimon's cgroup>/daimon-<pid>/agent-<id>-<run>
# Examples are a systemd service with Delegate=yes, or anything the user's systemd
# runs (`systemd-run --user`).
# - The agent moves itself in between fork and exec, so nothing it starts is ever
#   outside.
# - A stop, pause or resume signals every process in it. SIGKILL is cgroup.kill.
# - When the agent's process is collected, whatever it left gets a stop's
#   courtesy: SIGTERM, AGENT_STOP_GRACE_MS, then cgroup.kill. The cgroup is then
#   removed (agent_cgroups_tick).
# - A daimon that died left its daimon-<pid>; the next daimon in the same cgroup
#   ends what is in it and removes it.
# Where daimon cannot make cgroups (its cgroup is root's, cgroup v1, agnos),
# agents run as before. That is audited once (agent.cgroup.unavailable), and an
# agent's JSON says "contained":false.

var _agent_cg_state = 0;   # 0 not tried, 1 available, 2 unavailable
var _agent_cg_base = 0;    # cstr "/sys/fs/cgroup<daimon's cgroup>/daimon-<pid>"
var _agent_cg_run = 0;     # a new cgroup per start: agent-<id>-<run>

# Cgroups waiting to be removed: {directory cstr, the time its members get
# cgroup.kill (0 once they have), tries at removing the cgroups an agent made
# inside it}. agent_cgroups_tick works through them.
var AGENT_CG_DRAIN_MAX = 256;
#ifndef CYRIUS_TARGET_AGNOS
var _agent_cg_drain: i64[768];   # agnos has no cgroups
#endif
var _agent_cg_drain_n = 0;
var AGENT_CG_PRUNE_TRIES = 3;    # each walk allocates: bounded
var AGENT_CG_PRUNE_DEPTH = 16;   # levels of cgroups inside an agent's

# Whether agents are contained here: 1 yes, 2 no. The first call decides and
# says so; serve calls it at startup.
fn agent_cgroup_init() {
    if (_agent_cg_state != 0) { return _agent_cg_state; }
    _agent_cg_state = 2;
    #ifndef CYRIUS_TARGET_AGNOS
    var own = _agent_cg_own();
    if (own == 0) { return _agent_cg_unavailable("daimon is not in a cgroup v2 hierarchy"); }
    _agent_cg_sweep(own);
    # Moving the agent needs write access to the cgroup.procs of daimon's cgroup
    # (the common ancestor of where it is and where it goes), not only a mkdir.
    if (sys_access(_agent_cg_path(own, "cgroup.procs"), 2) != 0) {   # W_OK
        return _agent_cg_unavailable("daimon may not move processes out of its cgroup");
    }
    var bb = str_builder_new();
    str_builder_add_cstr(bb, own);
    str_builder_add_cstr(bb, "/daimon-");
    str_builder_add_int(bb, sys_getpid());
    var base = str_data(str_builder_build(bb));
    var r = sys_mkdir(base, 493);   # 0755
    if (r != 0 && r != 0 - EEXIST) { return _agent_cg_unavailable("daimon cannot make cgroups in its own"); }
    _agent_cg_base = base;
    _agent_cg_state = 1;
    #endif
    return _agent_cg_state;
}

fn _agent_cg_unavailable(why) {
    sakshi_warn("agents are not contained: a process an agent starts can outlive its stop", 72);
    daimon_audit(SEV_WARNING, "agent", "agent.cgroup.unavailable", why);
    return 2;
}

# The agent's cgroup is left to be removed (its process has been collected).
# What is still in it gets SIGTERM now and cgroup.kill after AGENT_STOP_GRACE_MS.
fn _agent_cg_release(h) {
    var dir = agent_cgroup_dir(h);
    store64(h + 120, 0);
    store64(h + 128, 0);
    if (dir == 0) { return 0; }
    #ifndef CYRIUS_TARGET_AGNOS
    if (sys_rmdir(dir) == 0) { return 0; }
    # Nothing runs there, but the agent made cgroups inside it: those go first.
    if (_agent_cg_populated(dir) == 0) {
        if (_agent_cg_remove_tree(dir, AGENT_CG_PRUNE_DEPTH) == 1) { return 0; }
    }
    daimon_audit_agent(SEV_INFO, "agent", "agent.cgroup.leftover",
      "the agent's process is gone and it left processes behind: they are being stopped",
      str_data(agent_name(h)));
    _agent_cg_signal(dir, SIGTERM);
    _agent_cg_queue(dir, daimon_now_ms() + AGENT_STOP_GRACE_MS);
    #endif
    return 0;
}

# The event loop's upkeep: remove the cgroups whose members are gone, and give
# cgroup.kill to those past their grace. It allocates only to remove cgroups an
# agent made inside its own, at most AGENT_CG_PRUNE_TRIES times per cgroup.
fn agent_cgroups_tick(now) {
    #ifndef CYRIUS_TARGET_AGNOS
    var i = 0;
    while (i < _agent_cg_drain_n) {
        var e = &_agent_cg_drain + i * 24;
        var dir = load64(e);
        var at = load64(e + 8);
        var gone = 0;
        var r = sys_rmdir(dir);
        if (r == 0 || r == 0 - ENOENT) {
            gone = 1;
        } elif (load64(e + 16) < AGENT_CG_PRUNE_TRIES && _agent_cg_populated(dir) == 0) {
            # Nothing runs in it or below it, and it cannot be removed: it holds
            # cgroups the agent made. Those go first.
            store64(e + 16, load64(e + 16) + 1);
            gone = _agent_cg_remove_tree(dir, AGENT_CG_PRUNE_DEPTH);
        }
        if (gone == 1) {
            _agent_cg_drain_n = _agent_cg_drain_n - 1;
            var last = &_agent_cg_drain + _agent_cg_drain_n * 24;
            store64(e, load64(last));
            store64(e + 8, load64(last + 8));
            store64(e + 16, load64(last + 16));
        } else {
            if (at != 0 && now >= at) {
                _agent_cg_signal(dir, SIGKILL);
                store64(e + 8, 0);
                daimon_audit(SEV_WARNING, "agent", "agent.cgroup.kill",
                  "processes an agent left did not stop within the grace period: cgroup.kill");
            }
            i = i + 1;
        }
    }
    #endif
    return 0;
}

# Cgroups waiting to be removed.
fn agent_cgroups_pending() { return _agent_cg_drain_n; }

#ifndef CYRIUS_TARGET_AGNOS
# "<dir>/<name>", a new cstr.
fn _agent_cg_path(dir, name) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, name);
    return str_data(str_builder_build(sb));
}

var _agent_cg_buf = 0;   # a cgroup.procs or a /proc/<pid>/cgroup, read (16 KiB)

# daimon's own cgroup as "/sys/fs/cgroup<path>" (a cstr); 0 when there is none.
fn _agent_cg_own() { return _agent_cg_of("/proc/self/cgroup"); }

# The cgroup that `file` (a /proc/<pid>/cgroup) names on its cgroup v2 line
# ("0::<path>"), as "/sys/fs/cgroup<path>" (a cstr); 0 when there is none.
fn _agent_cg_of(file) {
    if (_agent_cg_buf == 0) { _agent_cg_buf = alloc(16384); }
    var buf = _agent_cg_buf;
    var n = file_read_all(file, buf, 16383);
    if (n <= 0) { return 0; }
    store8(buf + n, 0);
    var i = 0;
    while (i + 3 <= n) {
        if (memeq(buf + i, "0::", 3) == 1) {
            var e = i + 3;
            while (e < n && load8(buf + e) != 10) { e = e + 1; }
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "/sys/fs/cgroup");
            var k = i + 3;
            while (k < e) {
                str_builder_add_byte(sb, load8(buf + k));
                k = k + 1;
            }
            var at = str_data(str_builder_build(sb));
            if (e - (i + 3) == 1) { at = "/sys/fs/cgroup"; }   # "/": the namespace's root
            return at;
        }
        while (i < n && load8(buf + i) != 10) { i = i + 1; }
        i = i + 1;
    }
    return 0;
}

# Signal every process in cgroup `dir`. SIGKILL is cgroup.kill (Linux 5.14+,
# atomic, and it reaches processes forked meanwhile), or one kill per member.
fn _agent_cg_signal(dir, sig) {
    if (sig == SIGKILL) {
        var kf = sys_open(_agent_cg_path(dir, "cgroup.kill"), 1, 0);   # O_WRONLY
        if (kf >= 0) {
            var w = sys_write(kf, "1", 1);
            sys_close(kf);
            if (w == 1) { return 0; }
        }
    }
    if (_agent_cg_buf == 0) { _agent_cg_buf = alloc(16384); }
    var n = file_read_all(_agent_cg_path(dir, "cgroup.procs"), _agent_cg_buf, 16383);
    if (n <= 0) { return 0; }
    var self = sys_getpid();
    var i = 0;
    var pid = 0;
    while (i < n) {
        var c = load8(_agent_cg_buf + i);
        if (c >= 48 && c <= 57) {
            pid = pid * 10 + c - 48;
        } else {
            if (pid > 1 && pid != self) { sys_kill(pid, sig); }
            pid = 0;
        }
        i = i + 1;
    }
    if (pid > 1 && pid != self) { sys_kill(pid, sig); }
    return 0;
}

# 1 if process `pid` is in cgroup `dir`, read from /proc/<pid>/cgroup. That
# still names the cgroup after the process exits, until it is collected, and
# cgroup.procs does not: an agent that exited before daimon looked was taken
# for one that never entered, and what it left there was out of reach.
fn _agent_cg_in(dir, pid) {
    var pb = str_builder_new();
    str_builder_add_cstr(pb, "/proc/");
    str_builder_add_int(pb, pid);
    str_builder_add_cstr(pb, "/cgroup");
    var at = _agent_cg_of(str_data(str_builder_build(pb)));
    if (at == 0) { return 0; }
    return streq(at, dir);
}

fn _agent_cg_queue(dir, kill_at) {
    if (_agent_cg_drain_n >= AGENT_CG_DRAIN_MAX) {
        _agent_cg_signal(dir, SIGKILL);   # no room to wait: end them now
        return 0;
    }
    var e = &_agent_cg_drain + _agent_cg_drain_n * 24;
    store64(e, dir);
    store64(e + 8, kill_at);
    store64(e + 16, 0);
    _agent_cg_drain_n = _agent_cg_drain_n + 1;
    return 0;
}

# 0 once nothing runs in cgroup `dir` or below it (cgroup.events says
# "populated 0"); 1 while something does, or when it cannot be read. It
# allocates nothing: the loop's upkeep reads it.
fn _agent_cg_populated(dir) {
    if (_agent_cg_buf == 0) { _agent_cg_buf = alloc(16384); }
    var n = strlen(dir);
    if (n + 15 > 4096) { return 1; }
    memcpy(_agent_cg_buf, dir, n);
    memcpy(_agent_cg_buf + n, "/cgroup.events", 15);   # with its NUL
    var ev = _agent_cg_buf + 4096;
    var m = file_read_all(_agent_cg_buf, ev, 4095);
    var i = 0;
    while (i + 11 <= m) {
        if (memeq(ev + i, "populated 0", 11) == 1) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Remove cgroup `dir` and the cgroups inside it, deepest first, down to `depth`
# levels. 1 once it is gone. An agent may make cgroups inside its own, and a
# cgroup holding one cannot be removed.
fn _agent_cg_remove_tree(dir, depth) {
    var r = sys_rmdir(dir);
    if (r == 0 || r == 0 - ENOENT) { return 1; }
    if (depth <= 0) { return 0; }
    var names = dir_list(str_from(dir));
    var i = 0;
    while (i < vec_len(names)) {
        var nm = str_data(vec_get(names, i));
        if (memeq(nm, "cgroup.", 7) == 0) {   # not one of the cgroup's own files
            var sub = _agent_cg_path(dir, nm);
            if (is_dir(str_from(sub)) == 1) { _agent_cg_remove_tree(sub, depth - 1); }
        }
        i = i + 1;
    }
    r = sys_rmdir(dir);
    if (r == 0 || r == 0 - ENOENT) { return 1; }
    return 0;
}

# A cgroup for one start of agent `id`: its cgroup.procs path, for the child, or
# 0 if none could be made. The directory is stored in the handle.
fn _agent_cg_prepare(h) {
    if (agent_cgroup_init() != 1) { return 0; }
    _agent_cg_run = _agent_cg_run + 1;
    var db = str_builder_new();
    str_builder_add_cstr(db, _agent_cg_base);
    str_builder_add_cstr(db, "/agent-");
    str_builder_add_int(db, agent_id(h));
    str_builder_add_cstr(db, "-");
    str_builder_add_int(db, _agent_cg_run);
    var dir = str_data(str_builder_build(db));
    if (sys_mkdir(dir, 493) != 0) {
        daimon_audit_agent(SEV_WARNING, "agent", "agent.cgroup.fail",
          "no cgroup could be made for the agent: it runs uncontained", str_data(agent_name(h)));
        return 0;
    }
    store64(h + 120, dir);
    return _agent_cg_path(dir, "cgroup.procs");
}

# After the start (`pid`, or 0 when there was none): is the agent's process in
# its cgroup?
fn _agent_cg_confirm(h, pid) {
    var dir = agent_cgroup_dir(h);
    if (dir == 0) { return 0; }
    if (pid > 0) {
        if (_agent_cg_in(dir, pid) == 1) {
            store64(h + 128, 1);
            return 1;
        }
        daimon_audit_agent(SEV_WARNING, "agent", "agent.cgroup.fail",
          "the agent did not enter its cgroup: it runs uncontained", str_data(agent_name(h)));
        # Removed if empty. If not, the agent moved out after entering, and what
        # it left there goes when it does (_agent_cg_release).
        if (sys_rmdir(dir) == 0) { store64(h + 120, 0); }
        return 0;
    }
    # No start. Its child has been collected; one still exiting is waited for.
    store64(h + 120, 0);
    if (sys_rmdir(dir) != 0) { _agent_cg_queue(dir, daimon_now_ms() + AGENT_STOP_GRACE_MS); }
    return 0;
}

# The cgroups a daimon that is gone left in `own` (daimon-<pid>, the pid dead or
# ours): their members are ended and the cgroups queued for removal.
fn _agent_cg_sweep(own) {
    var names = dir_list(str_from(own));
    var self = sys_getpid();
    var i = 0;
    while (i < vec_len(names)) {
        var nm = str_data(vec_get(names, i));
        if (memeq(nm, "daimon-", 7) == 1) {
            var p = 0;
            var k = 7;
            var digits = 1;
            while (load8(nm + k) != 0) {
                var c = load8(nm + k);
                if (c < 48 || c > 57) { digits = 0; }
                else { p = p * 10 + c - 48; }
                k = k + 1;
            }
            if (digits == 1 && k > 7) {
                var stale = 0;
                if (p == self) { stale = 1; }
                elif (sys_kill(p, 0) == 0 - ESRCH) { stale = 1; }
                if (stale == 1) {
                    var dd = _agent_cg_path(own, nm);
                    var kids = dir_list(str_from(dd));
                    var j = 0;
                    while (j < vec_len(kids)) {
                        var kn = str_data(vec_get(kids, j));
                        if (memeq(kn, "agent-", 6) == 1) {
                            var kd = _agent_cg_path(dd, kn);
                            _agent_cg_signal(kd, SIGKILL);
                            _agent_cg_queue(kd, 0);
                        }
                        j = j + 1;
                    }
                    # Our own pid's (a dead daimon's, reused) is the base we are about
                    # to use: its agent cgroups go, it stays.
                    if (p != self) { _agent_cg_queue(dd, 0); }
                }
            }
        }
        i = i + 1;
    }
    return 0;
}
#endif

# Signal the agent: its process and group (daimon_signal_tree), and, when it is
# contained, every process in its cgroup (2.4.2). Returns the process's result.
fn _agent_signal_all(h, sig) {
    var r = daimon_signal_tree(agent_pid(h), sig);
    #ifndef CYRIUS_TARGET_AGNOS
    if (agent_contained(h) == 1) { _agent_cg_signal(agent_cgroup_dir(h), sig); }
    #endif
    return r;
}

# daimon's environment as an envp for execve. Agents inherit it, as they did in
# the Rust original (tokio's Command passes the parent's environment). Read
# once — /proc/self/environ is fixed at exec — and to EOF, however large. If it
# cannot be read the agent gets an EMPTY environment rather than no start.
var _agent_envp = 0;

fn agent_environ() {
    if (_agent_envp != 0) { return _agent_envp; }
    var cap = 16384;
    var blob = alloc(cap);
    var n = 0;
    var fd = sys_open("/proc/self/environ", 0, 0);
    if (fd >= 0) {
        var more = 1;
        while (more == 1) {
            if (n == cap) {
                var bigger = alloc(cap * 2);
                memcpy(bigger, blob, n);
                blob = bigger;
                cap = cap * 2;
            }
            var got = sys_read(fd, blob + n, cap - n);
            if (got <= 0) { more = 0; }
            else { n = n + got; }
        }
        sys_close(fd);
    }
    # Entries are NUL-terminated, one after another.
    var count = 0;
    var i = 0;
    while (i < n) {
        if (load8(blob + i) == 0) { count = count + 1; }
        i = i + 1;
    }
    var envp = alloc((count + 1) * 8);
    var ei = 0;
    var start = 0;
    i = 0;
    while (i < n) {
        if (load8(blob + i) == 0) {
            store64(envp + ei * 8, blob + start);
            ei = ei + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    store64(envp + ei * 8, 0);
    _agent_envp = envp;
    return envp;
}

# Where an agent's stdout and stderr go (2.3.4). INHERIT (the default, as since
# 2.3.0): daimon's own, so they land wherever daimon's do (its journal). CAPTURE
# (`serve --agent-output capture`): a pipe the event loop reads into a ring of
# AGENT_OUTPUT_RING bytes per agent (src/ipc.cyr), served at
# GET /v1/agents/{id}/output. The Rust original piped both and never read them:
# an agent that wrote more than a pipe holds (64 KiB) blocked forever.
var AGENT_OUTPUT_INHERIT = 0;
var AGENT_OUTPUT_CAPTURE = 1;
var _agent_output_mode = 0;

fn agent_set_output_mode(mode) {
    _agent_output_mode = mode;
    return 0;
}

fn agent_output_mode() { return _agent_output_mode; }

# Which of daimon's environment agents get (2.3.4, VULN-015): all of it
# (inherit, the default and the Rust original's behaviour), or only the
# variables a program needs to run (minimal, `serve --agent-env minimal`), which
# keeps daimon's own secrets — tokens, credentials — out of every agent.
var AGENT_ENV_INHERIT = 0;
var AGENT_ENV_MINIMAL = 1;
var _agent_env_mode = 0;

fn agent_set_env_mode(mode) {
    _agent_env_mode = mode;
    _agent_envp_ipc = 0;   # rebuilt on the next start
    return 0;
}

fn _agent_env_is(e, n, prefix) {
    var pl = strlen(prefix);
    if (n < pl) { return 0; }
    return memeq(e, prefix, pl);
}

# 1 if `e` ("NAME=value") is one a minimal environment keeps: what a program
# needs to find its tools, its home and its locale, and AGNOS's own variables.
fn _agent_env_keep(e) {
    var n = strlen(e);
    if (_agent_env_is(e, n, "PATH=") == 1) { return 1; }
    if (_agent_env_is(e, n, "HOME=") == 1) { return 1; }
    if (_agent_env_is(e, n, "USER=") == 1) { return 1; }
    if (_agent_env_is(e, n, "LOGNAME=") == 1) { return 1; }
    if (_agent_env_is(e, n, "SHELL=") == 1) { return 1; }
    if (_agent_env_is(e, n, "TERM=") == 1) { return 1; }
    if (_agent_env_is(e, n, "TMPDIR=") == 1) { return 1; }
    if (_agent_env_is(e, n, "TZ=") == 1) { return 1; }
    if (_agent_env_is(e, n, "LANG=") == 1) { return 1; }
    if (_agent_env_is(e, n, "LANGUAGE=") == 1) { return 1; }
    if (_agent_env_is(e, n, "LC_") == 1) { return 1; }
    if (_agent_env_is(e, n, "XDG_RUNTIME_DIR=") == 1) { return 1; }
    if (_agent_env_is(e, n, "AGNOS_") == 1) { return 1; }
    return 0;
}

# An agent's environment: daimon's own (agent_environ), or its minimal part,
# minus any AGNOS_IPC_FD daimon was itself given, plus
# AGNOS_IPC_FD=<AGENT_IPC_FD>. Built once per mode.
var _agent_envp_ipc = 0;

fn agent_environ_ipc() {
    if (_agent_envp_ipc != 0) { return _agent_envp_ipc; }
    var base = agent_environ();
    var n = 0;
    while (load64(base + n * 8) != 0) { n = n + 1; }
    var envp = alloc((n + 2) * 8);
    var o = 0;
    var i = 0;
    while (i < n) {
        var e = load64(base + i * 8);
        var drop = 0;
        # daimon's own AGNOS_IPC_FD, if it was given one, is replaced below.
        if (strlen(e) >= 13) { if (memeq(e, "AGNOS_IPC_FD=", 13) == 1) { drop = 1; } }
        if (_agent_env_mode == AGENT_ENV_MINIMAL) {
            if (_agent_env_keep(e) == 0) { drop = 1; }
        }
        if (drop == 0) {
            store64(envp + o * 8, e);
            o = o + 1;
        }
        i = i + 1;
    }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "AGNOS_IPC_FD=");
    str_builder_add_int(sb, AGENT_IPC_FD);
    store64(envp + o * 8, str_data(str_builder_build(sb)));
    store64(envp + (o + 1) * 8, 0);
    _agent_envp_ipc = envp;
    return envp;
}

# --- Where agent executables live ---
#
# The Rust original ran `agnos-agent-<type>-agent` from the first of
# /usr/lib/agnos/agents, /opt/agnos/agents and ./agents that had one, else
# /usr/bin/agnos-agent-runner. daimon keeps the two absolute directories and the
# fallback, and DROPS ./agents: a working-directory-relative search lets whoever
# controls daimon's cwd choose what it executes, and cwd is not something daimon
# controls (the 2.1.7 VERSION bug).
#
# ⛔ The executable is NEVER taken from a request. A request picks a TYPE, one
# of three constants; the path is built from daimon's own strings. Anything else
# on an unauthenticated API is remote code execution.
#
# `serve --agents-dir <dir>` (the operator's choice) replaces the whole search:
# the type's executable is looked for in <dir> alone, and the generic runner is
# <dir>/agnos-agent-runner.
var _agents_dir = 0;    # cstr, or 0 for the defaults

fn agent_set_agents_dir(dir) { _agents_dir = dir; }

fn _agent_type_slug(t) {
    if (t == AGENT_TYPE_SYSTEM) { return "system"; }
    if (t == AGENT_TYPE_SERVICE) { return "service"; }
    return "user";
}

# 1 if `path` names a file daimon can run. agnos (2.4.0) has no access() (the
# cyrius peer's sys_access is a stub that always fails, so no executable was ever
# found there) and no execute permission: a file that stat#33 finds is runnable.
fn _agent_runnable(path) {
    #ifdef CYRIUS_TARGET_AGNOS
    var st: u8[48];
    if (sys_stat(path, strlen(path), &st) == 0) { return 1; }
    return 0;
    #else
    if (sys_access(path, 1) == 0) { return 1; }   # X_OK
    return 0;
    #endif
}

# <dir>/<file> if it exists and is executable, else 0.
fn _agent_exe_in(dir, file) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, dir);
    str_builder_add_cstr(sb, "/");
    str_builder_add_cstr(sb, file);
    var p = str_data(str_builder_build(sb));   # builder output is NUL-terminated
    if (_agent_runnable(p) == 1) { return p; }
    return 0;
}

# The executable for an agent type (a NUL-terminated path), or 0 if none is
# installed.
fn agent_find_executable(t) {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "agnos-agent-");
    str_builder_add_cstr(sb, _agent_type_slug(t));
    str_builder_add_cstr(sb, "-agent");
    var file = str_data(str_builder_build(sb));
    if (_agents_dir != 0) {
        var own = _agent_exe_in(_agents_dir, file);
        if (own != 0) { return own; }
        return _agent_exe_in(_agents_dir, "agnos-agent-runner");
    }
    var p = _agent_exe_in("/usr/lib/agnos/agents", file);
    if (p != 0) { return p; }
    p = _agent_exe_in("/opt/agnos/agents", file);
    if (p != 0) { return p; }
    if (_agent_runnable("/usr/bin/agnos-agent-runner") == 1) { return "/usr/bin/agnos-agent-runner"; }
    return 0;
}

# Start an agent's process: the executable for its type, run as
#     <exe> --agent-id <id> --agent-name <name>
# (the Rust original's argv), under the given limits (see
# agent_spawn_with_limits). Startable from PENDING, STOPPED and FAILED — a
# FAILED agent's process is already gone (agent_reap cleared its pid), so there
# is nothing to stop first. (The Rust original refused FAILED and restarted
# through stop; daimon's API has no restart, and stop-then-start for a process
# that no longer exists would be ceremony.) Returns Ok(pid) or Err(AGENT_OP_*).
fn agent_start(h, mem_limit, cpu_secs) {
    var status = agent_status(h);
    if (status != AGENT_PENDING) {
        if (status != AGENT_STOPPED) {
            if (status != AGENT_FAILED) { return Err(AGENT_OP_BAD_STATE); }
        }
    }
    #ifdef CYRIUS_TARGET_AGNOS
    return _agent_start_agnos(h);
    #else
    var exe = agent_find_executable(agent_type(h));
    if (exe == 0) { return Err(AGENT_OP_NO_EXECUTABLE); }

    var id_sb = str_builder_new();
    str_builder_add_int(id_sb, agent_id(h));
    var id_str = str_builder_build(id_sb);
    var argv = alloc(48);
    store64(argv, exe);
    store64(argv + 8, "--agent-id");
    store64(argv + 16, str_data(id_str));        # builder output: NUL-terminated
    store64(argv + 24, "--agent-name");
    store64(argv + 32, str_cstr(agent_name(h))); # execve reads to a NUL — make sure there is one
    store64(argv + 40, 0);

    # The agent's channel (2.3.3): [0] stays with daimon, [1] becomes the agent's
    # fd AGENT_IPC_FD. An agent that cannot have one is not started.
    var chfds: i32[2];
    if (ipc_channel_open(&chfds) != 0) { return Err(AGENT_OP_NO_PROCESS); }
    var own_end = load32(&chfds);
    var agent_end = load32(&chfds + 4);
    # Its output pipe, when daimon captures output (2.3.4): [0] daimon reads,
    # [1] becomes the agent's stdout and stderr.
    var out_r = 0 - 1;
    var out_w = 0 - 1;
    if (_agent_output_mode == AGENT_OUTPUT_CAPTURE) {
        var ofds: i32[2];
        if (syscall(_DAIMON_SYS_PIPE2, &ofds, _DAIMON_O_CLOEXEC) != 0) {
            sys_close(own_end);
            sys_close(agent_end);
            return Err(AGENT_OP_NO_PROCESS);
        }
        out_r = load32(&ofds);
        out_w = load32(&ofds + 4);
    }

    agent_set_status(h, AGENT_STARTING);
    sakshi_info("starting agent", 14);
    var cg_procs = _agent_cg_prepare(h);   # its own cgroup, where daimon can make one (2.4.2)
    var r_t, r_v = _agent_spawn(exe, argv, agent_environ_ipc(), mem_limit, cpu_secs,
      agent_end, out_w, cg_procs);
    sys_close(agent_end);   # the child has its copy; daimon never keeps this end
    if (out_w >= 0) { sys_close(out_w); }   # likewise: at EOF, every writer is gone
    if (is_err_result(r_t) == 1) {
        sys_close(own_end);
        if (out_r >= 0) { sys_close(out_r); }
        _agent_cg_confirm(h, 0);   # removes the unused cgroup
        agent_set_status(h, AGENT_FAILED);
        daimon_audit_agent(SEV_WARNING, "agent", "agent.spawn.fail", "agent process failed to start",
          str_data(agent_name(h)));
        return Err(r_v);
    }
    agent_set_pid(h, r_v);
    agent_set_exit_code(h, 0 - 1);
    agent_set_started_at(h, clock_epoch_secs());
    agent_set_status(h, AGENT_RUNNING);
    agent_set_limits_enforced(h, 1);   # the child applied them, or it would not have exec'd
    _agent_cg_confirm(h, r_v);
    daimon_audit_agent(SEV_INFO, "agent", "agent.spawn", "agent process started", str_data(agent_name(h)));
    # daimon's end joins the channels the event loop polls (src/ipc.cyr), which
    # own it from here on, replacing any channel left from an earlier run; the
    # output pipe likewise (its ring starts empty).
    ipc_service_add(id_str, own_end);
    if (out_r >= 0) { ipc_output_add(id_str, out_r); }
    return Ok(r_v);
    #endif
}

#ifdef CYRIUS_TARGET_AGNOS
# --- Starting an agent on agnos (2.4.0) ---
#
# spawn_path#43 loads the executable and returns the child's pid at once, or -1
# when it cannot be loaded: the counterpart of the Linux exec report. waitpid#4
# collects the exit code as on Linux (daimon_reap_code). What agnos cannot do
# yet is filed with it (the agnos repo, docs/development/issues/2026-09-23-*):
#   - resource limits: the agent runs without its quota, and each start records
#     that (agent_limits_enforced 0, audit agent.limits.unenforced);
#   - argv: one line split on spaces, at most 127 bytes, so an agent whose name
#     contains a space, or a longer line, is refused (AGENT_OP_ARGS);
#   - ending a process: a stop asks with SIGTERM and waits (agent_stop_step).
# The agent's channel is chan_op's (src/ipc.cyr): the pair is minted, the
# agent's end is endowed to the child (CH_ENDOW moves it; the kernel chooses
# the fd, announced as AGNOS_IPC_FD), and daimon's end is served by the loop.
var AGENT_AGNOS_LINE_MAX = 127;     # spawn_path#43 refuses a longer line
var AGENT_AGNOS_ENV_MAX = 1024;     # an env blob over this, or with more
var AGENT_AGNOS_ENV_ENTRIES = 16;   # entries, gets the kernel's default env instead

fn _agent_has_space(p, n) {
    var i = 0;
    while (i < n) {
        if (load8(p + i) == 32) { return 1; }
        i = i + 1;
    }
    return 0;
}

# "<exe> --agent-id <id> --agent-name <name>" as spawn_path takes it, or 0 when
# it cannot be passed.
fn _agent_cmdline_agnos(exe, id, name) {
    var nl = str_len(name);
    if (nl == 0) { return 0; }
    if (_agent_has_space(str_data(name), nl) == 1) { return 0; }
    if (_agent_has_space(exe, strlen(exe)) == 1) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, exe);
    str_builder_add_cstr(sb, " --agent-id ");
    str_builder_add_int(sb, id);
    str_builder_add_cstr(sb, " --agent-name ");
    str_builder_add(sb, name);
    var line = str_builder_build(sb);
    if (str_len(line) > AGENT_AGNOS_LINE_MAX) { return 0; }
    return line;
}

# daimon's environment as spawn_path's env blob ("K=V\0K=V\0"), filtered by
# `serve --agent-env` as the Linux envp is, then `extra` ("K=V", or 0). The
# kernel answers a blob past its limits by giving the child its DEFAULT
# environment, so entries that would not fit are left out here instead, and
# logged. agnos keeps no /proc: the environment is read from daimon's own init
# stack, as lib/args_agnos.cyr's getenv does. Returns a Str, empty if there is
# nothing to pass.
fn _agent_env_blob_agnos(extra) {
    var sb = str_builder_new();
    var room = AGENT_AGNOS_ENV_ENTRIES;
    var budget = AGENT_AGNOS_ENV_MAX;
    if (extra != 0) {
        room = room - 1;
        budget = budget - strlen(extra) - 1;
    }
    var entries = 0;
    var used = 0;
    var left_out = 0;
    var base = _agnos_argv_base();
    if (base != 0) {
        var envv = base + 8 + (load64(base) + 1) * 8;   # &envp[0], after argv's NULL
        var j = 0;
        while (j < 256) {
            var e = load64(envv + j * 8);
            if (e == 0) { break; }
            j = j + 1;
            var keep = 1;
            if (strlen(e) >= 13) { if (memeq(e, "AGNOS_IPC_FD=", 13) == 1) { keep = 0; } }
            if (_agent_env_mode == AGENT_ENV_MINIMAL) {
                if (_agent_env_keep(e) == 0) { keep = 0; }
            }
            if (keep == 1) {
                var n = strlen(e);
                if (entries >= room) {
                    left_out = left_out + 1;
                } elif (used + n + 1 > budget) {
                    left_out = left_out + 1;
                } else {
                    str_builder_add_cstr(sb, e);
                    str_builder_add_byte(sb, 0);
                    used = used + n + 1;
                    entries = entries + 1;
                }
            }
        }
    }
    if (extra != 0) {
        str_builder_add_cstr(sb, extra);
        str_builder_add_byte(sb, 0);
    }
    if (left_out > 0) {
        sakshi_warn("agent environment trimmed to agnos's 16 entries / 1024 bytes", 61);
    }
    return str_builder_build(sb);
}

fn _agent_start_agnos(h) {
    var exe = agent_find_executable(agent_type(h));
    if (exe == 0) { return Err(AGENT_OP_NO_EXECUTABLE); }
    var line = _agent_cmdline_agnos(exe, agent_id(h), agent_name(h));
    if (line == 0) { return Err(AGENT_OP_ARGS); }
    var chfds: i32[2];
    # -CH_E_FULL: the machine's 16 channels are in use, or daimon's fd table
    # (32 slots) is full. Nothing about the agent failed, so its status stays.
    var mr = ipc_channel_open(&chfds);
    if (mr == 0 - CH_E_FULL) {
        daimon_audit_agent(SEV_WARNING, "agent", "agent.spawn.capacity",
          "agent not started: agnos has no free channel for it", str_data(agent_name(h)));
        return Err(AGENT_OP_CAPACITY);
    }
    if (mr != 0) { return Err(AGENT_OP_NO_PROCESS); }
    var own_end = load32(&chfds);
    var agent_end = load32(&chfds + 4);
    var child_fd = sys_chan_endow(agent_end);
    if (child_fd < 0) {
        sys_chan_close(agent_end);
        sys_chan_close(own_end);
        return Err(AGENT_OP_NO_PROCESS);
    }
    var isb = str_builder_new();
    str_builder_add_cstr(isb, "AGNOS_IPC_FD=");
    str_builder_add_int(isb, child_fd);
    var env = _agent_env_blob_agnos(str_data(str_builder_build(isb)));
    var env_p = 0;
    var env_n = 0;
    if (str_len(env) > 0) {
        env_p = str_data(env);
        env_n = str_len(env);
    }
    agent_set_status(h, AGENT_STARTING);
    sakshi_info("starting agent", 14);
    var pid = sys_spawn_path_env(str_data(line), str_len(line), env_p, env_n);
    if (pid < 0) {
        # A failed spawn leaves the endowment armed for whatever spawns next;
        # with both ends closed, its placement is refused (filed with agnos).
        # #43 answers -1 for every failure: a full process table (16 slots for
        # the whole machine) and an executable it cannot load look the same
        # (filed with agnos, 2026-09-23). The executable was just found by stat.
        sys_chan_close(agent_end);
        sys_chan_close(own_end);
        agent_set_status(h, AGENT_FAILED);
        daimon_audit_agent(SEV_WARNING, "agent", "agent.spawn.fail", "agent process failed to start",
          str_data(agent_name(h)));
        return Err(AGENT_OP_NO_EXEC);
    }
    agent_set_pid(h, pid);
    agent_set_exit_code(h, 0 - 1);
    agent_set_started_at(h, clock_epoch_secs());
    agent_set_status(h, AGENT_RUNNING);
    agent_set_limits_enforced(h, 0);
    daimon_audit_agent(SEV_INFO, "agent", "agent.spawn", "agent process started", str_data(agent_name(h)));
    daimon_audit_agent(SEV_WARNING, "agent", "agent.limits.unenforced",
      "agent runs without its memory and CPU limits: agnos has none yet", str_data(agent_name(h)));
    # The agent's end moved to the child, so CH_CLOSE on it fails (daimon no
    # longer owns it) and a plain close frees daimon's inert copy. If it
    # succeeds, the kernel refused the placement and the agent has no channel.
    if (sys_chan_close(agent_end) == 0) {
        sakshi_warn("agent started without its channel: agnos refused the endowment", 62);
        daimon_audit_agent(SEV_WARNING, "ipc", "ipc.endow.refused",
          "agent started without its channel: agnos refused the endowment", str_data(agent_name(h)));
    } else {
        sys_close(agent_end);
    }
    var id_sb = str_builder_new();
    str_builder_add_int(id_sb, agent_id(h));
    ipc_service_add(str_builder_build(id_sb), own_end);
    return Ok(pid);
}
#endif

# How long a stopping agent gets between SIGTERM and SIGKILL. The Rust original
# gave 10 s, but it stopped agents on an async runtime; daimon's server answers
# one request at a time, so a stop holds every other request for as long as
# this runs. 5 s is SERVE_IDLE_MS, the hold daimon already accepts from one
# slow connection (src/server.cyr). A variable, so tests can shorten it.
var AGENT_STOP_GRACE_MS = 5000;

# Stopping (2.3.4: without holding the server).
#
# agent_stop_begin sends SIGTERM (and SIGCONT to a paused agent, which cannot
# act on SIGTERM until it runs) to the agent's process group and returns;
# agent_stop_step — the event loop's upkeep, every SERVE_TICK_MS — collects the
# process once it exits, sends SIGKILL at AGENT_STOP_GRACE_MS, and gives up
# DAIMON_REAP_BUDGET_MS after that. Through 2.3.3 a stop was one call that
# waited up to ~6 s, and the single-threaded server with it (VULN-014,
# measured: a request sent during a 5 s stop waited 4.8 s).
#
# ⛔ Through 2.2.3 the stop checked ONCE, immediately after SIGTERM, with a
# non-blocking wait, and sent SIGKILL if the agent had not exited in those few
# instructions — so in practice every agent was SIGKILLed and none got to shut
# down.

# Begin stopping. Returns 1 if the agent is already stopped (it had no process),
# 0 if the stop is under way (agent_stop_step finishes it). A second call while
# one is under way changes nothing. Stopping is how a FAILED agent is returned
# to STOPPED.
fn agent_stop_begin(h, reason) {
    var pid = agent_pid(h);
    if (pid <= 0) {
        agent_set_status(h, AGENT_STOPPED);
        daimon_audit_agent(SEV_INFO, "agent", "agent.stop", "agent stopped", str_data(agent_name(h)));
        return 1;
    }
    if (load64(h + 96) != 0) { return 0; }
    var paused = 0;
    if (agent_status(h) == AGENT_PAUSED) { paused = 1; }
    agent_set_status(h, AGENT_STOPPING);
    _agent_signal_all(h, SIGTERM);
    if (paused == 1) { _agent_signal_all(h, 18); }   # SIGCONT
    store64(h + 96, daimon_now_ms() + AGENT_STOP_GRACE_MS);
    store64(h + 104, 0);
    return 0;
}

# 1 while a stop begun by agent_stop_begin is under way.
fn agent_stop_pending(h) {
    if (load64(h + 96) != 0) { return 1; }
    return 0;
}

# Advance a stop. Returns 1 when it is over: the process was collected (the
# agent is STOPPED), or it outlived SIGKILL's budget — uninterruptible sleep —
# and the agent stays STOPPING with its pid kept, for agent_reap to collect.
fn agent_stop_step(h, now) {
    if (load64(h + 96) == 0) { return 1; }
    var pid = agent_pid(h);
    if (pid > 0) {
        var code = daimon_reap_code(pid);
        if (code != 0 - 2) {
            # Reaped (or not daimon's to reap): the pid may now belong to another
            # process, so it is cleared in the same step — never signalled again.
            agent_set_pid(h, 0);
            agent_set_exit_code(h, code);
            ipc_service_remove(str_from_int(agent_id(h)));   # its channel goes with it
            _agent_cg_release(h);                             # and its cgroup (2.4.2)
            pid = 0;
        }
    }
    if (pid <= 0) {
        store64(h + 96, 0);
        agent_set_status(h, AGENT_STOPPED);
        daimon_audit_agent(SEV_INFO, "agent", "agent.stop", "agent stopped", str_data(agent_name(h)));
        return 1;
    }
    var killed = load64(h + 104);
    if (killed == 0) {
        if (now >= load64(h + 96)) {
            _agent_signal_all(h, SIGKILL);
            store64(h + 104, now);
        }
        return 0;
    }
    if (now - killed >= DAIMON_REAP_BUDGET_MS) {
        store64(h + 96, 0);
        daimon_audit_agent(SEV_WARNING, "agent", "agent.stop.pending",
          "agent did not exit after SIGKILL; still stopping", str_data(agent_name(h)));
        return 1;
    }
    return 0;
}

# Stop and wait: SIGTERM, up to AGENT_STOP_GRACE_MS, SIGKILL. Always Ok. For a
# caller that may block (tests; a request not served by the event loop).
fn agent_stop(h, reason) {
    if (agent_stop_begin(h, reason) == 1) { return Ok(0); }
    while (agent_stop_step(h, daimon_now_ms()) == 0) { daimon_yield_ms(1); }
    return Ok(0);
}

# Pause (SIGSTOP) a RUNNING agent.
fn agent_pause(h) {
    if (agent_status(h) != AGENT_RUNNING) { return Err(AGENT_OP_BAD_STATE); }
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(AGENT_OP_UNSUPPORTED);   # SIGSTOP stops nothing there yet (filed with agnos 2026-09-23)
    #endif
    if (_agent_signal_all(h, 19) != 0) { return Err(AGENT_OP_SIGNAL); }   # SIGSTOP
    agent_set_status(h, AGENT_PAUSED);
    return Ok(0);
}

# Resume (SIGCONT) a PAUSED agent.
fn agent_resume(h) {
    if (agent_status(h) != AGENT_PAUSED) { return Err(AGENT_OP_BAD_STATE); }
    #ifdef CYRIUS_TARGET_AGNOS
    return Err(AGENT_OP_UNSUPPORTED);
    #endif
    if (_agent_signal_all(h, 18) != 0) { return Err(AGENT_OP_SIGNAL); }   # SIGCONT
    agent_set_status(h, AGENT_RUNNING);
    return Ok(0);
}

# Collect an agent whose process exited ON ITS OWN (agent_stop reaps its own).
# Non-blocking; returns 1 if it reaped. An exit code of 0 leaves the agent
# STOPPED, anything else FAILED; an agent that was STOPPING is STOPPED either way.
# Without this a dead agent stayed RUNNING with its old pid — which the kernel
# may hand to another process — and its process stayed a zombie. 2.3.0.
fn agent_reap(h) {
    var pid = agent_pid(h);
    if (pid <= 0) { return 0; }
    var code = daimon_reap_code(pid);
    if (code == 0 - 2) { return 0; }   # still running
    agent_set_pid(h, 0);
    agent_set_exit_code(h, code);      # -1: there was no such child to reap
    ipc_service_remove(str_from_int(agent_id(h)));   # its channel goes with it
    _agent_cg_release(h);                             # and its cgroup (2.4.2)
    var was = agent_status(h);
    if (was == AGENT_STOPPING) {
        # A stop's process, collected by the sweep before agent_stop_step saw
        # it: the stop is over, and it is recorded as one.
        store64(h + 96, 0);
        agent_set_status(h, AGENT_STOPPED);
        daimon_audit_agent(SEV_INFO, "agent", "agent.stop", "agent stopped", str_data(agent_name(h)));
        return 1;
    }
    if (code == 0) { agent_set_status(h, AGENT_STOPPED); }
    else { agent_set_status(h, AGENT_FAILED); }
    if (code == 0) {
        daimon_audit_agent(SEV_INFO, "agent", "agent.exit", "agent process exited", str_data(agent_name(h)));
    } else {
        daimon_audit_agent(SEV_WARNING, "agent", "agent.exit", "agent process exited abnormally",
          str_data(agent_name(h)));
    }
    return 1;
}
